@model IdealAkeWms.Models.ViewModels.ArticleInfoViewModel?
@{
    ViewData["Title"] = "Artikelinfo";
    var notFound = ViewBag.NotFound as string;
    var mehrdeutig = ViewBag.Mehrdeutig as string;
    var searchValue = Model?.ArticleNumber ?? notFound ?? Context.Request.Query["articleNumber"].ToString();
}

<h2 class="page-header">Artikelinfo</h2>

<div class="row">
    <div class="col-md-8 col-lg-6">

        <div class="card mb-4">
            <div class="card-body">
                <form method="get" asp-action="Info" asp-controller="Articles" id="articleInfoForm">
                    <div class="mb-3">
                        <label for="articleNumber" class="form-label fw-semibold">Artikelnummer / QR-Code scannen</label>
                        <div class="input-group">
                            <input type="text" id="articleNumber" name="articleNumber"
                                   class="form-control form-control-lg"
                                   value="@searchValue"
                                   placeholder="Artikelnummer eingeben oder scannen"
                                   autocomplete="off" />
                            <button type="button" id="btnScanArticleInfo" class="btn btn-secondary scan-btn" title="QR-Code scannen">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M1.5 1a.5.5 0 0 0-.5.5v3a.5.5 0 0 1-1 0v-3A1.5 1.5 0 0 1 1.5 0h3a.5.5 0 0 1 0 1zM11 .5a.5.5 0 0 1 .5-.5h3A1.5 1.5 0 0 1 16 1.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 1-.5-.5M.5 11a.5.5 0 0 1 .5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 1 0 1h-3A1.5 1.5 0 0 1 0 14.5v-3a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v3a1.5 1.5 0 0 1-1.5 1.5h-3a.5.5 0 0 1 0-1h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 1 .5-.5"/>
                                    <path d="M3 4.5a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0z"/>
                                </svg>
                            </button>
                        </div>
                        <div class="form-text">QR-Code-Format: erstes Feld = Artikelnummer bzw. Matchcode, weitere Felder durch ; oder , (je nach Einstellung)</div>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.099zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                        </svg>
                        Suchen
                    </button>
                </form>
            </div>
        </div>

        @if (mehrdeutig != null)
        {
            <div class="alert alert-warning" role="status">@mehrdeutig</div>
        }

        @if (notFound != null)
        {
            <div class="alert alert-warning">
                Artikel <strong>@notFound</strong> wurde nicht gefunden.
            </div>
        }

        @if (Model != null)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <strong>@Model.ArticleNumber</strong>
                    @await Html.PartialAsync("_VaultLink", new VaultLinkViewModel(Model.ArticleNumber, ShowLabel: true))
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Bezeichnung</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Matchcode</dt>
                        <dd class="col-sm-8">@(Model.Matchcode ?? "—")</dd>

                        <dt class="col-sm-4">Einheit</dt>
                        <dd class="col-sm-8">@(Model.Unit ?? "—")</dd>

                        <dt class="col-sm-4">Artikelgruppe</dt>
                        <dd class="col-sm-8">@(Model.ArticleGroup ?? "—")</dd>

                        <dt class="col-sm-4">Kategorie</dt>
                        <dd class="col-sm-8">@(Model.CategoryName ?? "—")</dd>

                        @if (Model.AttributeDisplayValues.Any())
                        {
                            @foreach (var attr in Model.AttributeDisplayValues)
                            {
                                <dt class="col-sm-4">@attr.Name</dt>
                                <dd class="col-sm-8 text-break">@attr.DisplayValue</dd>
                            }
                        }

                        <dt class="col-sm-4">Meldebestand</dt>
                        <dd class="col-sm-8">
                            @Model.ReorderLevel @Model.Unit
                            @if (Model.ReorderLevel > 0 && Model.TotalStock < Model.ReorderLevel)
                            {
                                <span class="badge bg-danger ms-2">Unterschritten</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Gesamtbestand</dt>
                        <dd class="col-sm-8">
                            <strong
                                @if (Model.ReorderLevel > 0 && Model.TotalStock < Model.ReorderLevel)
                                {
                                    <text>class="text-danger"</text>
                                }>
                                @Model.TotalStock @Model.Unit
                            </strong>
                        </dd>

                        <dt class="col-sm-4">
                            Verfügbarer Bestand
                            @* Hierarchisch (IDEAL) speist sich der geplante Verbrauch aus der Sollmenge
                               je Sub-FA — das Label sagt es, damit die Zahl nachvollziehbar bleibt. *@
                            <span class="text-muted" data-bs-toggle="tooltip"
                                  title="Gesamtbestand abzüglich geplanter Verbräuche offener Fertigungsaufträge@(Model.Hierarchical ? " (Sollmenge aus der FA-Struktur)" : "")">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                    <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                                </svg>
                            </span>
                        </dt>
                        <dd class="col-sm-8">
                            <strong
                                @if (Model.AvailableStock < 0)
                                {
                                    <text>class="text-danger"</text>
                                }>
                                @Model.AvailableStock @Model.Unit
                            </strong>
                        </dd>
                    </dl>
                </div>
            </div>

            @if (Model.SageDetail is { } sd)
            {
                // v1.73.0 E3a: nur lesend; erscheint erst, wenn der Artikel-Abgleich den Artikel ueber SData gelesen hat.
                string T(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
                string Z(decimal? v) => v?.ToString("0.###") ?? "—";
                string J(bool? v) => v is null ? "—" : v.Value ? "Ja" : "Nein";
                var gelesen = (sd.ModifiedAt ?? sd.CreatedAt).ToLocalTime();
                var gruppen = new (string Titel, (string Name, string Wert)[] Felder)[]
                {
                    ("Stamm", new[] { ("Bezeichnung 2", T(sd.Bezeichnung2)), ("Hauptartikelgruppe", T(sd.Hauptartikelgruppe)),
                        ("Vaterartikelgruppe", T(sd.Vaterartikelgruppe)), ("Hersteller", T(sd.Hersteller)),
                        ("Hersteller-Artikelnr.", T(sd.HArtikelnummer)), ("Zeichnungsnummer", T(sd.Zeichnungsnummer)),
                        ("Ersatzartikel", T(sd.Ersatzartikelnummer)), ("EAN", T(sd.EANNummer)) }),
                    ("Lager", new[] { ("Lagerführung", J(sd.Lagerfuehrung)), ("Hauptlagerplatz (Sage-ID)", sd.SagePlatzId?.ToString() ?? "—"),
                        ("Lagerplatz-ID (Benutzerfeld)", sd.UserLagerplatzId?.ToString() ?? "—"), ("Entnahmeverfahren", T(sd.Entnahmeverfahren)),
                        ("Inventurmethode", sd.Inventurmethode?.ToString() ?? "—"), ("Dezimalstellen Lager", sd.DezimalstellenLager?.ToString() ?? "—"),
                        ("Chargenpflicht", sd.Chargenpflicht?.ToString() ?? "—"), ("Nachweispflicht", sd.Nachweispflicht?.ToString() ?? "—") }),
                    ("Bestand und Dispo (Sage)", new[] { ("Lagerbestand", Z(sd.Lagerbestand)), ("Verfügbar", Z(sd.LagerbestandVerfuegbar)),
                        ("Bestand ohne Dispo", Z(sd.LagerbestandOhneDispo)), ("Mindestbestand", Z(sd.UserMindestbestand)),
                        ("Bestellmenge", Z(sd.Bestellmenge)), ("Bestellzeitpunkt", sd.Bestellzeitpunkt?.ToString() ?? "—"),
                        ("Wiederbeschaffungszeit", sd.Wiederbeschaffungszeit?.ToString() ?? "—"), ("ABC-Klasse", T(sd.ABCKlasse)),
                        ("Mittlerer EK", sd.MittlererEK?.ToString("0.####") ?? "—") }),  @* v1.80.0: Haupt-/letzter Lieferant in der Karte „Lieferanten“ *@
                    ("Fertigung", new[] { ("Fertigungsartikel", J(sd.IstFertigungsartikel)), ("Unterbaugruppe", J(sd.IstUnterbaugruppe)),
                        ("Stücklistentyp", sd.Stuecklistentyp?.ToString() ?? "—"), ("Schwundart", T(sd.Schwundart)), ("Schwund", Z(sd.Schwund)),
                        ("Minimale Losgröße", Z(sd.MinimaleLosgroesse)), ("Maximale Losgröße", Z(sd.MaximaleLosgroesse)) }),
                    ("Kennzeichen", new[] { ("Bestellartikel", J(sd.IstBestellartikel)), ("Ersatzteil", J(sd.IstErsatzteil)),
                        ("Verschleißteil", J(sd.IstVerschleissteil)), ("Aktiv in Sage", J(sd.Aktiv)) }),
                    ("Maße und Gewicht", new[] { ("Länge", Z(sd.Laenge)), ("Breite", Z(sd.Breite)), ("Höhe", Z(sd.Hoehe)),
                        ("Gewicht", sd.Gewicht is null ? "—" : $"{Z(sd.Gewicht)} {sd.Gewichtseinheit}".Trim()) }),
                };
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <strong>Sage-Zusatzfelder</strong>
                        <small class="text-muted">nur lesend · aus Sage gelesen am @gelesen.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                    <div class="card-body pt-1">
                        @foreach (var g in gruppen)
                        {
                            <h3 class="h6 fw-semibold border-bottom pb-1 mt-3 mb-2">@g.Titel</h3>
                            <dl class="row mb-0">
                                @foreach (var f in g.Felder)
                                {
                                    <dt class="col-sm-5 fw-normal text-muted">@f.Name</dt>
                                    <dd class="col-sm-7">@f.Wert</dd>
                                }
                            </dl>
                        }
                        @if (!string.IsNullOrWhiteSpace(sd.Langtext))
                        {
                            <h3 class="h6 fw-semibold border-bottom pb-1 mt-3 mb-2">Langtext</h3>
                            <p class="mb-0" style="white-space: pre-line">@sd.Langtext</p>
                        }
                    </div>
                </div>
            }
            else
            {
                @* v1.80.0 (Spec 2026-11-08-artikeldetails-lieferanten-anzeigen F3): Hinweis statt still ausgeblendeter Karte (ersetzt TS-106.3.d). *@
                <div class="card mb-3">
                    <div class="card-header"><strong>Sage-Zusatzfelder</strong></div>
                    <div class="card-body">
                        <p class="mb-0 text-body-secondary">Für diesen Artikel liegen noch keine Sage-Zusatzfelder vor. Sie werden nur vom
                            Artikel-Abgleich mit Quelle SData gefüllt (Service-Einstellung <code>Sync:Quelle:Artikel</code> = <code>SData</code>).</p>
                    </div>
                </div>
            }

            // v1.80.0 F1/F2: Lieferant als „Name (Konto)“ mit Link auf die Kreditor-Details; ohne Kreditor nur das Konto; „– inaktiv“ als Text.
            void Lieferant(int? id, string? name, string? konto, bool aktiv)
            {
                if (id == null)
                {
                    <text>@(string.IsNullOrWhiteSpace(konto) ? "—" : konto.Trim())</text>
                    return;
                }
                <a href="@Url.Action("Details", "Creditors", new { id })">@name (@konto?.Trim())</a>
                if (!aktiv)
                {
                    <span class="text-body-secondary">– inaktiv</span>
                }
            }
            var sdl = Model.SageDetail;
            var hk = Model.HauptlieferantKreditor;
            var lk = Model.LetzterLieferantKreditor;
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <strong>Lieferanten</strong>
                    <small class="text-muted">nur lesend · aus Sage</small>
                </div>
                <div class="card-body">
                    <dl class="row mb-2">
                        <dt class="col-sm-5 fw-normal text-muted">Hauptlieferant</dt>
                        <dd class="col-sm-7">@{ Lieferant(hk?.Id, hk?.Name, sdl?.Hauptlieferant, hk?.IsActive ?? true); }</dd>
                        <dt class="col-sm-5 fw-normal text-muted">Letzter Lieferant</dt>
                        <dd class="col-sm-7">@{ Lieferant(lk?.Id, lk?.Name, sdl?.LetzterLieferant, lk?.IsActive ?? true); }</dd>
                    </dl>
                    @if (Model.Lieferanten.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Lieferant</th>
                                        <th>Bestellnummer</th>
                                        <th class="text-end">Mindestbestellmenge</th>
                                        <th>EK-Einheit</th>
                                        <th class="text-end">Wiederbeschaffungszeit (Tage)</th>
                                        <th>Hauptlieferant</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in Model.Lieferanten)
                                    {
                                        <tr>
                                            <td>@{ Lieferant(l.CreditorId, l.Name, l.SageKto, l.IsActive); }</td>
                                            <td>@(l.SageBestellnummer ?? "—")</td>
                                            <td class="text-end">@(l.Mindestbestellmenge?.ToString("0.###") ?? "—")</td>
                                            <td>@(l.Einkaufsmengeneinheit ?? "—")</td>
                                            <td class="text-end">@(l.Wiederbeschaffungszeit?.ToString() ?? "—")</td>
                                            <td>@(l.IstHauptlieferant ? "Ja" : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="mb-0 text-body-secondary">Keine Artikel-Lieferanten aus Sage gelesen. Sie werden vom Lauf &bdquo;Artikel-Lieferanten&ldquo;
                            gefüllt (Service-Einstellung <code>Sync:ArtikelLieferantEnabled</code>; braucht die Kreditoren aus Sage,
                            <code>Sync:KreditorenEnabled</code>).</p>
                    }
                </div>
            </div>

            @if (Model.UsedInOrders.Any())
            {
                <div class="card mb-3">
                    <div class="card-header"><strong>Teil enthalten in folgenden Fertigungsauftraegen</strong></div>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@(Model.Hierarchical ? "HauptFA" : "FA Nr.")</th>
                                    @if (Model.Hierarchical) { <th>Sub-FA (Baugruppe)</th> }
                                    <th>Fertigungstermin</th>
                                    <th>Liefertermin</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.UsedInOrders)
                                {
                                    <tr>
                                        <td><a asp-controller="Picking" asp-action="Bom" asp-route-id="@order.Id"><strong>@order.OrderNumber</strong></a></td>
                                        @if (Model.Hierarchical) { <td>@order.SubOrderNumber</td> }
                                        <td>@order.ProductionDate?.ToString("dd.MM.yyyy")</td>
                                        <td>@order.DeliveryDate?.ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer text-muted">
                        @* Z4: hierarchisch beide Zahlen (Aufträge = HauptFA, Sub-FAs = Zeilen); flach eine Zahl. *@
                        @if (Model.Hierarchical)
                        {
                            <small>@Model.UsedInHauptFaCount Aufträge · @Model.UsedInOrders.Count Sub-FAs offen (basierend auf FA-Struktur, Mengen = Sollmenge)</small>
                        }
                        else
                        {
                            <small>@Model.UsedInOrders.Count offene Auftraege (basierend auf BOM-Cache)</small>
                        }
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header"><strong>Lagerbestand nach Lagerplatz</strong></div>
                @if (Model.StockByLocation.Count == 0)
                {
                    <div class="card-body text-muted">Kein Bestand vorhanden.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Lagerplatz</th>
                                    <th>Bezeichnung</th>
                                    <th class="text-end">Menge</th>
                                    <th>Einheit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.StockByLocation.OrderBy(s => s.StorageLocationCode))
                                {
                                    <tr>
                                        <td><code>@item.StorageLocationCode</code></td>
                                        <td>@item.StorageLocationDescription</td>
                                        <td class="text-end">@item.CurrentQuantity</td>
                                        <td>@(item.Unit ?? Model.Unit ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="2">Gesamt</th>
                                    <th class="text-end">@Model.TotalStock</th>
                                    <th>@Model.Unit</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        }

    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script src="~/js/barcode-scanner.js" asp-append-version="true"></script>
    <script>
        // Nach Scan: Formular automatisch abschicken
        document.getElementById('articleNumber').addEventListener('change', function () {
            if (this.value.trim()) {
                document.getElementById('articleInfoForm').submit();
            }
        });
    </script>
}
