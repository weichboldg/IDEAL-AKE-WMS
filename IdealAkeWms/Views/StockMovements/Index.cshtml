@model MovementHistoryViewModel
@using IdealAkeWms.Services
@inject ICurrentUserService CurrentUser
@inject IdealAkeWms.Data.Repositories.IServiceSettingRepository ServiceSettings
@{
    ViewData["Title"] = "Bewegungshistorie";
    // v1.87.0: FA-Leserecht und Master einmal je Seite (nicht je Zeile)
    var faLinkErlaubt = await CurrentUser.CanViewProductionOrdersAsync();
    var faHierarchisch = FaBuchungsText.IstHierarchisch(await ServiceSettings.GetValueAsync(IdealAkeWms.Services.HierarchischeStruktur.HierarchischeStrukturKeys.Master));
}

<h2 class="page-header">Bewegungshistorie</h2>

<div class="card filter-card mb-4">
    <div class="card-header">Filter</div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Von</label>
                    <input type="date" name="dateFrom" value="@Model.FilterDateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Bis</label>
                    <input type="date" name="dateTo" value="@Model.FilterDateTo?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Artikel</label>
                    <input type="text" name="filterArticle" value="@Model.FilterArticle" class="form-control" placeholder="Artikelnr. oder Bezeichnung" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Lagerplatz</label>
                    <select name="filterStorageLocationId" class="form-select">
                        <option value="">-- Alle --</option>
                        @foreach (var sl in Model.StorageLocations)
                        {
                            <option value="@sl.Id" selected="@(Model.FilterStorageLocationId == sl.Id)">@sl.Code</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Bewegungsart</label>
                    <select name="filterMovementType" class="form-select">
                        <option value="">-- Alle --</option>
                        <option value="0" selected="@(Model.FilterMovementType == MovementType.Einbuchung)">Einbuchung</option>
                        <option value="1" selected="@(Model.FilterMovementType == MovementType.Ausbuchung)">Ausbuchung</option>
                        <option value="2" selected="@(Model.FilterMovementType == MovementType.Umbuchung)">Umbuchung</option>
                        <option value="3" selected="@(Model.FilterMovementType == MovementType.SageEinbuchung)">Sage-Einbuchung</option>
                        <option value="4" selected="@(Model.FilterMovementType == MovementType.SageAusbuchung)">Sage-Ausbuchung</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Benutzer</label>
                    <select name="filterUserId" class="form-select">
                        <option value="">-- Alle --</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id" selected="@(Model.FilterUserId == user.Id)">@user.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fertigungsauftrag</label>
                    <div class="input-group">
                        <input type="text" id="filterProductionOrder" name="filterProductionOrder" value="@Model.FilterProductionOrder" class="form-control" />
                        <button type="button" id="btnScanProductionOrder" class="btn btn-secondary scan-btn" title="WA-/FA-Strichcode scannen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M1.5 1a.5.5 0 0 0-.5.5v3a.5.5 0 0 1-1 0v-3A1.5 1.5 0 0 1 1.5 0h3a.5.5 0 0 1 0 1zM11 .5a.5.5 0 0 1 .5-.5h3A1.5 1.5 0 0 1 16 1.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 1-.5-.5M.5 11a.5.5 0 0 1 .5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 1 0 1h-3A1.5 1.5 0 0 1 0 14.5v-3a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v3a1.5 1.5 0 0 1-1.5 1.5h-3a.5.5 0 0 1 0-1h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 1 .5-.5"/>
                                <path d="M3 4.5a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0z"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-secondary">Filtern</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Zurücksetzen</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped mb-0 filterable-table" data-server-column-filter="true">
        <thead>
            <tr>
                @* datetime + movement-type: funktionsfaehige Server-Spaltenfilter (Teil-4).
                   „Menge" bewusst OHNE Text-Spaltenfilter (kein sinnvoller Handler). *@
                <th data-filterable data-date-filter data-col-key="datetime">Datum/Zeit</th>
                <th data-filterable data-col-key="article">Artikel</th>
                <th data-col-key="quantity">Menge</th>
                <th data-filterable data-col-key="storage-location">Lagerplatz</th>
                <th data-filterable data-col-key="movement-type">Bewegungsart</th>
                <th data-filterable data-col-key="user">Benutzer</th>
                <th data-filterable data-col-key="production-order">Fertigungsauftrag</th>
                <th data-col-key="note">Notiz</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <strong>@item.ArticleNumber</strong>
                        @await Html.PartialAsync("_VaultLink", new VaultLinkViewModel(item.ArticleNumber))
                        @if (!string.IsNullOrEmpty(item.ArticleDescription))
                        {
                            <br /><small class="text-muted">@item.ArticleDescription</small>
                        }
                    </td>
                    <td>@item.Quantity.ToString("N3")</td>
                    <td>
                        @if (item.MovementType == MovementType.Umbuchung && !string.IsNullOrEmpty(item.SourceStorageLocationCode))
                        {
                            @item.SourceStorageLocationCode <span class="text-muted">&rarr;</span> @item.StorageLocationCode
                        }
                        else
                        {
                            @item.StorageLocationCode
                        }
                    </td>
                    <td>
                        @{
                            var badgeClass = item.MovementType switch
                            {
                                MovementType.Einbuchung => "badge-einbuchung",
                                MovementType.Umbuchung => "badge-umbuchung",
                                MovementType.Ausbuchung => "badge-ausbuchung",
                                MovementType.SageEinbuchung => "badge-sage-einbuchung",
                                MovementType.SageAusbuchung => "badge-sage-ausbuchung",
                                _ => "badge-ausbuchung"
                            };
                        }
                        <span class="@badgeClass">
                            @item.MovementTypeName
                        </span>
                    </td>
                    <td>@item.UserName</td>
                    <td><partial name="_FaLink" model="new FaLinkViewModel(item.ProductionOrder, item.LinkedFa, faLinkErlaubt, faHierarchisch)" /></td>
                    <td data-col-key="note">@(item.Note ?? "")</td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">Keine Bewegungen gefunden.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Pagination" />

@section Scripts {
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
    @* html5-qrcode LOKAL einbinden (nicht per unpkg-CDN — im Produktions-Intranet nicht
       verlaesslich erreichbar), analog Views/Tracking/OseonIndex.cshtml. *@
    <script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
    <script src="~/js/barcode-scanner.js" asp-append-version="true"></script>
    <script>
        // Scan-Button fuer das FA-Filterfeld: kuerzt den gescannten WA-Strichcode auf die
        // Basisnummer (alles ab dem ersten '-' oder '_' wird entfernt). Die Kuerzung lebt
        // AUSSCHLIESSLICH in diesem onScanned-Callback (nur beim Scan) — manuelles Eintippen
        // bleibt unveraendert. Siehe [[2026-08-05-wms-bugs-improvements-teil-3-spec]].
        $(function () {
            initTextInputScanner('btnScanProductionOrder', 'filterProductionOrder', 'fa', function () {
                var input = document.getElementById('filterProductionOrder');
                if (input && input.value) {
                    input.value = input.value.trim().split(/[-_]/)[0];
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                }
            });
        });
    </script>
}
