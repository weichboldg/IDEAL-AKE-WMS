@inject IdealAkeWms.Services.Navigation.NavigationSicht Navigation
@{
    ViewData["Title"] = "Dashboard";
    // v1.99.45 (ADR 0034): Kacheln kommen aus derselben Quelle wie das Menue — kein eigenes Recht, kein eigener Schalter hier.
    var kacheln = (await Navigation.GetAsync()).Kacheln;
}

<h2 class="page-header">Dashboard</h2>

@if (kacheln.Count == 0)
{
    <div class="alert alert-info" role="status">Für Ihren Benutzer sind keine Funktionen freigeschaltet. Bitte wenden Sie sich an den Administrator.</div>
}
@foreach (var (kategorie, ziele) in kacheln)
{
    <section class="mb-4" aria-label="@kategorie">
        <h3 class="h6 text-muted mb-2 mt-2">@kategorie</h3>
        <div class="row g-4">
            @foreach (var z in ziele)
            {
                <div class="col-md-6 col-lg-3">
                    <a href="@Url.Action(z.Action, z.Controller)" class="text-decoration-none d-block h-100 dashboard-link">
                        <div class="card dashboard-card h-100">
                            <div class="card-body text-center">
                                <h4 class="h5 card-title mb-1">@z.Titel</h4>
                                <small class="text-muted">@z.Beschreibung</small>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}
