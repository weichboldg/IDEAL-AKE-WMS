@model IdealAkeWms.Models.ViewModels.BfAuftragDetailViewModel
@using System.Globalization
@using IdealAkeWms.Models
@using IdealAkeWms.Models.ViewModels
@using IdealAkeWms.Services.SageSdata
@inject IdealAkeWms.Data.Repositories.IServiceSettingRepository ServiceSettings
@{
    var a = Model.Auftrag;
    ViewData["Title"] = Model.IstWarenkorb ? "BF-Warenkorb" : $"BF-Auftrag {a.Nummer}";
    var de = CultureInfo.GetCultureInfo("de-AT");
    string M(decimal? m) => m?.ToString("0.###", de) ?? "";
    var bearbeitbar = Model.BestellerBearbeitet || Model.SchachtlerBearbeitet;
    var positionen = a.Positionen.OrderBy(p => p.Position).ToList();
    // v1.99.40 (ADR 0033): nicht konfigurierte Sage-Benutzerfelder der Blechfertigung nennen statt leerer Suche/Spalten
    var userfelder = await SageUserfelder.AusAsync(ServiceSettings);
    var bfNichtKonfiguriert = SageUserfelder.Katalog.Where(u => u.Abgleich == SageUserfelder.Blechfertigung
        && userfelder.Feld(u.Abgleich, u.Default) is null).Select(u => u.Anzeigename).ToList();
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <h2 class="page-header">
        @(Model.IstWarenkorb ? "BF-Warenkorb" : $"BF-Auftrag {a.Nummer}")
        @if (!Model.IstWarenkorb) { <partial name="_StatusBadge" model="a.Status" /> }
    </h2>
    <div class="d-flex gap-2 mt-1">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Zur Liste</a>
    </div>
</div>

@if (bfNichtKonfiguriert.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        Sage-Benutzerfelder nicht konfiguriert: @string.Join(", ", bfNichtKonfiguriert). Diese Werte werden nicht aus Sage gelesen;
        ohne „Ist Lagerartikel“ und „Artikeltyp“ findet die Artikelsuche nichts. Eintragen unter Service-Einstellungen, Kategorie
        „@SageUserfelder.Kategorie(SageUserfelder.Blechfertigung)“.
    </div>
}

@if (!Model.IstWarenkorb)
{
    <dl class="row mb-3">
        <dt class="col-sm-2">Besteller</dt><dd class="col-sm-4">@a.BestellerName@(string.IsNullOrEmpty(a.BestellerKuerzel) ? "" : $" ({a.BestellerKuerzel})")</dd>
        <dt class="col-sm-2">Bestellt am</dt><dd class="col-sm-4">@BfAuftragListRow.Zeitpunkt(a.BestelltAm)</dd>
        <dt class="col-sm-2">Empfängergruppe</dt><dd class="col-sm-4">@(a.OrderRecipientGroup?.Name ?? "–")</dd>
        <dt class="col-sm-2">Mail</dt><dd class="col-sm-4">@(a.EmailSentAt is null ? "noch nicht versendet" : BfAuftragListRow.Zeitpunkt(a.EmailSentAt))</dd>
        <dt class="col-sm-2">Freigegeben</dt><dd class="col-sm-4">@BfAuftragListRow.Zeitpunkt(a.FreigegebenAm) @a.FreigegebenVon</dd>
        <dt class="col-sm-2">Termine</dt><dd class="col-sm-4">Schachteln @BfAuftragListRow.Datum(a.Schachteltermin), FE @BfAuftragListRow.Datum(a.FeTermin)</dd>
        <dt class="col-sm-2">CSV</dt><dd class="col-sm-4">@BfAuftragListRow.CsvText(a.CsvStatus) @a.CsvDatei @BfAuftragListRow.Zeitpunkt(a.CsvGeschriebenAm)</dd>
        <dt class="col-sm-2">Fertig</dt><dd class="col-sm-4">@BfAuftragListRow.Zeitpunkt(a.FertigAm) @a.FertigVon</dd>
        @if (a.Status == BfAuftragStatus.Storniert)
        {
            <dt class="col-sm-2">Storniert</dt><dd class="col-sm-10">@BfAuftragListRow.Zeitpunkt(a.StorniertAm) @a.StorniertVon – @a.StornoGrund</dd>
        }
    </dl>
    @if (!string.IsNullOrEmpty(a.CsvFehler))
    {
        <div class="alert alert-warning" role="alert">CSV-Fehler: @a.CsvFehler</div>
    }
}

@if (Model.BestellerBearbeitet)
{
    @* Artikelsuche: nur Sage-Lagerartikel mit Artikeltyp BG/FT (Server-Suche, kein eigenes JS). *@
    <div class="card filter-card mb-3">
        <div class="card-header">Artikel hinzufügen</div>
        <div class="card-body">
            <form method="get" asp-action="Warenkorb" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="q">Artikelnummer, Matchcode oder Bezeichnung</label>
                    <input type="search" id="q" name="q" value="@Model.Suche" class="form-control" autocomplete="off" data-hw-scan-ziel />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">Suchen</button>
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.Suche))
            {
                @if (Model.Treffer.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">Kein Lagerartikel (Artikeltyp BG oder FT) zu „@Model.Suche“ gefunden.</p>
                }
                else
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-hover mb-0" data-csv-export="false">
                            <thead>
                                <tr><th>Artikel</th><th>Matchcode</th><th>Teileart</th><th>Material</th><th class="text-end">Bestellmenge</th><th>Menge</th><th>Status</th><th>Lagerplatz</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Treffer)
                                {
                                    var fid = "add-" + t.ArticleNumber.GetHashCode().ToString("x");
                                    <tr>
                                        <td>@t.ArticleNumber<div class="small text-muted">@t.Description</div></td>
                                        <td>@t.Matchcode</td>
                                        <td>@t.Teileart</td>
                                        <td>
                                            @t.Material
                                            @if (string.IsNullOrWhiteSpace(t.Materialnummer))
                                            {
                                                <div class="small text-danger-emphasis">Keine Materialnummer – wird nicht an WiCAM übergeben.</div>
                                            }
                                        </td>
                                        <td class="text-end">@M(t.Bestellmenge)</td>
                                        <td>
                                            <form id="@fid" method="post" asp-action="AddItem"><input type="hidden" name="articleNumber" value="@t.ArticleNumber" /></form>
                                            <input form="@fid" type="number" name="menge" class="form-control form-control-sm" style="width:7rem" min="0.001" step="any"
                                                   value="@(t.Bestellmenge is > 0 ? M(t.Bestellmenge).Replace(",", ".") : "1")" aria-label="Menge" required />
                                        </td>
                                        <td>
                                            <select form="@fid" name="status" class="form-select form-select-sm" aria-label="Status">
                                                <option value="">–</option>
                                                @foreach (var s in Model.Statuswerte) { <option>@s</option> }
                                            </select>
                                        </td>
                                        <td>
                                            <select form="@fid" name="hauptlagerplatz" class="form-select form-select-sm" aria-label="Lagerplatz">
                                                <option value="">@(t.Hauptlagerplatz ?? "–")</option>
                                                @foreach (var l in Model.Lagerplaetze.Where(l => l != t.Hauptlagerplatz)) { <option>@l</option> }
                                            </select>
                                        </td>
                                        <td><button form="@fid" type="submit" class="btn btn-sm btn-success">Hinzufügen</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
}

@if (Model.IstWarenkorb && positionen.Count == 0)
{
    <p class="text-muted">Der Warenkorb ist leer. Suchen Sie oben einen Artikel und fügen Sie ihn hinzu.</p>
}
else
{
    <div class="d-flex justify-content-end mb-1" data-table-toolbar></div>
    <div class="table-responsive">
        <table class="table table-sm table-striped mb-0 filterable-table" data-view-key="BfAuftraegeDetails">
            <thead>
                <tr>
                    <th data-filterable data-col-key="pos" class="text-end">Pos</th>
                    <th data-filterable data-col-key="artikel">Artikel</th>
                    <th data-filterable data-col-key="matchcode">Matchcode</th>
                    <th data-filterable data-col-key="teileart">Teileart</th>
                    <th data-filterable data-col-key="material">Material</th>
                    <th data-filterable data-col-key="materialnummer">Materialnummer</th>
                    <th data-filterable data-col-key="menge" data-filter-type="number" class="text-end">Menge</th>
                    <th data-filterable data-col-key="bestellmenge" data-filter-type="number" class="text-end">Bestellmenge</th>
                    <th data-filterable data-col-key="status">Status</th>
                    <th data-filterable data-col-key="lagerplatz">Lagerplatz</th>
                    <th data-filterable data-col-key="bemerkung">Bemerkung</th>
                    @if (bearbeitbar) { <th data-csv-export="false">Aktion</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var p in positionen)
                {
                    var fid = $"upd-{p.Id}";
                    <tr class="@(p.Gestrichen ? "text-decoration-line-through text-muted" : "")">
                        <td class="text-end">@p.Position</td>
                        <td>@p.ArticleNumber @if (p.Gestrichen) { <span class="badge bg-secondary">gestrichen</span> }</td>
                        <td>@p.Matchcode</td>
                        <td>@p.Teileart</td>
                        <td>@p.Material</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(p.Materialnummer))
                            {
                                <span class="badge bg-warning text-dark" title="Ohne Materialnummer wird die Position nicht an WiCAM übergeben">fehlt – nicht übergeben</span>
                            }
                            else { @p.Materialnummer }
                        </td>
                        @if (bearbeitbar && !p.Gestrichen)
                        {
                            <td class="text-end" data-csv-value="@M(p.Menge)">
                                <form id="@fid" method="post" asp-action="@(Model.SchachtlerBearbeitet ? "UpdatePosition" : "UpdateItem")">
                                    <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="positionId" value="@p.Id" />
                                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                </form>
                                <input form="@fid" type="number" name="menge" value="@p.Menge.ToString("0.###", CultureInfo.InvariantCulture)" min="0.001" step="any"
                                       class="form-control form-control-sm text-end" style="width:7rem" aria-label="Menge Position @p.Position" required />
                            </td>
                        }
                        else
                        {
                            <td class="text-end">@M(p.Menge)</td>
                        }
                        <td class="text-end">@M(p.SageBestellmenge)</td>
                        @if (Model.BestellerBearbeitet)
                        {
                            <td data-csv-value="@p.Status">
                                <select form="@fid" name="status" class="form-select form-select-sm" aria-label="Status Position @p.Position">
                                    <option value="">–</option>
                                    @foreach (var s in Model.Statuswerte) { <option selected="@(s == p.Status)">@s</option> }
                                </select>
                            </td>
                        }
                        else
                        {
                            <td>@p.Status</td>
                        }
                        @if (bearbeitbar && !p.Gestrichen)
                        {
                            <td data-csv-value="@p.Hauptlagerplatz">
                                <select form="@fid" name="hauptlagerplatz" class="form-select form-select-sm" aria-label="Lagerplatz Position @p.Position">
                                    <option value="">@(p.Hauptlagerplatz ?? "–")</option>
                                    @foreach (var l in Model.Lagerplaetze.Where(l => l != p.Hauptlagerplatz)) { <option>@l</option> }
                                </select>
                            </td>
                        }
                        else
                        {
                            <td>@p.Hauptlagerplatz</td>
                        }
                        <td>@p.Bemerkung</td>
                        @if (bearbeitbar)
                        {
                            <td class="text-nowrap">
                                @if (!p.Gestrichen)
                                {
                                    <button form="@fid" type="submit" class="btn btn-sm btn-outline-primary">Speichern</button>
                                }
                                @if (Model.BestellerBearbeitet)
                                {
                                    <form method="post" asp-action="RemoveItem" class="d-inline">
                                        <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="positionId" value="@p.Id" />
                                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Entfernen</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="StreichePosition" class="d-inline">
                                        <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="positionId" value="@p.Id" />
                                        <input type="hidden" name="gestrichen" value="@(p.Gestrichen ? "false" : "true")" />
                                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(p.Gestrichen ? "Wiederherstellen" : "Streichen")</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.BestellerBearbeitet && positionen.Count > 0)
{
    <div class="mt-3">
        @if (Model.AbschickenGesperrt is not null)
        {
            <div class="alert alert-warning" role="alert">@Model.AbschickenGesperrt</div>
        }
        else
        {
            <form method="post" asp-action="Submit" class="d-inline">
                <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <button type="submit" class="btn btn-primary">Abschicken</button>
            </form>
            <span class="text-muted ms-2">Der Auftrag bekommt eine BF-Nummer und geht per Mail an die Blechfertigung.</span>
        }
    </div>
}

@if (Model.SchachtlerBearbeitet)
{
    var sperren = IdealAkeWms.Services.BfAuftragWorkflow.FreigabeFehler(a);
    <div class="mt-3">
        @if (sperren.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                Freigabe noch nicht möglich:
                <ul class="mb-0">@foreach (var s in sperren) { <li>@s</li> }</ul>
            </div>
        }
        <form method="post" asp-action="Freigeben" class="d-inline">
            <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" />
            <button type="submit" class="btn btn-primary">Freigeben</button>
        </form>
        <span class="text-muted ms-2">Berechnet Schachtel- und FE-Termin ab heute und übergibt den Auftrag als CSV an WiCAM.</span>
    </div>
}
@if (Model.IstSchachtler && a.Nummer is not null)
{
    <form method="post" asp-action="TestCsv" class="mt-3">
        <input type="hidden" name="id" value="@a.Id" />
        <button type="submit" class="btn btn-outline-secondary">Test-CSV herunterladen</button>
        <span class="text-muted ms-2">Dieselbe Datei, die der Dienst in den WiCAM-Pool schreibt – nur als Download, ohne Statuswechsel.
            @if (a.Status != BfAuftragStatus.Freigegeben && a.Status != BfAuftragStatus.Fertig) { <text>Termine und Bemerkung entstehen erst bei der Freigabe.</text> }</span>
    </form>
}
@if (Model.IstSchachtler && a.Status == BfAuftragStatus.Freigegeben && a.CsvStatus == BfCsvStatus.Fehler)
{
    <form method="post" asp-action="CsvErneutSchreiben" class="mt-3">
        <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" />
        <button type="submit" class="btn btn-outline-primary">CSV erneut schreiben</button>
        <span class="text-muted ms-2">Bei „Datei existiert bereits“ zuerst die Datei im WiCAM-Pool prüfen bzw. löschen.</span>
    </form>
}

@if (Model.IstSchachtler && a.Status == BfAuftragStatus.Freigegeben)
{
    <div class="mt-3">
        @if (a.CsvStatus == BfCsvStatus.Geschrieben)
        {
            <form method="post" asp-action="FertigMelden" class="d-inline">
                <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <button type="submit" class="btn btn-success">Fertig melden</button>
            </form>
            <span class="text-muted ms-2">Nur Status, keine Lagerbuchung.</span>
        }
        else
        {
            <span class="text-muted">Fertig melden erst, wenn die CSV geschrieben ist (CSV: @BfAuftragListRow.CsvText(a.CsvStatus)).</span>
        }
    </div>
}
@if (Model.DarfStornieren)
{
    <details class="mt-4">
        <summary class="text-danger">Auftrag stornieren</summary>
        <form method="post" asp-action="Stornieren" class="row g-2 align-items-end mt-1">
            <input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" />
            <div class="col-md-6">
                <label class="form-label" for="grund">Grund (optional)</label>
                <input type="text" id="grund" name="grund" class="form-control" maxlength="500" />
            </div>
            <div class="col-md-6">
                <button type="submit" class="btn btn-outline-danger">Stornieren</button>
            </div>
            @if (a.Status == BfAuftragStatus.Freigegeben)
            {
                <div class="col-12 text-danger small">Der Auftrag ist freigegeben: die CSV liegt ggf. bereits im WiCAM-Pool – den Auftrag dann in WiCAM löschen.</div>
            }
        </form>
    </details>
}

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
}
