@model IdealAkeWms.Models.ViewModels.ServiceSettingsViewModel
@using IdealAkeWms.Models
@using IdealAkeWms.Services
@{
    ViewData["Title"] = "Service-Einstellungen";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="page-header mb-0">Service-Einstellungen</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning">@TempData["WarningMessage"]</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning">
        <strong>Nicht gespeichert:</strong>
        <ul class="mb-0">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@err.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="alert alert-info mb-3">
    <strong>Hinweis:</strong> Diese Werte werden vom Windows-Dienst gelesen (DB gewinnt).
    Datenbankverbindungen (<code>ConnectionStrings</code>) und SMTP (<code>MailSettings</code>)
    bleiben in <code>appsettings.json</code> des Dienstes.
</div>

<div class="mb-3">
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#sageTestModal">
        Sage-Verbindung testen
    </button>
    <span class="form-text ms-2">Prüft die SData-Schnittstelle (URL/TLS/Anmeldung) mit den Werten dieser Seite.</span>
</div>

<form asp-action="SaveSettings" method="post">
    @Html.AntiForgeryToken()
    @foreach (var group in Model.Groups)
    {
        <div class="card mb-3">
            <div class="card-header fw-semibold">@group.Category</div>
            <div class="card-body">
                @foreach (var item in group.Items)
                {
                    <div class="mb-3" data-setting-row="@item.Key">
                        <label class="form-label fw-bold">@item.Key</label>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <br /><small class="text-muted">@item.Description</small>
                        }
                        @if (item.Key == SageTlsPolicy.SettingKey && !SageTlsPolicy.ShouldVerifyCertificate(item.Value))
                        {
                            <div class="alert alert-warning py-2 px-3 mt-2 mb-1 small">
                                <strong>&#9888; TLS-Zertifikatsprüfung ist deaktiviert.</strong>
                                Nur für Testsysteme zulässig &mdash; vor Produktivgang wieder aktivieren.
                            </div>
                        }
                        @if (item.Type == ServiceSettingType.Bool)
                        {
                            var isChecked = string.Equals(item.Value, "true", StringComparison.OrdinalIgnoreCase);
                            <input type="hidden" name="settings[@item.Key]" value="@(isChecked ? "true" : "false")" class="bool-hidden" />
                            <div class="form-check form-switch mt-1">
                                <input type="checkbox" class="form-check-input bool-toggle" id="setting_@item.Key" @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="setting_@item.Key">@(isChecked ? "Aktiviert" : "Deaktiviert")</label>
                            </div>
                        }
                        else if (item.Type == ServiceSettingType.Int)
                        {
                            <input type="number" step="1" name="settings[@item.Key]" value="@item.Value" class="form-control" />
                        }
                        else if (item.Multiline)
                        {
                            <textarea name="settings[@item.Key]" rows="2" class="form-control">@item.Value</textarea>
                        }
                        else
                        {
                            <input type="text" name="settings[@item.Key]" value="@item.Value" class="form-control" />
                        }
                    </div>
                }
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary mb-4">Einstellungen speichern</button>
</form>

<div class="card mb-3">
    <div class="card-header">
        <button class="btn btn-link p-0 text-decoration-none fw-semibold" type="button"
                data-bs-toggle="collapse" data-bs-target="#orphanSection" aria-expanded="false">
            Sonstige / Erweitert (@Model.OrphanEntries.Count)
        </button>
        <a asp-action="Create" class="btn btn-sm btn-outline-primary float-end">Neu</a>
    </div>
    <div id="orphanSection" class="collapse">
        <div class="card-body">
            @if (!Model.OrphanEntries.Any())
            {
                <p class="text-muted mb-0">Keine zusaetzlichen (nicht-katalogisierten) Eintraege.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th style="width: 30%">Schlüssel</th>
                                <th style="width: 30%">Wert</th>
                                <th>Beschreibung</th>
                                <th style="width: 130px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrphanEntries)
                            {
                                <tr>
                                    <td><code>@item.Key</code></td>
                                    <td>@item.Value</td>
                                    <td class="text-muted small">@item.Description</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Edit" asp-route-id="@item.Key" class="btn btn-sm btn-secondary">Bearbeiten</a>
                                            <form asp-action="Delete" asp-route-id="@item.Key" method="post" class="m-0"
                                                  onsubmit="return confirm('Einstellung \'@item.Key\' löschen?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="sageTestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sage-Verbindung testen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Nebenwirkungsfreier <strong>GET</strong> gegen die SData-API mit den aktuellen (ggf. noch
                    ungespeicherten) Werten dieser Seite &mdash; es wird <strong>nie</strong> eine Buchung angelegt.
                    Anmeldedaten wie im Dienst-<code>appsettings.json</code> (<code>SageLagerbuchung:Username/Password</code>);
                    sie werden nur für diesen Test verwendet, nicht gespeichert.
                </p>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small mb-0">Benutzer</label>
                        <input id="sageTestUser" class="form-control form-control-sm" autocomplete="off" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-0">Passwort</label>
                        <input id="sageTestPass" type="password" class="form-control form-control-sm" autocomplete="off" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-0">Resource (relativ zum Dataset)</label>
                        <input id="sageTestResource" class="form-control form-control-sm" list="sageTestResources" value="$schema" />
                        <datalist id="sageTestResources">
                            <option value="$schema"></option>
                            <option value="Adressen?count=1&amp;format=application/json"></option>
                            <option value="Artikel?count=1&amp;format=application/json"></option>
                        </datalist>
                        <div class="form-text">
                            <code>$schema</code> = Metadaten/Funktionsumfang der Schnittstelle;
                            <code>Adressen</code>, <code>Artikel</code> = Lese-Resourcen (Beispiele).
                        </div>
                    </div>
                </div>
                <button type="button" id="sageTestRun" class="btn btn-primary btn-sm mt-3">Testen</button>

                <div id="sageTestResult" class="mt-3 d-none">
                    <div id="sageTestStatus" class="mb-2"></div>
                    <div class="small text-muted">Angeforderte URL:</div>
                    <pre id="sageTestUrl" class="small bg-light border p-2 mb-2" style="white-space:pre-wrap;word-break:break-all;"></pre>
                    <div class="small text-muted">Response-Header:</div>
                    <pre id="sageTestHeaders" class="small bg-light border p-2 mb-2" style="white-space:pre-wrap;max-height:12rem;overflow:auto;"></pre>
                    <div class="small text-muted">Body:</div>
                    <pre id="sageTestBody" class="small bg-light border p-2 mb-0" style="white-space:pre-wrap;max-height:22rem;overflow:auto;"></pre>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Bool-Toggle: synchronisiert den Hidden-Wert + Label (Fallstrick: Hidden+Checkbox
        // gleicher name funktioniert NICHT — Checkbox hat KEIN name, Hidden traegt den name).
        document.querySelectorAll('.bool-toggle').forEach(function (cb) {
            cb.addEventListener('change', function () {
                var hidden = this.closest('[data-setting-row]').querySelector('.bool-hidden');
                if (hidden) hidden.value = this.checked ? 'true' : 'false';
                var label = this.parentElement.querySelector('.form-check-label');
                if (label) label.textContent = this.checked ? 'Aktiviert' : 'Deaktiviert';
            });
        });

        // Sage-Verbindungstest: GET-Probe mit den aktuellen Formularwerten, Ausgabe im Modal.
        (function () {
            var runBtn = document.getElementById('sageTestRun');
            if (!runBtn) return;

            function settingValue(key) {
                var el = document.querySelector('input[name="settings[' + key + ']"]');
                return el ? el.value : '';
            }

            runBtn.addEventListener('click', async function () {
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var sslRaw = settingValue('SageLagerbuchungSslZertifikatPruefen');
                var payload = {
                    baseUrl: settingValue('SData:BaseUrl'),
                    application: settingValue('SData:Application'),
                    serviceContract: settingValue('SData:ServiceContract'),
                    dataset: settingValue('SData:Dataset'),
                    // fail-safe: alles ausser explizit "false" => pruefen
                    verifyCertificate: sslRaw.toLowerCase() !== 'false',
                    username: document.getElementById('sageTestUser').value,
                    password: document.getElementById('sageTestPass').value,
                    resource: document.getElementById('sageTestResource').value
                };

                runBtn.disabled = true;
                var original = runBtn.textContent;
                runBtn.textContent = 'Teste…';
                try {
                    var resp = await fetch('@Url.Action("TestSageConnection")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token ? token.value : ''
                        },
                        body: JSON.stringify(payload)
                    });
                    var data = await resp.json();

                    document.getElementById('sageTestResult').classList.remove('d-none');
                    var st = document.getElementById('sageTestStatus');
                    if (data.error) {
                        st.innerHTML = '<span class="badge bg-danger">Verbindungsfehler</span> '
                            + '<span class="small"></span>';
                        st.querySelector('span.small').textContent = data.error;
                    } else {
                        var cls = data.ok ? 'bg-success' : 'bg-danger';
                        st.innerHTML = '<span class="badge ' + cls + '">HTTP ' + data.status + '</span> '
                            + '<span class="small reason"></span>'
                            + (data.sslVerify ? '' : ' <span class="badge bg-warning text-dark">TLS-Prüfung aus</span>');
                        st.querySelector('span.reason').textContent = data.reason || '';
                    }
                    document.getElementById('sageTestUrl').textContent = data.requestUrl || '';
                    document.getElementById('sageTestHeaders').textContent =
                        (data.headers || []).map(function (h) { return h.name + ': ' + h.value; }).join('\n');
                    document.getElementById('sageTestBody').textContent = data.body || '';
                } catch (e) {
                    document.getElementById('sageTestResult').classList.remove('d-none');
                    document.getElementById('sageTestStatus').innerHTML =
                        '<span class="badge bg-danger">Fehler</span>';
                    document.getElementById('sageTestBody').textContent = String(e);
                } finally {
                    runBtn.disabled = false;
                    runBtn.textContent = original;
                }
            });
        })();
    </script>
}
