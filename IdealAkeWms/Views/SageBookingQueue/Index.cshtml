@using IdealAkeWms.Controllers
@using IdealAkeWms.Models
@using IdealAkeWms.Models.ViewModels
@using IdealAkeWms.Services
@model IdealAkeWms.Models.ViewModels.SageBookingQueueViewModel
@{
    // v1.99.66 (Spec 2026-11-23-sage-buchungen-gesamtsicht): Lagerbuchungen und Sage-Wareneingänge auf einer Seite, Knöpfe beider Seiten.
    ViewData["Title"] = "Sage-Buchungen";
    var we = Model.ZeigtWareneingaenge;
    // F7: ohne WE-Recht keine WE-Spalten (auch nicht im Zahnrad)
    bool Zeige(string key) => we || !ColumnDefinitions.SageBookingQueueWeSpalten.Contains(key);
    var spalten = ColumnDefinitions.SageBookingQueue.Columns.Where(c => Zeige(c.Key)).ToList();
    var t = SageBuchungenGesamtsicht.Spalten;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="page-header mb-0">Sage-Buchungen</h2>
    @if (Model.CanReceive)
    {
        <a asp-controller="PurchaseOrders" asp-action="Receive" class="btn btn-outline-secondary">Wareneingang zu Bestellung</a>
    }
</div>

@if (Model.SslCheckDisabled)
{
    <div class="alert alert-warning d-flex align-items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
        </svg>
        <div>
            <strong>TLS-Zertifikatsprüfung deaktiviert.</strong> Die Sage-Lagerbuchungen prüfen das
            Server-Zertifikat aktuell <strong>nicht</strong> &mdash; nur für Testsysteme zulässig.
            Vor Produktivgang unter <em>Service-Einstellungen</em> die Einstellung
            <code>SageLagerbuchungSslZertifikatPruefen</code> wieder auf <em>true</em> setzen.
        </div>
    </div>
}
@if (Model.AusHinweis != null)
{
    @* v1.99.7 Q-2 *@
    <div class="alert alert-warning" role="alert"><strong>&#9888; @Model.AusHinweis</strong></div>
}
@foreach (var h in Model.CsvHinweise)
{
    @* v1.99.11 Wareneingang-CSV F4 *@
    <div class="alert alert-warning" role="alert"><strong>&#9888; @h</strong></div>
}

<p class="text-muted small">
    Was das WMS an Sage übergibt.
    @if (Model.ZeigtLagerbuchungen)
    {
        <text>Lagerbuchungen (Ein-/Ausbuchung, Umbuchung, Lagerbestellung): Ein Fehler-Eintrag kann erneut eingereiht werden &mdash; der Dienst prüft
        vor dem Senden über den Sage-Memo-Lookup, ob die Buchung dort bereits existiert (kein Doppelbuchen).</text>
    }
    @if (we)
    {
        <text>Wareneingänge gehen als ein Sage-Wareneingangsbeleg (ELL) je Buchung der Maske an Sage; eine Zeile je Position. Nach einem Fehler
        wiederholt der Dienst selbst und sucht vorher den Beleg in Sage (Spalte „Memo“). Findet er einen möglichen Beleg ohne diese Kennung, steht der
        Eintrag auf <strong>klären</strong>: in Sage prüfen, dann „Als übergeben markieren“ (Beleg existiert) oder „Erneut senden“ (Beleg fehlt).
        Die Knöpfe stehen an der ersten Position des Vorgangs und wirken auf alle Positionen.</text>
    }
</p>

<div class="card filter-card mb-3">
    <div class="card-body p-2">
        <form method="get" asp-action="Index" class="d-flex gap-2 align-items-end flex-wrap">
            <div>
                <label for="herkunft" class="form-label small mb-0">Herkunft</label>
                <select id="herkunft" name="herkunft" class="form-select form-select-sm">
                    <option value="">Alle</option>
                    @foreach (var h in Enum.GetValues<SageBuchungHerkunft>())
                    {
                        if ((h == SageBuchungHerkunft.Wareneingang && !we) || (h != SageBuchungHerkunft.Wareneingang && !Model.ZeigtLagerbuchungen)) continue;
                        <option value="@h" selected="@(Model.Herkunft == h)">@SageBuchungenGesamtsicht.HerkunftText(h)</option>
                    }
                </select>
            </div>
            <div>
                <label for="status" class="form-label small mb-0">Status</label>
                <select id="status" name="status" class="form-select form-select-sm">
                    <option value="">Alle</option>
                    @foreach (var s in Enum.GetValues<SageBuchungAnzeige>())
                    {
                        <option value="@s" selected="@(Model.Status == s)">@SageBuchungenGesamtsicht.Text(s)</option>
                    }
                </select>
            </div>
            <div class="form-check mb-1">
                <input class="form-check-input" type="checkbox" id="nurOffene" name="nurOffene" value="true" checked="@Model.NurOffene" />
                <label class="form-check-label small" for="nurOffene">nur offene</label>
            </div>
            @if (we)
            {
                <div>
                    <label for="bestellung" class="form-label small mb-0">Bestellung</label>
                    <input type="text" id="bestellung" name="bestellung" value="@Model.Bestellung" class="form-control form-control-sm" autocomplete="off" />
                </div>
            }
            <div>
                <label for="von" class="form-label small mb-0">erstellt von</label>
                <input type="date" id="von" name="von" value="@Model.Von.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div>
                <label for="bis" class="form-label small mb-0">bis</label>
                <input type="date" id="bis" name="bis" value="@(Model.Bis?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <button type="submit" class="btn btn-sm btn-primary">Filtern</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Zurücksetzen</a>
        </form>
        <div class="small text-body-secondary mt-1">Ohne „von“ gelten die letzten @SageBuchungenGesamtsicht.StandardTage Tage. Offene Buchungen (wartet, gesendet, Fehler, klären) stehen immer in der Liste.</div>
    </div>
</div>

@if (Model.OffeneAusserhalb > 0)
{
    <div class="alert alert-info py-2" role="status">@Model.OffeneAusserhalb offene Buchungen außerhalb des Zeitraums werden mit angezeigt.</div>
}

<div class="d-flex justify-content-end mb-1" data-table-toolbar></div>
<div class="table-responsive">
    <table class="table table-striped table-sm mb-0 filterable-table" data-server-column-filter="true" data-view-key="SageBookingQueue">
        <thead>
            <tr>
                <th data-filterable data-filter-type="number" data-col-key="id">#</th>
                <th data-filterable data-col-key="herkunft">Herkunft</th>
                <th data-filterable data-col-key="status">Status</th>
                <th data-filterable data-col-key="status-weg">Status im Weg</th>
                <th data-filterable data-date-filter data-col-key="created-at">Erstellt</th>
                @if (we)
                {
                    <th data-filterable data-col-key="bestellung">Bestellung</th>
                    <th data-filterable data-filter-type="number" data-col-key="pos" title="Sage-Positions-ID (BelPosId)">Pos.-ID</th>
                }
                <th data-filterable data-col-key="article">Artikel</th>
                <th class="text-end" data-filterable data-filter-type="number" data-col-key="quantity">Menge</th>
                <th data-filterable data-col-key="storage-location">Lagerplatz</th>
                @if (we)
                {
                    <th data-filterable data-col-key="sagebeleg">Sage-Beleg</th>
                }
                <th data-filterable data-date-filter data-col-key="sent-at">Gesendet</th>
                <th data-filterable data-date-filter data-col-key="confirmed-at">Übergeben am</th>
                <th data-filterable data-filter-type="number" data-col-key="attempts">Vers.</th>
                <th data-filterable data-col-key="error">Fehler</th>
                <th data-filterable data-col-key="erfasst-von">Erfasst von</th>
                @if (we)
                {
                    <th data-filterable data-col-key="lieferschein">Lieferschein</th>
                    <th data-filterable data-col-key="barcode">Barcode</th>
                    <th data-filterable data-col-key="memo-position">Positionsmemo</th>
                    <th data-filterable data-col-key="memo">Memo</th>
                    <th data-filterable data-col-key="csv" title="CSV-Datei für das DMS (Wareneingang-CSV)">CSV</th>
                }
                <th data-col-key="actions"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var z in Model.Zeilen)
            {
                var q = z.Queue;
                var r = z.We?.Receipt;
                <tr>
                    <td>@t["id"](z)</td>
                    <td>@t["herkunft"](z)</td>
                    <td><span class="badge @SageBuchungenGesamtsicht.Badge(z.Anzeige)">@t["status"](z)</span></td>
                    <td class="small">@t["status-weg"](z)</td>
                    <td class="text-nowrap">@t["created-at"](z)</td>
                    @if (we)
                    {
                        <td>@t["bestellung"](z)</td>
                        <td>@t["pos"](z)</td>
                    }
                    <td>@t["article"](z)</td>
                    <td class="text-end">@t["quantity"](z)</td>
                    <td>@t["storage-location"](z)</td>
                    @if (we)
                    {
                        <td>@t["sagebeleg"](z)</td>
                    }
                    <td class="text-nowrap">@t["sent-at"](z)</td>
                    <td class="text-nowrap">@t["confirmed-at"](z)</td>
                    <td>@t["attempts"](z)</td>
                    <td>
                        @if (q != null && (!string.IsNullOrEmpty(q.LastError) || !string.IsNullOrEmpty(q.SageResponseRaw)))
                        {
                            var detail = string.Join("\n\n", new[] { q.LastError, q.SageResponseRaw }.Where(s => !string.IsNullOrEmpty(s)));
                            var shown = q.LastError ?? q.SageResponseRaw ?? "";
                            <span class="text-danger small" title="@detail">@(shown.Length > 60 ? shown.Substring(0, 60) + "…" : shown)</span>
                            @if (!string.IsNullOrEmpty(q.SageResponseRaw))
                            {
                                <details class="small">
                                    <summary class="text-muted" style="cursor:pointer;">Sage-Antwort</summary>
                                    <pre class="mb-0 mt-1" style="white-space:pre-wrap;max-height:12rem;overflow:auto;">@q.SageResponseRaw</pre>
                                </details>
                            }
                        }
                        else if (r != null)
                        {
                            <span class="small text-danger-emphasis" style="white-space:pre-wrap;">@r.SageWeFehler</span>
                        }
                    </td>
                    <td>@t["erfasst-von"](z)</td>
                    @if (we)
                    {
                        <td>@t["lieferschein"](z)</td>
                        <td class="text-nowrap">@t["barcode"](z)</td>
                        <td>@t["memo-position"](z)</td>
                        <td class="text-nowrap">@t["memo"](z)</td>
                        <td class="small @(z.We?.CsvFehler == true ? "text-danger-emphasis fw-semibold" : "")">@t["csv"](z)</td>
                    }
                    <td class="text-nowrap">
                        @if (q != null && Model.CanRequeue && q.Status == SageBookingQueueStatus.Fehler)
                        {
                            <form asp-action="Requeue" asp-route-id="@q.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Erneut senden</button>
                            </form>
                        }
                        @if (r != null && r.SageWeVorgang is { } vorgang && Model.CanWeAktionen)
                        {
                            if (!z.ZeigtWeAktionen)
                            {
                                if (r.SageWeStatus is SageWareneingangStatus.Fehler or SageWareneingangStatus.Klaeren || z.We!.CsvFehler)
                                {
                                    <span class="small text-body-secondary">gehört zu Vorgang @z.We!.Memo</span>
                                }
                            }
                            else
                            {
                                @if (r.SageWeStatus is SageWareneingangStatus.Fehler or SageWareneingangStatus.Klaeren)
                                {
                                    <form asp-controller="PurchaseOrders" asp-action="SageWeErneutSenden" asp-route-vorgang="@vorgang" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Der Dienst sucht vorher die Memo-Kennung @z.We!.Memo in Sage. Einen Beleg ohne diese Kennung findet er dabei nicht – den vorher selbst prüfen.">Erneut senden</button>
                                    </form>
                                    <form asp-controller="PurchaseOrders" asp-action="SageWeAlsUebergeben" asp-route-vorgang="@vorgang" method="post" class="d-flex gap-1 mt-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <input type="text" name="belegnummer" maxlength="@SagePurchaseOrderLine.BelegnummerMaxLaenge" required class="form-control form-control-sm" style="width: 9rem;"
                                               placeholder="Sage-Beleg-Nr." aria-label="Sage-Belegnummer für @z.We!.Memo" autocomplete="off" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Als übergeben markieren</button>
                                    </form>
                                }
                                @if (z.We!.CsvFehler)
                                {
                                    @* v1.99.11 F4: nur bei CSV-Fehler; Hinweis vor dem Klick, weil eine vorhandene Datei nie überschrieben wird *@
                                    <form asp-controller="PurchaseOrders" asp-action="CsvErneutSchreiben" asp-route-vorgang="@vorgang" method="post" class="mt-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">CSV erneut schreiben</button>
                                        <div class="small text-body-secondary text-wrap" style="max-width: 16rem;">Vorher auf der Freigabe prüfen, ob @(r.Barcode).csv bzw. @(r.Barcode)_n.csv (Sammellieferschein) schon existiert bzw. verarbeitet wurde – der Dienst nimmt sonst die nächste freie Nummer.</div>
                                    </form>
                                }
                            }
                        }
                    </td>
                </tr>
            }
            @if (!Model.Zeilen.Any())
            {
                <tr>
                    <td colspan="@spalten.Count" class="text-center text-muted py-4">Keine Einträge.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Pagination" />

@* v1.99.66 Zahnrad: WE-Spalten standardmaessig ausgeblendet (ColumnDefinitions.SageBookingQueue), ohne WE-Recht gar nicht da *@
<script type="application/json" id="view-config">
{ "viewKey": "SageBookingQueue", "supportsReorder": false, "supportsSortDefault": false }
</script>
<script type="application/json" id="column-config">
@Json.Serialize(spalten.Select(c => new { key = c.Key, label = c.Label, locked = c.Locked, defaultWidth = c.DefaultWidth, defaultHidden = c.DefaultHidden }))
</script>

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
}
