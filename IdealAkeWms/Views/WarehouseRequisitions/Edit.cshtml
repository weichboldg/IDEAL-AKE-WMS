@model IdealAkeWms.Models.ViewModels.WarehouseRequisitionEditViewModel
@{
    string typeLabel = Model.Type == WarehouseRequisitionType.Glas ? "Glasbestellung" : "Lagerbestellung";
    ViewData["Title"] = $"{typeLabel} #{Model.Id}";
    bool isDraft = Model.Status == IdealAkeWms.Models.WarehouseRequisitionStatus.Draft;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 page-header">
    <h2 class="mb-0">@typeLabel #@Model.Id</h2>
    <a asp-action="Index" asp-route-type="@Model.Type" class="btn btn-sm btn-outline-secondary">Zurueck</a>
</div>

<div class="card mb-3">
    <div class="card-body p-2">
        <strong>Werkbank:</strong> @Model.WorkplaceName
        <span class="ms-3"><strong>Typ:</strong>
            <span class="badge @(Model.Type == WarehouseRequisitionType.Glas ? "bg-info text-dark" : "bg-secondary")">
                @(Model.Type == WarehouseRequisitionType.Glas ? "Glas" : "Lager")
            </span>
        </span>
        <span class="ms-3"><strong>Status:</strong>
            @switch (Model.Status)
            {
                case IdealAkeWms.Models.WarehouseRequisitionStatus.Draft: <span class="badge bg-secondary">Entwurf</span> break;
                case IdealAkeWms.Models.WarehouseRequisitionStatus.Submitted: <span class="badge bg-primary">Abgeschickt</span> break;
                case IdealAkeWms.Models.WarehouseRequisitionStatus.Closed: <span class="badge bg-success">Erledigt</span> break;
                case IdealAkeWms.Models.WarehouseRequisitionStatus.Cancelled: <span class="badge bg-dark">Storniert</span> break;
            }
        </span>
        <span class="ms-3"><strong>Erstellt:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
    </div>
</div>

@* v1.99.72 (F13, Antwort 24): Spaltenauswahl (Zahnrad) neu, ohne Filter/CSV; Fräsen-Pfad nur bei Schalter an, Standard ausgeblendet *@
<div class="d-flex justify-content-end mb-1" data-table-toolbar></div>
<div class="table-responsive">
    <table class="table table-sm" id="items-table" data-view-key="WarehouseRequisitionItems">
        <thead>
            <tr>
                <th data-col-key="pos">Pos</th><th data-col-key="article-number">Artikel-Nr</th><th data-col-key="description">Bezeichnung</th>
                <th data-col-key="quantity">Menge</th><th data-col-key="unit">ME</th><th data-col-key="storage">Lagerplatz</th>
                @if (Model.FraesenPfade != null)
                {
                    <th data-col-key="fraesen-pfad">Fräsen-Pfad</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                var requestedInt = (int)Math.Round(i.QuantityRequested, MidpointRounding.AwayFromZero);
                <tr data-item-id="@i.Id" data-article="@i.ArticleNumber">
                    <td>@i.Position</td>
                    <td>
                        @i.ArticleNumber
                        @if (Model.FehlteilHinweise?.TryGetValue(i.ArticleNumber.Trim(), out var fehlteilHinweis) == true)
                        {
                            <div class="small text-warning-emphasis">@fehlteilHinweis</div>
                        }
                    </td>
                    <td>@i.ArticleDescription</td>
                    <td>
                        @if (isDraft)
                        {
                            <input type="number" step="1" min="1" value="@requestedInt" class="form-control form-control-sm qty-edit" data-item-id="@i.Id" style="width:80px;" />
                        }
                        else
                        {
                            @requestedInt
                        }
                    </td>
                    <td>@i.Unit</td>
                    <td class="stock-cell"><span class="text-muted small">…</span></td>
                    @if (Model.FraesenPfade != null)
                    {
                        var pfad = Model.FraesenPfade.GetValueOrDefault(i.ArticleNumber.Trim());
                        <td><partial name="_FraesenPfad" model="pfad" /></td>
                    }
                    <td>
                        @if (isDraft)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger remove-item" data-item-id="@i.Id">×</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (isDraft)
{
    <div class="card mb-3">
        <div class="card-body">
            <label class="form-label">Artikel hinzufuegen</label>
            <input id="article-search" type="text" class="form-control" placeholder="Artikel-Nr, Bezeichnung oder Matchcode (mind. 3 Zeichen)" autocomplete="off" />
            <div id="article-search-results" class="list-group mt-1" style="max-height: 300px; overflow-y: auto;"></div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <label for="req-comment" class="form-label">Kommentar</label>
        @if (isDraft)
        {
            <textarea id="req-comment" class="form-control" rows="3" maxlength="1000"
                      placeholder="Kommentar zur Bestellung (optional)">@Model.Comment</textarea>
            <div class="form-text">Wird automatisch gespeichert.</div>
        }
        else
        {
            <div>@(string.IsNullOrWhiteSpace(Model.Comment) ? "—" : Model.Comment)</div>
        }
    </div>
</div>

@if (isDraft)
{

    <form method="post" asp-action="Submit" asp-route-id="@Model.Id" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary" @(Model.Items.Count == 0 ? "disabled" : "")>Abschicken</button>
    </form>
}

@if (Model.Status == IdealAkeWms.Models.WarehouseRequisitionStatus.Draft || Model.Status == IdealAkeWms.Models.WarehouseRequisitionStatus.Submitted)
{
    <button type="button" class="btn btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#cancel-modal">Stornieren</button>

    <div class="modal fade" id="cancel-modal" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" asp-action="Cancel" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header"><h5 class="modal-title">Liste stornieren</h5></div>
                    <div class="modal-body">
                        <label class="form-label">Grund (optional)</label>
                        <textarea name="reason" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                        <button type="submit" class="btn btn-danger">Stornieren</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

<script type="application/json" id="view-config">
{ "viewKey": "WarehouseRequisitionItems", "supportsReorder": false, "supportsSortDefault": false }
</script>
<script type="application/json" id="column-config">
[
    { "key": "pos", "label": "Pos", "locked": true, "defaultWidth": null },
    { "key": "article-number", "label": "Artikel-Nr", "locked": true, "defaultWidth": null },
    { "key": "description", "label": "Bezeichnung", "locked": false, "defaultWidth": null },
    { "key": "quantity", "label": "Menge", "locked": false, "defaultWidth": null },
    { "key": "unit", "label": "ME", "locked": false, "defaultWidth": null },
    @if (Model.FraesenPfade != null)
    {
        @:{ "key": "storage", "label": "Lagerplatz", "locked": false, "defaultWidth": null },
        @:{ "key": "fraesen-pfad", "label": "Fräsen-Pfad", "locked": false, "defaultWidth": null, "defaultHidden": true }
    }
    else
    {
        @:{ "key": "storage", "label": "Lagerplatz", "locked": false, "defaultWidth": null }
    }
]
</script>

@section Scripts {
<script src="~/js/column-preferences.js" asp-append-version="true"></script>
<script>
(function() {
    const reqId = @Model.Id;

    function loadStock(row) {
        // v1.99.72: ueber data-article statt cells[1] – die Spaltenauswahl darf Spalten aus-/umstellen
        const articleNumber = (row.dataset.article || '').trim();
        if (!articleNumber) return;
        fetch(`/api/warehouserequisitions/stock?articleNumber=${encodeURIComponent(articleNumber)}`)
            .then(r => r.json())
            .then(data => {
                const cell = row.querySelector('.stock-cell');
                if (!cell) return;
                // v1.99.79 F-19: Lagerplatz-Codes (Sage-Stammdaten) als Text, nie als HTML
                const s = document.createElement('small');
                s.className = 'text-muted';
                s.textContent = data.locations || '—';
                cell.replaceChildren(s);
            });
    }
    document.querySelectorAll('#items-table tbody tr').forEach(loadStock);

    @if (isDraft)
    {
        <text>
        const search = document.getElementById('article-search');
        const results = document.getElementById('article-search-results');
        let timer;
        search.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => {
                const q = search.value.trim();
                if (q.length < 3) { results.innerHTML = ''; return; }
                fetch(`/api/articles/search?q=${encodeURIComponent(q)}&limit=20&type=@Model.Type`)
                    .then(r => r.json())
                    .then(arr => {
                        if (arr.length === 0) {
                            results.innerHTML = `
                                <div class="list-group-item">
                                    <div class="text-muted mb-2">Kein Artikel gefunden.</div>
                                    <div class="input-group input-group-sm">
                                        <input type="text" id="dummy-desc" class="form-control" maxlength="500" placeholder="Bezeichnung (Pflicht)" />
                                        <input type="number" id="dummy-qty" class="form-control" style="max-width:80px;" value="1" min="1" step="1" />
                                        <button type="button" id="dummy-add-btn" class="btn btn-outline-primary">DUMMY-Position anlegen</button>
                                    </div>
                                </div>`;
                            return;
                        }
                        // v1.99.79 F-19: Artikeltexte (Sage) als Text/Attribut setzen – Zeichen wie < oder " brechen sonst das HTML
                        results.replaceChildren(...arr.map(a => {
                            const b = document.createElement('button');
                            b.type = 'button';
                            b.className = 'list-group-item list-group-item-action';
                            b.dataset.art = a.text.split(' - ')[0];
                            b.textContent = a.text;
                            return b;
                        }));
                    });
            }, 250);
        });

        // Flush pending qty edits before adding a new item + reload.
        async function flushPendingQty() {
            const pending = Array.from(document.querySelectorAll('.qty-edit'))
                .filter(inp => inp.value !== inp.defaultValue)
                .map(inp => fetch(`/api/warehouserequisitions/items/${inp.dataset.itemId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ quantity: parseInt(inp.value, 10) || 0 })
                }));
            await Promise.all(pending);
        }

        results.addEventListener('click', async e => {
            const btn = e.target.closest('button');
            if (!btn) return;

            // DUMMY-Position (unbekannte EK-Nummer): Pflicht-Bezeichnung.
            if (btn.id === 'dummy-add-btn') {
                const descEl = document.getElementById('dummy-desc');
                const qtyEl = document.getElementById('dummy-qty');
                const description = (descEl?.value || '').trim();
                if (!description) { alert('Bitte eine Bezeichnung eingeben.'); descEl?.focus(); return; }
                const quantity = parseInt(qtyEl?.value, 10) || 1;
                await flushPendingQty();
                const rd = await fetch(`/api/warehouserequisitions/${reqId}/items/dummy`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ description, quantity })
                });
                if (rd.ok) {
                    location.reload();
                } else {
                    const j = await rd.json().catch(() => ({}));
                    alert(j.error || 'Fehler');
                }
                return;
            }

            const articleNumber = btn.dataset.art;
            if (!articleNumber) return;

            await flushPendingQty();

            const r = await fetch(`/api/warehouserequisitions/${reqId}/items`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ articleNumber, quantity: 1 })
            });
            if (r.ok) {
                location.reload();
            } else {
                const j = await r.json();
                alert(j.error || 'Fehler');
            }
        });

        document.querySelectorAll('.qty-edit').forEach(inp => {
            inp.addEventListener('change', () => {
                fetch(`/api/warehouserequisitions/items/${inp.dataset.itemId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ quantity: parseInt(inp.value, 10) || 0 })
                });
            });
        });
        document.querySelectorAll('.remove-item').forEach(btn => {
            btn.addEventListener('click', () => {
                if (!confirm('Artikel entfernen?')) return;
                fetch(`/api/warehouserequisitions/items/${btn.dataset.itemId}`, { method: 'DELETE' })
                    .then(() => location.reload());
            });
        });

        // Kommentar-Autosave (Kopf-Ebene), analog den Positions-Notizen.
        const commentEl = document.getElementById('req-comment');
        if (commentEl) {
            let lastComment = commentEl.value;
            commentEl.addEventListener('blur', () => {
                if (commentEl.value === lastComment) return;
                lastComment = commentEl.value;
                fetch(`/api/warehouserequisitions/${reqId}/comment`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ comment: commentEl.value })
                });
            });
        }
        </text>
    }
})();
</script>
}
