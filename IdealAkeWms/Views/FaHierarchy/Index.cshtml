@model IdealAkeWms.Models.ViewModels.FaHierarchyTreeViewModel
@{
    ViewData["Title"] = "FA-Struktur (IDEAL)";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <h2 class="page-header">FA-Struktur (IDEAL)</h2>
    <div class="d-flex gap-2 mt-1">
        <button type="button" id="btnFaExpandAll" class="btn btn-sm btn-outline-secondary" title="Alle aufklappen">Alle aufklappen</button>
        <button type="button" id="btnFaCollapseAll" class="btn btn-sm btn-outline-secondary" title="Alle zuklappen">Alle zuklappen</button>
    </div>
</div>

@* Filterkarte — server-seitig auf STRUKTUR-Ebene: entscheidet, welche Strukturen erscheinen
   (Kopf ODER irgendein Knoten passt). Innerhalb einer Struktur werden nie Knoten entfernt. *@
<div class="card filter-card mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-0 small">HauptFA</label>
                <input type="text" name="filterHauptFa" value="@Model.FilterHauptFa" class="form-control form-control-sm" placeholder="FA-Nr." />
            </div>
            <div class="col-md-3">
                <label class="form-label mb-0 small">Kunde</label>
                <input type="text" name="filterCustomer" value="@Model.FilterCustomer" class="form-control form-control-sm" placeholder="Kunde" />
            </div>
            <div class="col-md-4">
                <label class="form-label mb-0 small">Suche (Artikel, Bezeichnung, Status ...)</label>
                <input type="text" name="filterText" value="@Model.FilterText" class="form-control form-control-sm" placeholder="Artnr., Bezeichnung, Matchcode, Status ..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-secondary">Filtern</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.FilterHauptFa) || !string.IsNullOrEmpty(Model.FilterCustomer) || !string.IsNullOrEmpty(Model.FilterText))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Zurücksetzen</a>
                </div>
            }
        </form>
        <div class="mt-2">
            <input type="text" id="faClientFilter" class="form-control form-control-sm" style="max-width: 420px;"
                   placeholder="Knoten in angezeigten Strukturen hervorheben ..." />
            <div class="form-text">
                Hebt passende Knoten <em>innerhalb</em> der angezeigten Strukturen hervor (ohne die
                Baumstruktur zu verändern).
                @if (Model.RecursiveFilterSearch)
                {
                    <span>Trefferpfade werden automatisch aufgeklappt (Einstellung „Rekursive Filtersuche" aktiv).</span>
                }
            </div>
        </div>
    </div>
</div>

@if (!Model.Structures.Any())
{
    <div class="alert alert-info">Keine Strukturen gefunden.</div>
}

@foreach (var structure in Model.Structures)
{
    <div class="card mb-3 fa-structure">
        <div class="card-header d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <strong>HauptFA @structure.HauptFA</strong>
                @if (structure.IsOrphan)
                {
                    <span class="badge bg-warning text-dark ms-2" title="VaterFA verweist auf keinen importierten Parent">
                        Verwaist — VaterFA @(structure.OrphanVaterFa?.ToString() ?? "?") nicht gefunden
                    </span>
                }
                @if (structure.IsAmbiguous)
                {
                    <span class="badge bg-info text-dark ms-2" title="HauptFA mit mehreren Montage-Abteilungen (Kombigerät)">
                        mehrdeutig (Kombigerät)
                    </span>
                }
                @if (structure.HasError)
                {
                    <span class="badge bg-danger ms-2" title="@structure.ErrorMessage">
                        Fehlerhaft — @structure.ErrorMessage
                    </span>
                }
                <span class="text-muted small ms-2">@structure.NodeCount Knoten</span>
            </div>
        </div>
        <div class="card-body">
            @* Kopfdaten aus FaHierarchyOrderInfo (Q1: bei Kombigeräten alle Zeilen im Klartext). *@
            @if (structure.OrderInfos.Any())
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered mb-0 fa-head-table">
                        <thead>
                            <tr>
                                <th>Montage-Abt.</th>
                                <th>Kunde</th>
                                <th>Status</th>
                                <th>KO-Termin</th>
                                <th>FE-Termin</th>
                                <th>AB-Nr.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var info in structure.OrderInfos)
                            {
                                <tr>
                                    <td>@info.MontageAbteilung</td>
                                    <td>@info.Kunde</td>
                                    <td>@info.Status</td>
                                    <td>@(info.KO_Termin?.ToString("dd.MM.yyyy") ?? "-")</td>
                                    <td>@(info.FE_Termin?.ToString("dd.MM.yyyy") ?? "-")</td>
                                    <td>@info.ABNr</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-muted small mb-3">Keine Auftrags-Kopfdaten (FaHierarchyOrderInfo) zu diesem HauptFA.</div>
            }

            @if (structure.HasError)
            {
                <div class="alert alert-danger py-2 px-3 small mb-2">
                    Diese Struktur wurde wegen eines Tiefen-Cap-/Zyklenfehlers nur teilweise aufgebaut
                    (@structure.ErrorMessage). Die übrigen Strukturen sind vollständig.
                </div>
            }

            <div class="fa-tree">
                @foreach (var root in structure.Roots)
                {
                    <partial name="_FaHierarchyNode" model="root" />
                }
            </div>
        </div>
    </div>
}

<partial name="_Pagination" model="Model.Pagination" />

@section Scripts {
    <style>
        .fa-node-row { padding-top: 2px; padding-bottom: 2px; border-bottom: 1px solid #f0f0f0; }
        .fa-toggle { cursor: pointer; user-select: none; display: inline-block; width: 16px; }
        .fa-toggle-placeholder { display: inline-block; width: 16px; }
        .fa-node-row.fa-hl { background-color: #fff3cd; }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Q4: Auto-Expand des Trefferpfads an das User-Setting RecursiveFilterSearch gekoppelt
            // (wie beim BOM-Tree). Ist es aus, werden Treffer nur hervorgehoben, nicht aufgeklappt.
            var recursiveFilterSearch = @(Model.RecursiveFilterSearch ? "true" : "false");

            function setExpanded(faNode, expanded) {
                var children = faNode.querySelector(':scope > .fa-node-children');
                if (!children) return;
                children.style.display = expanded ? 'block' : 'none';
                var chevron = faNode.querySelector(':scope > .fa-node-row .fa-chevron');
                if (chevron) chevron.style.transform = expanded ? 'rotate(90deg)' : '';
            }

            // Toggle je Knoten
            document.querySelectorAll('.fa-toggle').forEach(function (toggle) {
                toggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var faNode = this.closest('.fa-node');
                    var children = faNode.querySelector(':scope > .fa-node-children');
                    if (!children) return;
                    var isOpen = children.style.display !== 'none';
                    setExpanded(faNode, !isOpen);
                });
            });

            function setAll(expanded) {
                document.querySelectorAll('.fa-node').forEach(function (faNode) {
                    setExpanded(faNode, expanded);
                });
            }
            var btnExpand = document.getElementById('btnFaExpandAll');
            var btnCollapse = document.getElementById('btnFaCollapseAll');
            if (btnExpand) btnExpand.addEventListener('click', function () { setAll(true); });
            if (btnCollapse) btnCollapse.addEventListener('click', function () { setAll(false); });

            // Client-seitiger Knoten-Filter: hebt Treffer hervor, entfernt NIE Knoten aus dem DOM
            // (Baum-Integrität). Mit RecursiveFilterSearch werden Trefferpfade aufgeklappt.
            function expandAncestors(faNode) {
                var parent = faNode.parentElement;
                while (parent) {
                    if (parent.classList && parent.classList.contains('fa-node-children')) {
                        var ownerNode = parent.closest('.fa-node');
                        // parent ist der children-Container des ownerNode? -> aufklappen
                        if (ownerNode && ownerNode.querySelector(':scope > .fa-node-children') === parent) {
                            setExpanded(ownerNode, true);
                            parent = ownerNode.parentElement;
                            continue;
                        }
                    }
                    parent = parent.parentElement;
                }
            }

            var clientFilter = document.getElementById('faClientFilter');
            if (clientFilter) {
                clientFilter.addEventListener('input', function () {
                    var term = this.value.trim().toLowerCase();
                    document.querySelectorAll('.fa-node-row').forEach(function (row) {
                        row.classList.remove('fa-hl');
                    });
                    if (!term) return;
                    document.querySelectorAll('.fa-node-row').forEach(function (row) {
                        var hay = (row.getAttribute('data-search') || '');
                        if (hay.indexOf(term) !== -1) {
                            row.classList.add('fa-hl');
                            if (recursiveFilterSearch) {
                                expandAncestors(row.closest('.fa-node'));
                            }
                        }
                    });
                });
            }
        });
    </script>
}
