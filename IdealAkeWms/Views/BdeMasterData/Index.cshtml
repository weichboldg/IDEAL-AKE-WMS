@{
    ViewData["Title"] = "BDE Stammdaten";
    var tab = (ViewBag.Tab as string) ?? "operators";
    var operators = ViewBag.Operators as List<IdealAkeWms.Models.BdeOperator> ?? new List<IdealAkeWms.Models.BdeOperator>();
    var activities = ViewBag.Activities as List<IdealAkeWms.Models.BdeActivity> ?? new List<IdealAkeWms.Models.BdeActivity>();
    var terminals = ViewBag.Terminals as List<IdealAkeWms.Models.BdeTerminal> ?? new List<IdealAkeWms.Models.BdeTerminal>();
    var sageZeilen = ViewBag.SageZeilen as List<IdealAkeWms.Models.ViewModels.BdeSageZuordnungZeile> ?? new List<IdealAkeWms.Models.ViewModels.BdeSageZuordnungZeile>();
    var freieOperatoren = ViewBag.FreieOperatoren as List<IdealAkeWms.Models.BdeOperator> ?? new List<IdealAkeWms.Models.BdeOperator>();
    var onlyUebergabeOffen = (bool?)ViewBag.OnlyUebergabeOffen == true;
    var uebergabeOffenCount = (int?)ViewBag.UebergabeOffenCount ?? 0;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="page-header mb-0">BDE Stammdaten</h2>
</div>

<partial name="_BdeMasterDataTabs" model="tab" />

<div class="tab-content">
    @if (tab == "operators")
    {
        <div class="tab-pane active">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="mb-0">Operatoren</h5>
                <a asp-action="EditOperator" class="btn btn-primary">Neu anlegen</a>
            </div>

            @* E9/F11: „Offene Übergaben an Sage“ – im WMS angelegte Mitarbeiter ohne Sage-Zuordnung. Das WMS sendet nichts an Sage. *@
            @if (onlyUebergabeOffen)
            {
                <div class="alert alert-info d-flex justify-content-between align-items-start flex-wrap gap-2" role="status">
                    <div>
                        <strong>Offene Übergaben an Sage</strong><br />
                        Diese BDE-Mitarbeiter wurden im WMS angelegt und sind noch keinem Sage-PPS-Mitarbeiter zugeordnet. Bitte in Sage anlegen
                        und danach im Reiter „Sage-Zuordnung“ zuordnen – dann steht die Übergabe auf „Übergeben“. Das WMS sendet nichts an Sage.
                    </div>
                    <a asp-action="Index" asp-route-tab="operators" class="btn btn-sm btn-outline-secondary">Alle Operatoren zeigen</a>
                </div>
            }
            else if (uebergabeOffenCount > 0)
            {
                <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2" role="status">
                    <span><strong>@uebergabeOffenCount @(uebergabeOffenCount == 1 ? "BDE-Mitarbeiter wartet" : "BDE-Mitarbeiter warten")</strong> auf die Übergabe an Sage
                        (im WMS angelegt, noch keinem Sage-Mitarbeiter zugeordnet).</span>
                    <a asp-action="Index" asp-route-tab="operators" asp-route-onlyUebergabeOffen="true" class="btn btn-sm btn-outline-dark">Offene Übergaben anzeigen</a>
                </div>
            }

            <div class="table-responsive">
                @* Nur die Tabelle des aktiven Tabs wird gerendert (Razor-Conditional) —
                   table-filter.js/column-preferences.js sind Single-Table, daher pro Tab eigener view-key. *@
                <table class="table table-striped mb-0 filterable-table" data-server-column-filter="true" data-view-key="BdeMasterDataOperators">
                    <thead>
                        <tr>
                            <th data-filterable data-col-key="personnel-number">Personalnummer</th>
                            <th data-filterable data-col-key="name">Name</th>
                            <th data-filterable data-col-key="active">Aktiv</th>
                            <th data-filterable data-col-key="user">WMS-Benutzer</th>
                            <th data-filterable data-col-key="sage-number">Sage-Nr.</th>
                            <th data-filterable data-col-key="sage-uebergabe" title="Übergabe eines im WMS angelegten Mitarbeiters an Sage (leer = nicht nötig)">Übergabe an Sage</th>
                            <th data-col-key="actions" style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var op in operators)
                        {
                            <tr>
                                <td>@op.PersonnelNumber</td>
                                <td>@op.LastName @op.FirstName</td>
                                <td>
                                    @if (op.IsActive)
                                    {
                                        <span class="badge badge-active">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive">Inaktiv</span>
                                    }
                                </td>
                                <td>@(op.User?.Name ?? "-")</td>
                                <td>@(op.SageMitarbeiternummer ?? "-")</td>
                                <td><partial name="_SageUebergabeBadge" model="op.SageUebergabeStatus" /></td>
                                <td>
                                    <a asp-action="EditOperator" asp-route-id="@op.Id" class="btn btn-sm btn-secondary">Bearbeiten</a>
                                </td>
                            </tr>
                        }
                        @if (!operators.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">@(onlyUebergabeOffen ? "Keine offenen Übergaben an Sage." : "Keine Operatoren vorhanden.")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (tab == "activities")
    {
        <div class="tab-pane active">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="mb-0">Aktivitäten</h5>
                <a asp-action="EditActivity" class="btn btn-primary">Neu anlegen</a>
            </div>

            <div class="table-responsive">
                <table class="table table-striped mb-0 filterable-table" data-server-column-filter="true" data-view-key="BdeMasterDataActivities">
                    <thead>
                        <tr>
                            <th data-filterable data-col-key="code">Code</th>
                            <th data-filterable data-col-key="name">Bezeichnung</th>
                            <th data-filterable data-col-key="active">Aktiv</th>
                            <th data-col-key="actions" style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in activities)
                        {
                            <tr>
                                <td>@a.Code</td>
                                <td>@a.Name</td>
                                <td>
                                    @if (a.IsActive)
                                    {
                                        <span class="badge badge-active">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive">Inaktiv</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="EditActivity" asp-route-id="@a.Id" class="btn btn-sm btn-secondary">Bearbeiten</a>
                                </td>
                            </tr>
                        }
                        @if (!activities.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Keine Aktivitäten vorhanden.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (tab == "terminals")
    {
        <div class="tab-pane active">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="mb-0">Terminals</h5>
                <a asp-action="EditTerminal" class="btn btn-primary">Neu anlegen</a>
            </div>

            <div class="table-responsive">
                <table class="table table-striped mb-0 filterable-table" data-server-column-filter="true" data-view-key="BdeMasterDataTerminals">
                    <thead>
                        <tr>
                            <th data-filterable data-col-key="user">Benutzer</th>
                            <th data-filterable data-col-key="workplace">Default-Werkbank</th>
                            <th data-filterable data-col-key="description">Beschreibung</th>
                            <th data-col-key="actions" style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in terminals)
                        {
                            <tr>
                                <td>@(t.User?.Name ?? "-")</td>
                                <td>@(t.DefaultProductionWorkplace?.Name ?? "-")</td>
                                <td>@t.Description</td>
                                <td>
                                    <a asp-action="EditTerminal" asp-route-id="@t.Id" class="btn btn-sm btn-secondary">Bearbeiten</a>
                                </td>
                            </tr>
                        }
                        @if (!terminals.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Keine Terminals vorhanden.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (tab == "sage")
    {
        @* E6b/G14: Sage-PPS-Mitarbeiter -> BDE-Mitarbeiter. Vorschlag nur bei gleicher Personalnummer, Zuordnung immer per Knopf. *@
        var sageStand = ViewBag.SageStand as DateTime?;
        var bdeOhneSageNummer = ViewBag.BdeOhneSageNummer as int? ?? 0;
        var sageNichtZugeordnet = ViewBag.SageNichtZugeordnet as int? ?? 0;
        <div class="tab-pane active">
            <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-2">
                <h5 class="mb-0">Sage-Zuordnung</h5>
                @if (sageStand.HasValue)
                {
                    <span class="text-muted small">Sage-Stand: @sageStand.Value.ToString("dd.MM.yyyy HH:mm"), davon @sageNichtZugeordnet nicht zugeordnet</span>
                }
            </div>
            <p class="text-muted mb-3">
                Verknüpft Sage-PPS-Mitarbeiter mit BDE-Mitarbeitern. Vorgeschlagen wird nur ein BDE-Mitarbeiter mit gleicher Personalnummer –
                übernommen wird erst mit „Zuordnen“. Kartennummer und externe Nummer dienen nur zur Information.
            </p>

            @if (!sageStand.HasValue)
            {
                <div class="alert alert-info" role="status">
                    Es wurden noch keine Sage-Mitarbeiter gelesen. Der Abgleich läuft, sobald in den Diensteinstellungen
                    <code>Sync:PpsMitarbeiterEnabled</code> eingeschaltet ist und Sage PPS-Mitarbeiter liefert.
                </div>
            }
            @if (bdeOhneSageNummer > 0)
            {
                <div class="alert alert-warning" role="status">
                    @bdeOhneSageNummer aktive BDE-Mitarbeiter haben noch keine Sage-Mitarbeiternummer. Ohne Zuordnung kann ihre Arbeit nicht an Sage zurückgemeldet werden.
                </div>
            }

            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0 filterable-table" data-server-column-filter="true" data-view-key="BdeMasterDataSage">
                    <thead>
                        <tr>
                            <th data-filterable data-col-key="number">Sage-Nr.</th>
                            <th data-filterable data-col-key="name">Name (Sage)</th>
                            <th data-filterable data-col-key="matchcode">Matchcode</th>
                            <th data-filterable data-col-key="card">Kartennr.</th>
                            <th data-filterable data-col-key="external">Externe Nr.</th>
                            <th data-filterable data-col-key="active">Aktiv (Sage)</th>
                            <th data-filterable data-col-key="status">Status</th>
                            <th data-col-key="assigned" style="min-width: 220px;">BDE-Mitarbeiter</th>
                            <th data-col-key="actions" style="width: 110px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var zeileNr = 0; }
                        @foreach (var z in sageZeilen)
                        {
                            var formId = $"sage-zuordnung-{zeileNr++}";
                            <tr>
                                <td>@z.Sage.Nummer</td>
                                <td>@z.Name</td>
                                <td>@z.Sage.Matchcode</td>
                                <td>@(z.Sage.Kartennummer ?? "-")</td>
                                <td>@(z.Sage.ExterneNummer?.ToString() ?? "-")</td>
                                <td>@z.AktivText</td>
                                <td>
                                    @if (z.Zugeordnet == null)
                                    {
                                        <span class="badge bg-warning text-dark">Nicht zugeordnet</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-active">Zugeordnet</span>
                                    }
                                </td>
                                <td>
                                    @if (z.Zugeordnet != null)
                                    {
                                        @z.ZugeordnetText
                                    }
                                    else
                                    {
                                        <select name="operatorId" form="@formId" class="form-select form-select-sm" required
                                                aria-label="BDE-Mitarbeiter für Sage-Nr. @z.Sage.Nummer">
                                            <option value="">– auswählen –</option>
                                            @foreach (var o in freieOperatoren)
                                            {
                                                <option value="@o.Id" selected="@(z.Vorschlag?.Id == o.Id)">@o.PersonnelNumber @o.LastName @o.FirstName@(o.IsActive ? "" : " (inaktiv)")</option>
                                            }
                                        </select>
                                        @if (z.Vorschlag != null)
                                        {
                                            <div class="form-text">Vorschlag: gleiche Personalnummer</div>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (z.Zugeordnet != null)
                                    {
                                        <form asp-action="SageZuordnungLoesen" method="post" class="d-inline">
                                            <input type="hidden" name="operatorId" value="@z.Zugeordnet.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                    aria-label="Zuordnung von Sage-Nr. @z.Sage.Nummer lösen">Lösen</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form id="@formId" asp-action="SageZuordnen" method="post" class="d-inline">
                                            <input type="hidden" name="nummer" value="@z.Sage.Nummer" />
                                            <button type="submit" class="btn btn-sm btn-primary"
                                                    aria-label="Sage-Nr. @z.Sage.Nummer zuordnen">Zuordnen</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!sageZeilen.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">Keine Sage-Mitarbeiter vorhanden.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (ViewBag.Pagination is IdealAkeWms.Models.ViewModels.PaginationState paginationState)
    {
        <partial name="_Pagination" model="paginationState" />
    }
</div>

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
}
