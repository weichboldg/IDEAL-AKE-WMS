@model IdealAkeWms.Models.ViewModels.PurchaseOrderReceiveViewModel
@{
    ViewData["Title"] = "Wareneingang zu Bestellung";
}
@* v1.84.0 Spec 2026-11-08-wareneingang-aus-sage-bestellungen F3. Kleine, auf eine Bestellung vorgefilterte Liste ohne Pagination (ADR 0005:
   kein Spaltenfilter noetig). Teil/Ueber/vollstaendig als Text, nie nur Farbe; Mengen in der Basiseinheit (E0 B-2). *@

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="page-header mb-0">Wareneingang zu Bestellung</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Offene Bestellungen</a>
</div>

@* TempData-Meldungen zeigt _Layout (QA Q-2: sonst doppelt). *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning" role="alert">
        @foreach (var err in ViewData.ModelState[string.Empty]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
        {
            <div>@err.ErrorMessage</div>
        }
    </div>
}

<div class="card filter-card mb-3">
    <div class="card-body p-2">
        <form method="get" asp-action="Receive" class="d-flex gap-2 align-items-end flex-wrap">
            <div>
                <label for="belegnummer" class="form-label small mb-0">Bestellnummer (mit oder ohne Jahr) eingeben oder scannen</label>
                <input type="text" id="belegnummer" name="belegnummer" class="form-control" style="min-height:44px" placeholder="z. B. 168975 oder 2027-168975"
                       value="@(Model.BelId == null ? Model.Belegnummer : null)" autocomplete="off" data-hw-scan-ziel @(Model.BelId == null ? "autofocus" : "") />
            </div>
            <button type="submit" class="btn btn-primary" style="min-height:44px">Öffnen</button>
        </form>
    </div>
</div>

@if (Model.BelId != null)
{
    @if (Model.LieferantGesperrt)
    {
        <div class="alert alert-warning" role="status">
            <strong>&#9888; Lieferant gesperrt</strong> (Sperre am Lieferanten in Sage). Buchen ist trotzdem möglich – bitte mit dem Einkauf klären.
        </div>
    }
    <div class="card mb-3">
        <div class="card-body py-2">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-normal text-muted">Bestellung</dt>
                <dd class="col-sm-9 fw-semibold">@Model.Belegnummer
                    @if (Model.Rahmenabruf)
                    {
                        @* v1.99.15 (Teil 3, F3): Text-Badge, Farbe nie allein *@
                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1">Rahmenabruf</span>
                    }
                </dd>
                <dt class="col-sm-3 fw-normal text-muted">Lieferant</dt>
                <dd class="col-sm-9">@Model.LieferantText</dd>
                @* v1.99.33 (Teil B): Sage-Kopf, leer = „–“ (Feld bleibt sichtbar) *@
                <dt class="col-sm-3 fw-normal text-muted">AB-Nummer</dt>
                <dd class="col-sm-9">@(Model.AbNummer ?? "–")</dd>
                <dt class="col-sm-3 fw-normal text-muted">Kommission</dt>
                <dd class="col-sm-9">@(Model.Kommission ?? "–")</dd>
                <dt class="col-sm-3 fw-normal text-muted">Liefertermin</dt>
                <dd class="col-sm-9">@(Model.Liefertermin?.ToString("dd.MM.yyyy") ?? "ohne Termin")</dd>
            </dl>
            @if (Model.Rahmenabruf)
            {
                <p class="small mb-0 mt-1">Offen = Abrufmenge; in Sage direkt gebuchte Abruf-Lieferungen zieht das WMS nicht ab.</p>
                @if (Model.AbrufOhneSageWe)
                {
                    <p class="small mb-0">Rahmenabruf: Wareneingang geht als Lagerbuchung an Sage; der Einkauf schließt den Abruf in Sage von Hand.</p>
                }
            }
        </div>
    </div>

    <form method="post" asp-action="Receive" asp-route-belId="@Model.BelId">
        @Html.AntiForgeryToken()
        @* v1.99.23 (WE-1): Kennung dieses Absendens – ein zweites Absenden derselben Seite bucht nichts *@
        <input type="hidden" name="absendekennung" value="@Model.Absendekennung" />
        @* v1.99.4 (F6): eine Lieferung = ein Lieferschein; gilt fuer alle Positionen dieses Absendens. *@
        <div class="d-flex flex-wrap gap-3 mb-3">
        <div style="width: 22rem; max-width: 100%;">
            <label for="lieferschein" class="form-label mb-1">Lieferschein-Nr. (Lieferant)@(Model.LieferscheinPflicht ? " *" : "")</label>
            <input type="text" id="lieferschein" name="lieferschein" class="form-control" style="min-height:44px" maxlength="@IdealAkeWms.Models.ViewModels.PurchaseOrderReceiveViewModel.LieferscheinMaxLaenge"
                   value="@Model.Lieferschein" autocomplete="off" aria-describedby="lieferscheinHilfe" @(Model.LieferscheinPflicht ? "required" : "") />
            <div id="lieferscheinHilfe" class="form-text">@(Model.LieferscheinPflicht ? "Pflichtfeld, höchstens 20 Zeichen." : "Optional, höchstens 20 Zeichen.")</div>
        </div>
        @if (Model.BarcodeAktiv)
        {
            @* v1.99.11 (Wareneingang-CSV F1): Barcode des Lieferschein-Aufklebers, roh übernommen (Dateiname der CSV). Bei ausgeschaltetem
               Sage-Wareneingang gesperrt: ohne Übergabe an Sage entsteht nie eine CSV (Freigabe-Antwort 7). *@
            <div style="width: 22rem; max-width: 100%;">
                <label for="barcode" class="form-label mb-1">Barcode (Lieferschein)</label>
                <div class="input-group">
                    <input type="text" id="barcode" name="barcode" class="form-control" style="min-height:44px" maxlength="@IdealAkeWms.Services.WareneingangCsv.BarcodeMaxLaenge"
                           value="@Model.Barcode" autocomplete="off" aria-describedby="barcodeHilfe" @(Model.SageWeAktiv ? "" : "disabled") />
                    @if (Model.SageWeAktiv)
                    {
                        <button type="button" id="btnScanBarcode" data-hw-scan-kamera-ziel class="btn btn-outline-secondary" style="min-height:44px" title="Barcode mit der Kamera scannen" aria-label="Barcode mit der Kamera scannen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M1.5 1a.5.5 0 0 0-.5.5v3a.5.5 0 0 1-1 0v-3A1.5 1.5 0 0 1 1.5 0h3a.5.5 0 0 1 0 1zM11 .5a.5.5 0 0 1 .5-.5h3A1.5 1.5 0 0 1 16 1.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 1-.5-.5M.5 11a.5.5 0 0 1 .5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 1 0 1h-3A1.5 1.5 0 0 1 0 14.5v-3a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v3a1.5 1.5 0 0 1-1.5 1.5h-3a.5.5 0 0 1 0-1h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 1 .5-.5M3 4.5a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0z"/>
                            </svg>
                        </button>
                    }
                </div>
                <div id="barcodeHilfe" class="form-text">@(Model.SageWeAktiv
                    ? "Optional: Aufkleber scannen. Nur Buchstaben, Ziffern, - und _, höchstens 50 Zeichen. Nach der Übergabe an Sage entsteht daraus die CSV-Datei."
                    : Model.AbrufOhneSageWe ? IdealAkeWms.Services.SageWareneingang.AbrufOhneSageWeText
                    : "Sage-Wareneingang ist aus – für diese Buchung entsteht keine CSV-Datei.")</div>
            </div>
        }
        </div>
        @* v1.99.52 (Spec 2026-11-23 F2b): Toolbar-Host fuer das Zahnrad (Katalog ColumnDefinitions.PurchaseOrderReceive). Ausgeblendete
           Zellen bleiben im DOM und werden mitgesendet; der Server ordnet ueber BelPosId zu. F2: Streifen/Hover + Fokus-Zeile (site.css). *@
        <div class="d-flex justify-content-end mb-1" data-table-toolbar></div>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover align-middle" data-view-key="PurchaseOrderReceive">
                <thead>
                    <tr>
                        <th data-col-key="pos">Pos.</th>
                        <th data-col-key="artikel">Artikel</th>
                        <th data-col-key="bestellt" class="text-end">bestellt</th>
                        <th data-col-key="offen" class="text-end">offen (Sage)</th>
                        <th data-col-key="erfasst" class="text-end">im WMS erfasst</th>
                        <th data-col-key="rest" class="text-end">Rest</th>
                        <th data-col-key="einheit">Einheit</th>
                        <th data-col-key="lagerplatz">Ziel-Lagerplatz</th>
                        <th data-col-key="menge" style="min-width: 8rem;">Ist-Menge</th>
                        <th data-col-key="ueberlieferung" class="text-center">Überlieferung</th>
                        <th data-col-key="memo" style="min-width: 12rem;">Positionsmemo</th>
                        <th data-col-key="status">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Zeilen.Count; i++)
                    {
                        var z = Model.Zeilen[i];
                        var l = z.Row.Line;
                        var gesperrt = z.NichtBuchbar != null;
                        <tr class="@(z.Fehler != null ? "table-danger" : "")" data-rest="@z.Rest.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <td>@(i + 1)<input type="hidden" name="zeilen[@i].BelPosId" value="@l.BelPosId" /></td>
                            <td>
                                <div class="fw-semibold">@l.Artikelnummer</div>
                                <div class="small">@l.Bezeichnung1</div>
                                @if (l.Chargenpflicht || l.Nachweispflicht)
                                {
                                    <div class="small text-body-secondary">@(Model.SageWeAktiv ? "Charge/Seriennummer: Wareneingang in Sage buchen" : "Charge/Seriennummer in Sage erfassen")</div>
                                }
                                @if (z.Row.SageWeText != null)
                                {
                                    <div class="small text-body-secondary">@z.Row.SageWeText</div>
                                }
                                @if (z.OffeneLagerbestellungen.Count > 0 || z.OffeneBedarfsmeldungen.Count > 0)
                                {
                                    @* v1.99.22 (Freigabe-Nachtrag 3): nur Hinweis mit Link, kein Erfüllen/Schließen beim Buchen. Text trägt die Bedeutung, Rand nur zusätzlich. *@
                                    <div class="small mt-1 ps-2 border-start border-3 border-warning" role="note">
                                        <div class="fw-semibold">Offener Bedarf zu diesem Artikel:</div>
                                        @foreach (var g in z.OffeneLagerbestellungen.GroupBy(b => b.Id))
                                        {
                                            var b = g.First();
                                            <div>Lagerbestellung <a asp-controller="WarehousePicking" asp-action="Details" asp-route-id="@g.Key">Nr. @g.Key</a>
                                                – @b.Bezug, @b.Besteller: @g.Sum(x => x.Menge).ToString("0.###") @b.Unit</div>
                                        }
                                        @foreach (var b in z.OffeneBedarfsmeldungen)
                                        {
                                            <div>Bedarfsmeldung <a asp-controller="PartRequisitions" asp-action="Index" asp-route-searchTerm="@b.ArticleNumber.Trim()">FA @b.Bezug</a>
                                                – @b.Besteller: @b.Menge.ToString("0.###") @b.Unit</div>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="text-end">@l.MengeBestellt.ToString("0.###")</td>
                            <td class="text-end">@l.MengeOffen.ToString("0.###")</td>
                            <td class="text-end">@z.Row.ImWmsErfasst.ToString("0.###")</td>
                            <td class="text-end fw-semibold">@z.Rest.ToString("0.###")</td>
                            <td>@l.MengeBasiseinheit</td>
                            <td>
                                @if (gesperrt)
                                {
                                    <span>@z.Row.ZielLagerplatz</span>
                                }
                                else
                                {
                                    <select name="zeilen[@i].StorageLocationId" class="form-select" style="min-height:44px" aria-label="Ziel-Lagerplatz Position @(i + 1)">
                                        <option value="">— wählen —</option>
                                        @foreach (var p in Model.Lagerplaetze)
                                        {
                                            <option value="@p.Id" selected="@(z.Eingabe.StorageLocationId == p.Id)">@p.Code</option>
                                        }
                                    </select>
                                    @if (z.Row.ZielNichtImWms)
                                    {
                                        <div class="small text-body-secondary">Sage-Platz @l.SagePlatzKurzbezeichnung nicht im WMS</div>
                                    }
                                    else if (l.StorageLocationId is { } zielId && !Model.Lagerplaetze.Any(p => p.Id == zielId))
                                    {
                                        @* v1.86.0 (Nachbesserung): Sage-Platz ist einem nicht buchbaren/inaktiven WMS-Platz zugeordnet – melden statt still leer. *@
                                        <div class="small text-body-secondary">Sage-Platz @z.Row.ZielLagerplatz ist im WMS nicht buchbar – bitte Ziel wählen</div>
                                    }
                                    @* v1.99.52 (F3): Herkunft des Vorschlags bzw. warum keiner moeglich war – Text, nie nur Farbe *@
                                    @if (z.ZielVorschlagHauptlagerplatz)
                                    {
                                        <div class="small text-body-secondary">Vorschlag: Hauptlagerplatz des Artikels</div>
                                    }
                                    @if (z.ZielHinweis != null)
                                    {
                                        <div class="small text-body-secondary">@z.ZielHinweis</div>
                                    }
                                }
                            </td>
                            <td>
                                @if (gesperrt)
                                {
                                    <span class="small">nicht buchbar</span>
                                }
                                else
                                {
                                    <input type="text" inputmode="decimal" name="zeilen[@i].Menge" value="@z.Eingabe.Menge" autocomplete="off"
                                           class="form-control ist-menge" aria-label="Ist-Menge Position @(i + 1)" style="min-height:44px" />
                                }
                            </td>
                            <td class="text-center">
                                @if (!gesperrt)
                                {
                                    @* v1.99.22: eigene Spalte, damit Ist-Menge, Platz und Memo auf einer Linie stehen; die ganze 44-px-Fläche ist das Label. *@
                                    <label class="d-inline-flex align-items-center justify-content-center m-0" style="min-width:44px;min-height:44px;cursor:pointer" for="ueber_@i">
                                        <input type="checkbox" class="form-check-input m-0" style="width:1.5rem;height:1.5rem" id="ueber_@i" name="zeilen[@i].UeberlieferungBestaetigt" value="true"
                                               @(z.Eingabe.UeberlieferungBestaetigt ? "checked" : "") />
                                        <span class="visually-hidden">Überlieferung bestätigt, Position @(i + 1)</span>
                                    </label>
                                }
                            </td>
                            <td>
                                @if (!gesperrt)
                                {
                                    <input type="text" name="zeilen[@i].Memo" value="@z.Eingabe.Memo" autocomplete="off" class="form-control" style="min-height:44px"
                                           maxlength="@IdealAkeWms.Models.ViewModels.PurchaseOrderReceiveViewModel.MemoMaxLaenge" aria-label="Positionsmemo Position @(i + 1)" />
                                }
                            </td>
                            <td>
                                @if (gesperrt)
                                {
                                    <span class="badge text-bg-secondary text-wrap text-start">@z.NichtBuchbar</span>
                                }
                                else
                                {
                                    <span class="lieferart small" aria-live="polite">—</span>
                                }
                                @if (z.Fehler != null)
                                {
                                    <div class="small text-danger-emphasis fw-semibold">@z.Fehler</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small text-body-secondary">Leere Ist-Menge = Position nicht buchen. Gebucht wird nur, wenn alle eingegebenen Zeilen gültig sind. Häkchen „Überlieferung“ = Ist-Menge über dem Rest ist bestätigt.</p>
        @if (Model.SageWeAktiv)
        {
            <p class="small text-body-secondary">Sage-Wareneingang ist an: Die gebuchten Positionen gehen als ein Sage-Wareneingangsbeleg an Sage (Ziel nur Sage-Plätze mit Sage-Buchung). Stand unter „Sage-Buchungen“.</p>
        }
        <button type="submit" class="btn btn-primary mb-4" style="min-height:44px">Einbuchen</button>
    </form>

    <script type="application/json" id="view-config">
    { "viewKey": "PurchaseOrderReceive", "supportsReorder": true, "supportsSortDefault": false }
    </script>
    <script type="application/json" id="column-config">
    [
        { "key": "pos", "label": "Pos.", "locked": true, "defaultWidth": null },
        { "key": "artikel", "label": "Artikel", "locked": true, "defaultWidth": null },
        { "key": "bestellt", "label": "bestellt", "locked": false, "defaultWidth": null },
        { "key": "offen", "label": "offen (Sage)", "locked": false, "defaultWidth": null },
        { "key": "erfasst", "label": "im WMS erfasst", "locked": false, "defaultWidth": null },
        { "key": "rest", "label": "Rest", "locked": true, "defaultWidth": null },
        { "key": "einheit", "label": "Einheit", "locked": true, "defaultWidth": null },
        { "key": "lagerplatz", "label": "Ziel-Lagerplatz", "locked": true, "defaultWidth": null },
        { "key": "menge", "label": "Ist-Menge", "locked": true, "defaultWidth": null },
        { "key": "ueberlieferung", "label": "Überlieferung", "locked": true, "defaultWidth": null },
        { "key": "memo", "label": "Positionsmemo", "locked": false, "defaultWidth": null },
        { "key": "status", "label": "Status", "locked": true, "defaultWidth": null }
    ]
    </script>
}

@section Scripts {
    @if (Model.BelId != null)
    {
        <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    }
    @if (Model.BelId != null && Model.BarcodeAktiv && Model.SageWeAktiv)
    {
        @* v1.99.11: Kamera/Hardware-Scanner ins Barcode-Feld, roh ('raw': keine Artikel-QR-, EAN- oder Matchcode-Auswertung). *@
        <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
        <script src="~/js/barcode-scanner.js" asp-append-version="true"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () { initTextInputScanner('btnScanBarcode', 'barcode', 'raw'); });
        </script>
    }
    <script>
        // Anzeige „vollständig / Teillieferung / Überlieferung“ als Text (Server prüft beim Buchen erneut).
        document.querySelectorAll('tr[data-rest]').forEach(function (tr) {
            var input = tr.querySelector('.ist-menge'), out = tr.querySelector('.lieferart');
            if (!input || !out) return;
            var rest = parseFloat(tr.getAttribute('data-rest'));
            var zeigen = function () {
                var v = parseFloat(String(input.value).replace(',', '.'));
                out.textContent = isNaN(v) || input.value === '' ? '—' : v <= 0 ? 'ungültig' : v === rest ? 'vollständig' : v < rest ? 'Teillieferung' : 'Überlieferung';
                out.className = 'lieferart small fw-semibold ' + (v > rest ? 'text-danger-emphasis' : '')  /* QA Q-8: 4,5:1 auch in table-danger */;
            };
            input.addEventListener('input', zeigen);
            zeigen();
        });
    </script>
}
