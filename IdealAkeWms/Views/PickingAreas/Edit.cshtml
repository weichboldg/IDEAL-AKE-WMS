@model IdealAkeWms.Models.ViewModels.PickingAreaEingabe
@{
    ViewData["Title"] = "Kommissionierbereich bearbeiten";
}

<h2 class="page-header">Kommissionierbereich bearbeiten</h2>

<div class="card" style="max-width: 640px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label class="form-label fw-bold" for="Name">Name</label>
                <input type="text" id="Name" name="Name" value="@Model.Name" class="form-control" maxlength="100" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" for="Kuerzel">Kürzel</label>
                <input type="text" id="Kuerzel" name="Kuerzel" value="@Model.Kuerzel" class="form-control" maxlength="10" required />
                <div class="form-text">Kurzzeichen in Listen und auf dem Druck, eindeutig.</div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" for="Reihenfolge">Reihenfolge</label>
                <input type="number" id="Reihenfolge" name="Reihenfolge" value="@Model.Reihenfolge" class="form-control" min="0" />
                <div class="form-text">Sortierung in Listen und Auswahlfeldern (kleiner = weiter oben).</div>
            </div>
            <div class="form-check mb-2">
                <input type="checkbox" id="IsActive" name="IsActive" value="true" class="form-check-input" @(Model.IsActive ? "checked" : "") />
                <input type="hidden" name="IsActive" value="false" />
                <label class="form-check-label" for="IsActive">Aktiv</label>
                <div class="form-text">Inaktiv: Regeln auf diesen Bereich greifen nicht mehr, die Zeilen landen im Standardbereich (die Erzeugung meldet das).</div>
            </div>
            <div class="form-check mb-2">
                <input type="checkbox" id="IsDefault" name="IsDefault" value="true" class="form-check-input" @(Model.IsDefault ? "checked" : "") />
                <input type="hidden" name="IsDefault" value="false" />
                <label class="form-check-label" for="IsDefault">Standardbereich</label>
                <div class="form-text">Zeilen ohne passende Regel. Es gibt genau einen; wird dieser Bereich Standard, löst er den bisherigen ab.</div>
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" id="IstVorkommissionierung" name="IstVorkommissionierung" value="true" class="form-check-input" @(Model.IstVorkommissionierung ? "checked" : "") />
                <input type="hidden" name="IstVorkommissionierung" value="false" />
                <label class="form-check-label" for="IstVorkommissionierung">Vorkommissionierung</label>
                <div class="form-text">Aufträge dieses Bereichs werden mit dem Vorkommissionier-Vorlauf fällig.</div>
            </div>
            <button type="submit" class="btn btn-primary">Speichern</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Zurück</a>
        </form>
    </div>
</div>
