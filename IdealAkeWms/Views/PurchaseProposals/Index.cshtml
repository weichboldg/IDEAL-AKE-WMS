@model IdealAkeWms.Models.ViewModels.PurchaseProposalListViewModel
@using IdealAkeWms.Services
@using IdealAkeWms.Models.ViewModels
@{
    ViewData["Title"] = "Bestellvorschläge";
    // v1.99.30 F11: Ruecksprung aus der Artikelinfo auf genau diese Liste (Filterkarte, Spaltenfilter, Seite, Seitengroesse stehen in der Query).
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
@* v1.99.20 Spec 2026-11-08-einkauf-bestellvorschlaege F8: Arbeitsliste des Einkaufs, nur lesend. Gerechnet wird im PurchaseProposalCalculator.
   Listen-View-Pattern (ADR 0005): Filterkarte, Server-Spaltenfilter nach der Berechnung, Pagination, CSV ueber csv-export.js.
   Dringlichkeit als Text-Badge, Farbe nur zusaetzlich (WCAG AA). Banner melden fehlende Daten statt still. *@

<h2 class="page-header mb-1">Bestellvorschläge</h2>
<p class="text-body-secondary small mb-3">
    Artikel mit Sage-Meldebestand. Verfügbar = Bestand WMS + offen bestellt − angerechnete Bedarfe (FA-Bedarf, @Model.BedarfeText); Vorschlag, wenn verfügbar ≤ Meldebestand. „kritisch“, wenn Bestand plus offene Bestellungen mit Liefertermin bis heute + WBZ die Bedarfe bis dahin nicht decken (Bestellungen ohne Liefertermin zählen dafür nicht).
    Mengen in der Lagereinheit des Artikels.
</p>

@if (Model.ArtikelGesamt == 0)
{
    <div class="alert alert-info" role="status">
        <strong>Kein Artikel mit Meldebestand.</strong> Der Meldebestand kommt aus Sage über den Artikel-Abgleich; ohne ihn bleibt die Liste leer.
    </div>
}
@if (Model.OhneSageDetail > 0)
{
    <div class="alert alert-warning py-2 small" role="status">
        @Model.OhneSageDetail von @Model.ArtikelGesamt Artikeln ohne Sage-Zusatzfelder (Spalten „Sage verfügbar“, „Sage-Bestellmenge“, ABC u. a. zeigen „–“).
        Gefüllt nur mit Artikel-Abgleich über SData (Service-Einstellung <code>Sync:Quelle:Artikel = SData</code>).
    </div>
}
@if (Model.OhneArtikelLieferant > 0)
{
    <div class="alert alert-warning py-2 small" role="status">
        @Model.OhneArtikelLieferant von @Model.ArtikelGesamt Artikeln ohne Hauptlieferant im WMS (Hinweis je Zeile). Gefüllt vom Abgleich
        Artikel-Lieferanten (<code>Sync:ArtikelLieferantEnabled</code>) und Kreditoren (<code>Sync:KreditorenEnabled</code>).
    </div>
}
@if (Model.BestellungenStand == null)
{
    <div class="alert alert-warning py-2 small" role="status">
        <strong>Offene Bestellungen aus Sage nicht gelesen</strong> (Dienst-Abgleich <code>Sync:EinkaufBestellungenEnabled</code>). Spalte „offen bestellt“ zeigt „–“;
        gerechnet wird ohne offene Bestellungen (Hinweis je Zeile).
    </div>
}
else
{
    <p class="text-body-secondary small mb-2">Offene Bestellungen (Bestellungen und Rahmenabrufe): Stand @Model.BestellungenStand.Value.ToString("dd.MM.yyyy HH:mm"); offen = Rest nach im WMS erfassten Wareneingängen.</p>
}
@if (Model.PositionenEinheitAbweichend > 0)
{
    <div class="alert alert-warning py-2 small" role="status">
        @Model.PositionenEinheitAbweichend offene @(Model.PositionenEinheitAbweichend == 1 ? "Bestellposition" : "Bestellpositionen") mit nicht umrechenbarer Einheit (Basiseinheit ≠ Lagereinheit) – nicht eingerechnet (Liste „Offene Bestellungen“, Hinweis „Einheit abweichend“). Positionen, bei denen nur die Bestelleinheit abweicht, sind eingerechnet.
    </div>
}
@if (Model.BedarfeEinheitAbweichend > 0)
{
    <div class="alert alert-warning py-2 small" role="status">
        @Model.BedarfeEinheitAbweichend offene @(Model.BedarfeEinheitAbweichend == 1 ? "Bedarfszeile" : "Bedarfszeilen") mit anderer Einheit als der Artikel – nicht eingerechnet.
    </div>
}
@if (!Model.LetzteBestellungenGelesen)
{
    <div class="alert alert-warning py-2 small" role="status">
        <strong>Letzte Bestellmengen noch nicht gelesen</strong> (Dienst-Lauf „Letzte Bestellung (Einkauf)“, eingeschaltet mit <code>Sync:ArtikelLieferantEnabled</code>, nachts und mittags).
        Bis dahin: Vorschlag = Fehlmenge bis zum Meldebestand, bei Fehlmenge 0 der Meldebestand – Grund „@PurchaseProposalCalculator.GrundOhneLetzteBestellung“.
    </div>
}
@if (Model.FallbackZeilen > 0)
{
    <div class="alert alert-info py-2 small" role="status">
        <strong>@Model.FallbackZeilen @(Model.FallbackZeilen == 1 ? "Zeile" : "Zeilen") mit Fallback Sage-Bestellmenge</strong> – keine Bestellung in den letzten
        @ArticleSupplier.LetzteBestellungRueckblickJahre Jahren, auch nicht bei einem anderen Lieferanten. Spalte „Hinweis“ nach „Sage-Bestellmenge“ filtern, um sie zu sehen; „Keine Bestellung“ zeigt zusätzlich die Zeilen ohne Sage-Bestellmenge.
    </div>
}
@if (Model.OhneMengenquelle > 0)
{
    <div class="alert alert-warning py-2 small" role="status">
        @Model.OhneMengenquelle @(Model.OhneMengenquelle == 1 ? "Zeile" : "Zeilen") ohne letzte Bestellung und ohne Sage-Bestellmenge (oder mit Einheit Basis ≠ Lager) – Menge prüfen (Grund „@PurchaseProposalCalculator.GrundOhneLetzteBestellung“).
    </div>
}
<div class="alert alert-info py-2 small" role="note" id="hinweis-fa-bedarfe">
    <strong>Bedarfe ohne Doppelzählung</strong> (dieselbe Regel wie der „Verfügbare Bestand“ der Artikelinfo): je Fertigungsauftrag zählt der größere Wert aus
    FA-Bedarf (Stückliste minus schon ausgebucht) und offenen Bedarfsmeldungen zu diesem Auftrag; je Artikel der größere Wert aus dieser Summe und den
    offenen Lagerbestellungen (sie tragen keinen Auftrag, daher ggf. unterschätzt).
    @if (Model.FaBedarfeHierarchisch)
    {
        <text>FA-Bedarfe aus der FA-Struktur (Sollmenge je Sub-FA).</text>
    }
    else if (Model.BomCacheBis is { } bis)
    {
        <text>FA-Bedarfe nur aus dem Stücklisten-Cache (FAs bis @bis.ToString("dd.MM.yyyy"), höchstens <code>Sync:BomCacheMaxOrders</code> Aufträge) – spätere Aufträge fehlen.</text>
    }
    FA-Bedarfe in Lagereinheit angenommen (die Stückliste trägt keine Einheit). @Model.MitFaBedarf Artikel mit FA-Bedarf.
</div>
<div class="alert alert-light border py-2 small" role="note">
    Vorschlag = letzte Bestellmenge beim Hauptlieferanten (jüngste Bestellung oder jüngster Rahmenabruf der letzten @ArticleSupplier.LetzteBestellungRueckblickJahre Jahre), sonst die jüngste bei einem anderen Lieferanten;
    reicht sie nicht bis über den Meldebestand, Meldebestand − verfügbar + 1 Lagereinheit (kein Vielfaches). Ohne Bestellung in diesem Zeitraum: Sage-Bestellmenge (Fallback, gleiche Regel), sonst Meldebestand − verfügbar + 1.
    Danach Aufrunden auf die Mindestbestellmenge des Hauptlieferanten, nur bei gleicher Einheit und Umrechnungsfaktor 1 (sonst Hinweis, keine Rundung).
</div>

<div class="card filter-card mb-3">
    <div class="card-body p-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label for="lieferant" class="form-label small mb-0">Lieferant</label>
                <select id="lieferant" name="lieferant" class="form-select form-select-sm">
                    <option value="">— Alle —</option>
                    @foreach (var l in Model.Lieferanten)
                    {
                        <option value="@l.Kto" selected="@(string.Equals(l.Kto, Model.Lieferant, StringComparison.OrdinalIgnoreCase))">@l.Text</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="artikelgruppe" class="form-label small mb-0">Artikelgruppe</label>
                <select id="artikelgruppe" name="artikelgruppe" class="form-select form-select-sm">
                    <option value="">— Alle —</option>
                    @foreach (var g in Model.Artikelgruppen)
                    {
                        <option value="@g" selected="@(string.Equals(g, Model.Artikelgruppe, StringComparison.OrdinalIgnoreCase))">@g</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label for="umfang" class="form-label small mb-0">Umfang</label>
                <select id="umfang" name="umfang" class="form-select form-select-sm">
                    <option value="@PurchaseProposalListViewModel.UmfangVorschlaege" selected="@(Model.Umfang == PurchaseProposalListViewModel.UmfangVorschlaege)">nur Vorschläge</option>
                    <option value="@PurchaseProposalListViewModel.UmfangAlle" selected="@(Model.Umfang == PurchaseProposalListViewModel.UmfangAlle)">alle Artikel mit Meldebestand</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="dringlichkeit" class="form-label small mb-0">Dringlichkeit</label>
                <select id="dringlichkeit" name="dringlichkeit" class="form-select form-select-sm">
                    <option value="">alle</option>
                    <option value="kritisch" selected="@(Model.Dringlichkeit == "kritisch")">kritisch (reicht nicht bis heute + WBZ)</option>
                    <option value="nachbestellen" selected="@(Model.Dringlichkeit == "nachbestellen")">nachbestellen (≤ Meldebestand)</option>
                </select>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Filtern</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Zurücksetzen</a>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-end mb-1" data-table-toolbar></div>
<div class="table-responsive">
    <table class="table table-sm table-striped filterable-table" data-server-column-filter="true" data-view-key="PurchaseProposals">
        <thead>
            <tr>
                <th data-filterable data-col-key="lieferant">Lieferant</th>
                <th data-filterable data-col-key="artikel">Artikel</th>
                <th data-filterable data-col-key="matchcode">Matchcode</th>
                <th data-filterable data-col-key="bezeichnung">Bezeichnung</th>
                <th data-filterable data-col-key="dringlichkeit">Dringlichkeit</th>
                <th data-filterable data-filter-type="number" data-col-key="bestand" class="text-end">Bestand WMS</th>
                <th data-filterable data-filter-type="number" data-col-key="sage-verfuegbar" class="text-end">Sage verfügbar</th>
                <th data-filterable data-filter-type="number" data-col-key="offen-bestellt" class="text-end">offen bestellt</th>
                <th data-filterable data-date-filter data-col-key="liefertermin">nächster Liefertermin</th>
                <th data-filterable data-date-filter data-col-key="naechster-bedarf" title="Frühester Termin eines angerechneten Bedarfs: Fertigungstermin des Auftrags; Lagerbestellung und Auftrag ohne Termin = heute">nächster Bedarf</th>
                <th data-filterable data-filter-type="number" data-col-key="fa-bedarf" class="text-end" title="Rest offener Fertigungsaufträge: Stücklistenmenge minus schon ausgebucht">FA-Bedarf</th>
                <th data-filterable data-filter-type="number" data-col-key="bedarfe" class="text-end" title="Offene Lagerbestellungen und Bedarfsmeldungen; angerechnet ohne Doppelzählung mit dem FA-Bedarf">offene Bedarfe</th>
                <th data-filterable data-filter-type="number" data-col-key="verfuegbar" class="text-end">verfügbar</th>
                <th data-filterable data-filter-type="number" data-col-key="meldebestand" class="text-end">Meldebestand</th>
                <th data-filterable data-filter-type="number" data-col-key="letzte-bestellmenge" class="text-end">letzte Bestellmenge</th>
                <th data-filterable data-date-filter data-col-key="letzte-bestellung-am">letzte Bestellung am</th>
                <th data-filterable data-filter-type="number" data-col-key="vorschlag" class="text-end">Vorschlag</th>
                <th data-filterable data-col-key="grund">Grund</th>
                <th data-filterable data-col-key="einheit">Einheit</th>
                <th data-filterable data-col-key="mindestbestellmenge" class="text-end">Mindestbestellmenge</th>
                <th data-filterable data-filter-type="number" data-col-key="sage-bestellmenge" class="text-end">Sage-Bestellmenge</th>
                <th data-filterable data-col-key="bestellnummer">Bestellnr. Lieferant</th>
                <th data-filterable data-filter-type="number" data-col-key="wbz" class="text-end">WBZ (Tage)</th>
                <th data-filterable data-date-filter data-col-key="wunschtermin">Wunschtermin</th>
                <th data-filterable data-col-key="letzter-lieferant">letzter Lieferant</th>
                <th data-filterable data-col-key="abc">ABC</th>
                <th data-filterable data-filter-type="number" data-col-key="user-mindestbestand" class="text-end">USER_Mindestbestand</th>
                <th data-filterable data-col-key="hinweis">Hinweis</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Items)
            {
                var e = r.Ergebnis;
                var badge = e.Dringlichkeit switch
                {
                    PurchaseProposalDringlichkeit.Kritisch => "text-bg-danger",
                    PurchaseProposalDringlichkeit.Nachbestellen => "text-bg-warning",
                    _ => "text-bg-light border",
                };
                <tr>
                    <td>@(r.LieferantText ?? "–")</td>
                    <td>
                        @if (Model.ArtikelinfoLink)
                        {
                            <a asp-controller="Articles" asp-action="Info" asp-route-articleNumber="@r.Article.ArticleNumber" asp-route-returnUrl="@returnUrl">@r.Article.ArticleNumber</a>
                        }
                        else
                        {
                            <span title="Artikelinfo braucht die Rolle Stammdaten lesen">@r.Article.ArticleNumber</span>
                        }
                    </td>
                    <td>@r.Article.Matchcode</td>
                    <td>@r.Article.Description</td>
                    <td><span class="badge @badge">@PurchaseProposalCalculator.Text(e.Dringlichkeit)</span></td>
                    <td class="text-end">@r.BestandWms.ToString("0.###")</td>
                    <td class="text-end" title="@(r.SageStand is { } st ? "Stand Artikel-Abgleich " + st.ToString("dd.MM.yyyy HH:mm") : "Sage-Zusatzfelder fehlen")">@(r.Sage?.LagerbestandVerfuegbar?.ToString("0.###") ?? "–")</td>
                    <td class="text-end">@(r.OffenBestellt?.ToString("0.###") ?? "–")</td>
                    <td>@(r.NaechsterLiefertermin?.ToString("dd.MM.yyyy"))</td>
                    <td>@(r.NaechsterBedarf?.ToString("dd.MM.yyyy"))</td>
                    <td class="text-end">@r.FaBedarf.ToString("0.###")</td>
                    <td class="text-end">@r.OffeneBedarfe.ToString("0.###")</td>
                    <td class="text-end fw-semibold">@e.Verfuegbar.ToString("0.###")</td>
                    <td class="text-end">@(r.Article.ReorderLevel?.ToString("0.###"))</td>
                    <td class="text-end">@(r.LetzteBestellung?.LetzteBestellmenge?.ToString("0.###"))</td>
                    <td>
                        @if (r.LetzteBestellung?.LetzteBestellungAm is { } am)
                        {
                            @am.ToString("dd.MM.yyyy")
                            <div class="small text-body-secondary">@r.LetzteBestellung.LetzteBestellungBeleg</div>
                        }
                    </td>
                    <td class="text-end fw-semibold">@(e.Vorschlag?.ToString("0.###"))</td>
                    <td>@if (e.Fallback) {<text><span class="badge text-bg-info me-1">Fallback</span> </text>}@e.Grund</td>
                    <td>@r.Article.Unit</td>
                    <td class="text-end">@IdealAkeWms.Controllers.PurchaseProposalsController.MindestText(r.Lieferant)</td>
                    <td class="text-end">@(r.Sage?.Bestellmenge?.ToString("0.###") ?? "–")</td>
                    <td>@r.Lieferant?.SageBestellnummer</td>
                    <td class="text-end">@r.Wbz</td>
                    <td>@(r.Wunschtermin?.ToString("dd.MM.yyyy"))</td>
                    <td>@r.Sage?.LetzterLieferant</td>
                    <td>@r.Sage?.ABCKlasse</td>
                    <td class="text-end">@(r.Sage?.UserMindestbestand?.ToString("0.###"))</td>
                    <td>@r.Hinweis</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Items.Count == 0 && Model.ArtikelGesamt > 0)
{
    <div class="alert alert-light border">Kein Artikel im gewählten Filter.@(Model.Umfang == PurchaseProposalListViewModel.UmfangVorschlaege ? " Für alle Artikel mit Meldebestand den Umfang „alle Artikel mit Meldebestand“ wählen." : "")</div>
}

<partial name="_Pagination" model="Model.Pagination" />

