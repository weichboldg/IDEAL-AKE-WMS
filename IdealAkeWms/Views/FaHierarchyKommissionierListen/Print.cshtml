@model IdealAkeWms.Models.ViewModels.FaHierarchyKommissionierPrintViewModel
@using System.Globalization
@{
    Layout = null;
    var deCulture = CultureInfo.GetCultureInfo("de-DE");
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <title>Kommissionierliste (IDEAL)</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; color: #000; background: #fff; padding: 20px; font-size: 11px; }
        .screen-controls { padding: 15px; text-align: center; background: #053153; color: #fff; margin: -20px -20px 20px -20px; }
        .screen-controls button { background: #fff; color: #053153; border: none; padding: 8px 24px; font-size: 16px; cursor: pointer; border-radius: 4px; margin: 0 5px; }
        .filter-banner { border: 1px solid #b8860b; background: #fff8e1; color: #7a5900; padding: 8px 10px; margin-bottom: 8px; font-size: 10px; }
        .fa-group { page-break-after: always; }
        .fa-group:last-child { page-break-after: auto; }
        .group-head { border-bottom: 2px solid #053153; padding-bottom: 8px; margin-bottom: 10px; }
        .group-head h1 { font-size: 18px; color: #053153; }
        .barcode img { height: 22mm; max-width: 100%; }
        .head-table { width: 100%; border-collapse: collapse; margin-top: 6px; }
        .head-table th, .head-table td { border: 1px solid #aaa; padding: 3px 5px; text-align: left; font-size: 10px; }
        .head-table th { background: #eef2f6; }
        table.positions { width: 100%; border-collapse: collapse; margin-top: 10px; }
        table.positions th, table.positions td { border: 1px solid #888; padding: 4px 6px; text-align: left; }
        table.positions th { background: #f0f0f0; }
        .text-end { text-align: right; }
        .note { color: #555; font-size: 10px; margin-top: 4px; }
        @@media print { .screen-controls { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    <div class="screen-controls">
        <button onclick="window.print()">Drucken</button>
        <button onclick="window.close()">Schliessen</button>
    </div>

    @if (!Model.Groups.Any())
    {
        <p style="padding: 20px; text-align: center; color: #555;">
            Keine Kommissionier-Positionen für die aktuelle Filterung — nichts zu drucken.
        </p>
    }
    else
    {
        @foreach (var group in Model.Groups)
        {
            <div class="fa-group">
                @if (Model.IsFiltered)
                {
                    <div class="filter-banner">
                        <strong>Gefilterte Ansicht</strong> — dieses Dokument zeigt nur die gefilterten
                        Positionen dieses HauptFA, nicht die vollständige Kommissionierliste.
                        @if (!string.IsNullOrEmpty(Model.SelectedTarget)) { <text>Kommissionier-Ziel: @Model.SelectedTarget.</text> }
                    </div>
                }
                <div class="group-head">
                    <h1>Kommissionierliste — HauptFA @group.HauptFA</h1>
                    <div class="barcode">
                        @if (Model.Barcodes.TryGetValue(group.HauptFA, out var bc))
                        {
                            <img src="data:image/png;base64,@bc" alt="@group.HauptFA" />
                        }
                    </div>
                    @if (group.IsAmbiguous)
                    {
                        <div class="note">
                            Hinweis: Dieser HauptFA umfasst mehrere Montage-Abteilungen (Kombigerät).
                            Es wird bewusst <strong>ein</strong> Ausdruck je HauptFA-Gruppe erzeugt; der
                            Barcode (= HauptFA) ist für beide identisch — Unterscheidung nur über die
                            Montage-Abteilung im Kopf.
                        </div>
                    }
                    @if (group.OrderInfos.Any())
                    {
                        <table class="head-table">
                            <thead>
                                <tr>
                                    <th>Montage-Abt.</th>
                                    <th>Kunde</th>
                                    <th>AB-Nr.</th>
                                    <th>KO-Termin</th>
                                    <th>FE-Termin</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var info in group.OrderInfos)
                                {
                                    <tr>
                                        <td>@info.MontageAbteilung</td>
                                        <td>@info.Kunde</td>
                                        <td>@info.ABNr</td>
                                        <td>@(info.KO_Termin?.ToString("dd.MM.yyyy") ?? "—")</td>
                                        <td>@(info.FE_Termin?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                <table class="positions">
                    <thead>
                        <tr>
                            <th>Haupt-Artnr.</th>
                            <th>Artnr.</th>
                            <th>Matchcode</th>
                            <th class="text-end">Sollmenge</th>
                            <th>Hauptlagerplatz</th>
                            <th>Kommissionieren</th>
                            <th>Arbeitsbereich</th>
                            <th>Artikeltyp</th>
                            <th>Beschichtet</th>
                            <th>Material</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pos in group.Positions)
                        {
                            <tr>
                                <td>@pos.HauptArtnr</td>
                                <td>@pos.Artnr</td>
                                <td>@pos.Matchcode</td>
                                <td class="text-end">@pos.Sollmenge.ToString("N3", deCulture)</td>
                                <td>@pos.Hauptlagerplatz</td>
                                <td>@pos.Kommissionieren</td>
                                <td>@pos.Arbeitsbereich</td>
                                <td>@pos.Artikeltyp</td>
                                <td>@(pos.Beschichtet ? "Ja" : "Nein")</td>
                                <td>@pos.Material</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</body>
</html>
