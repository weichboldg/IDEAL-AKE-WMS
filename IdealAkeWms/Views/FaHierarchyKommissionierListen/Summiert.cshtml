@model IdealAkeWms.Models.ViewModels.FaHierarchyKommissionierSummiertViewModel
@using System.Globalization
@using IdealAkeWms.Services
@{
    ViewData["Title"] = "Kommissionierlisten — Summiert (IDEAL)";
    var deCulture = CultureInfo.GetCultureInfo("de-DE");
    const int colCount = 6; // HauptFA + Artnr + Matchcode + Ziel + Hauptlagerplatz + Summe Sollmenge
    // Print-URL: exakt dieselben Query-Parameter (target/KW/colf_*) wie die Bildschirmansicht.
    var printUrl = Url.Action("PrintSummiert") + Context.Request.QueryString.ToString();
    // PDF je Gruppe: dieselben Query-Parameter wie der Bildschirmdruck; hauptFa ist Routen-Segment.
    var pdfQuery = Context.Request.QueryString.ToString();
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <h2 class="page-header">Kommissionierlisten (IDEAL)</h2>
    <div class="d-flex gap-2 mt-1">
        <a href="@printUrl" target="_blank" class="btn btn-sm btn-outline-secondary" data-print-link="FaHierarchyKommissionierSummiert" title="Aktuell gefilterte Summe drucken (ein Ausdruck je HauptFA)">
            Drucken
        </a>
    </div>
</div>

@* Ansicht-Umschaltung (Liste = Einzelpositionen / Summiert). Der Umschalter nimmt target, KW
   (Pass-Through Richtung Liste) und die gemeinsamen Spaltenfilter mit (BuildToggleQuery). *@
<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link" href="@(Url.Action("Index") + KommissionierListenService.BuildToggleQuery(Context.Request))">Liste</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" href="@(Url.Action("Summiert") + KommissionierListenService.BuildToggleQuery(Context.Request))">Summiert</a>
    </li>
</ul>

@* Filterkarte (ADR 0005): KW-Zeitraum (Kalenderwoche von/bis, ISO Mo–So) auf KO_Termin +
   Kommissionier-Ziel-Dropdown. Natives <input type="week"> (WCAG AA, eigenes Label, Tastatur). *@
<div class="card filter-card mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="Summiert" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="kwVon" class="form-label mb-0 small">Kalenderwoche von</label>
                <input type="week" id="kwVon" name="kwVon" value="@Model.KwVon" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label for="kwBis" class="form-label mb-0 small">Kalenderwoche bis</label>
                <input type="week" id="kwBis" name="kwBis" value="@Model.KwBis" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label for="target" class="form-label mb-0 small">Kommissionier-Ziel</label>
                <select id="target" name="target" class="form-select form-select-sm">
                    <option value="">— alle Ziele —</option>
                    @foreach (var t in Model.AvailableTargets)
                    {
                        <option value="@t" selected="@(string.Equals(t, Model.SelectedTarget, StringComparison.OrdinalIgnoreCase))">@t</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-secondary">Filtern</button>
            </div>
            @if (Model.HasKwFilter || !string.IsNullOrEmpty(Model.SelectedTarget))
            {
                <div class="col-auto">
                    <a asp-action="Summiert" class="btn btn-sm btn-outline-secondary" data-clear-table-filters="FaHierarchyKommissionierSummiert">Zurücksetzen</a>
                </div>
            }
        </form>
        <p class="mb-0 mt-2 small text-muted">
            Je <strong>HauptFA</strong> nach <strong>Artikelnummer</strong> und
            <strong>Kommissionierziel</strong> summierte <em>Sollmenge</em>. Die Kalenderwoche ist
            <strong>optional</strong> und schränkt die einbezogenen HauptFAs über ihren
            <code>KO_Termin</code> ein (ISO-Woche Mo–So). Ohne Kalenderwoche werden alle HauptFAs
            einbezogen.
        </p>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped mb-0 filterable-table" data-view-key="FaHierarchyKommissionierSummiert" data-server-column-filter="true">
        <thead>
            <tr>
                <th data-filterable data-col-key="hauptfa">HauptFA</th>
                <th data-filterable data-col-key="artnr">Artnr.</th>
                <th data-filterable data-col-key="matchcode">Matchcode</th>
                <th data-filterable data-col-key="kommissionieren">Kommissionieren</th>
                <th data-filterable data-col-key="hauptlagerplatz">Hauptlagerplatz</th>
                <th class="text-end" data-filterable data-col-key="sollmenge">Summe Sollmenge</th>
            </tr>
        </thead>
        @if (!Model.Rows.Any())
        {
            <tbody>
                <tr>
                    <td colspan="@colCount" class="text-center text-muted py-4">Keine Kommissionier-Positionen für die aktuelle Filterung gefunden.</td>
                </tr>
            </tbody>
        }
        else
        {
            @* Je HauptFA-Gruppe ein eigenes <tbody>: Gruppen bleiben visuell zusammen, analog Index.cshtml. *@
            @foreach (var group in Model.Rows.GroupBy(r => r.HauptFA))
            {
                <tbody class="fa-komm-group">
                    <tr class="table-active">
                        <td colspan="@colCount">
                            <strong>HauptFA @group.Key</strong>
                            @if (Model.PdfVerfuegbar)
                            {
                                <a href="@(Url.Action("PdfSummiert", new { hauptFa = group.Key }) + pdfQuery)"
                                   class="btn btn-sm btn-outline-secondary ms-2 py-0"
                                   data-print-link="FaHierarchyKommissionierSummiert"
                                   title="PDF dieser HauptFA-Gruppe herunterladen">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" class="me-1" style="vertical-align: -2px;"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/><path d="M4.603 12.087a.8.8 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.7 7.7 0 0 1 1.482-.645 20 20 0 0 0 1.062-2.227 7.3 7.3 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.187-.012.395-.047.614-.084.51-.27 1.134-.52 1.794a11 11 0 0 0 .98 1.686 5.8 5.8 0 0 1 1.334.05c.364.065.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.86.86 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.7 5.7 0 0 1-.911-.95 11.6 11.6 0 0 0-1.997.406 11.3 11.3 0 0 1-1.021 1.51c-.29.35-.608.655-.926.787a.8.8 0 0 1-.58.029"/></svg>PDF
                                </a>
                            }
                        </td>
                    </tr>
                    @foreach (var row in group)
                    {
                        <tr>
                            <td>@row.HauptFA</td>
                            <td>@row.Artnr</td>
                            <td>@row.Matchcode</td>
                            <td>@row.Kommissionieren</td>
                            <td>@row.Hauptlagerplatz</td>
                            <td class="text-end">@row.SummeSollmenge.ToString("N3", deCulture)</td>
                        </tr>
                    }
                </tbody>
            }
        }
    </table>
</div>

<partial name="_Pagination" model="Model.Pagination" />

<script type="application/json" id="view-config">
{ "viewKey": "FaHierarchyKommissionierSummiert", "supportsReorder": true, "supportsSortDefault": false }
</script>
<script type="application/json" id="column-config">
[
    { "key": "hauptfa", "label": "HauptFA", "locked": true, "defaultWidth": null },
    { "key": "artnr", "label": "Artnr.", "locked": false, "defaultWidth": null },
    { "key": "matchcode", "label": "Matchcode", "locked": true, "defaultWidth": null },
    { "key": "kommissionieren", "label": "Kommissionieren", "locked": false, "defaultWidth": null },
    { "key": "hauptlagerplatz", "label": "Hauptlagerplatz", "locked": false, "defaultWidth": null },
    { "key": "sollmenge", "label": "Summe Sollmenge", "locked": false, "defaultWidth": 55 }
]
</script>

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
    <script src="~/js/print-visible-columns.js" asp-append-version="true"></script>
}
