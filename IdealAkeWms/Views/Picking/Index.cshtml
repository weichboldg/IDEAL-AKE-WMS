@model PickingListViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Kommissionierung";
}

<h2 class="page-header">Kommissionierung</h2>
<p class="text-muted mb-3">Kommissionieraufträge je FA und Bereich. Der Leitstand legt sie bei der Freigabe an; ein Klick öffnet den Auftrag.</p>

@* v1.88.0 (Spec 2026-11-08-kommissionierung-auftraege-kopf-zeilen, E2): Filterkarte Bereich / Status / Nur meine *@
<div class="card filter-card mb-3">
    <div class="card-header">Filter</div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="bereichId">Bereich</label>
                <select id="bereichId" name="bereichId" class="form-select">
                    <option value="">Alle Bereiche</option>
                    @foreach (var b in Model.Bereiche)
                    {
                        <option value="@b.Id" selected="@(b.Id == Model.BereichId)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="status">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="offen" selected="@(Model.StatusFilter == "offen")">Offen und in Arbeit</option>
                    <option value="alle" selected="@(Model.StatusFilter == "alle")">Alle (auch abgeschlossen, storniert)</option>
                </select>
            </div>
            @if (Model.PickerAssignmentEnabled)
            {
                <div class="col-md-3">
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" id="showAll" name="showAll" value="true" @(Model.ShowAllOrders ? "checked" : "") />
                        <label class="form-check-label" for="showAll">Aufträge aller Kommissionierer</label>
                    </div>
                </div>
            }
            <div class="col-auto"><button type="submit" class="btn btn-primary">Filtern</button></div>
        </form>
    </div>
</div>

@if (Model.Pagination.TotalCount == 0 && !Model.Items.Any())
{
    <div class="alert alert-info">
        @if (Model.PickerAssignmentEnabled && !Model.ShowAllOrders)
        {
            <text>Aktuell sind Ihnen keine Kommissionieraufträge zugewiesen.</text>
        }
        else
        {
            <text>Keine Kommissionieraufträge für diese Auswahl. Fehlen Aufträge zu freigegebenen FAs, kann der Leitstand sie mit
            „Fehlende Kommissionieraufträge erzeugen“ anlegen.</text>
        }
    </div>
}

@* Toolbar-Host (data-table-toolbar, site.js tableToolbarHost): Zahnrad und CSV, ueber der Zaehlzeile (v1.65.0). *@
<div class="d-flex justify-content-end mb-1" data-table-toolbar></div>
<div class="small text-muted mb-1"><strong>@Model.Pagination.TotalCount</strong> Kommissionieraufträge</div>
<div class="table-responsive">
    <table class="table table-striped table-hover mb-0 filterable-table" data-view-key="Picking" data-server-column-filter="true">
        <thead>
            <tr>
                <th style="width: 60px;" data-filterable data-filter-type="number" data-col-key="priority">Prio</th>
                <th data-filterable data-col-key="nummer">Auftrag</th>
                <th data-filterable data-col-key="order-number">FA Nr.</th>
                <th data-filterable data-col-key="article-number">Artikelnummer</th>
                <th data-filterable data-col-key="matchcode">Matchcode</th>
                <th data-filterable data-col-key="description">Bezeichnung</th>
                <th data-filterable data-col-key="workbench">Werkbank</th>
                <th data-filterable data-col-key="bereich">Bereich</th>
                <th data-filterable data-col-key="picking-date" data-date-filter>Fällig</th>
                <th data-filterable data-col-key="status">Status</th>
                @if (Model.PickerAssignmentEnabled)
                {
                    <th data-filterable data-col-key="picker">Kommissionierer</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                var href = Url.Action("Auftrag", new { id = item.Id });
                <tr class="clickable-row" data-href="@href" style="cursor: pointer;">
                    <td>@(item.PickingPriority?.ToString() ?? "-")</td>
                    <td><a href="@href">@item.Nummer</a></td>
                    <td>@item.OrderNumber</td>
                    <td>@item.ArticleNumber</td>
                    <td>@item.Matchcode</td>
                    <td>@item.Description1</td>
                    <td>@item.WorkplaceName</td>
                    <td>@item.Bereich</td>
                    <td>
                        @if (item.Faelligkeit.HasValue)
                        {
                            var d = item.Faelligkeit.Value;
                            <text>@d.ToString("dd.MM.yyyy") KW@(ISOWeek.GetWeekOfYear(d))</text>
                        }
                    </td>
                    <td>@PickingOrderListItem.StatusText(item.Status)</td>
                    @if (Model.PickerAssignmentEnabled)
                    {
                        <td>@item.AssignedPickerName</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Pagination" />

<script type="application/json" id="view-config">
{ "viewKey": "Picking", "supportsReorder": true, "supportsSortDefault": true }
</script>
<script type="application/json" id="column-config">
[
    { "key": "priority", "label": "Prio", "locked": false, "defaultWidth": 60 },
    { "key": "nummer", "label": "Auftrag", "locked": true, "defaultWidth": null },
    { "key": "order-number", "label": "FA Nr.", "locked": false, "defaultWidth": null },
    { "key": "article-number", "label": "Artikelnummer", "locked": false, "defaultWidth": null },
    { "key": "matchcode", "label": "Matchcode", "locked": false, "defaultWidth": null },
    { "key": "description", "label": "Bezeichnung", "locked": false, "defaultWidth": null },
    { "key": "workbench", "label": "Werkbank", "locked": false, "defaultWidth": null },
    { "key": "bereich", "label": "Bereich", "locked": false, "defaultWidth": null },
    { "key": "picking-date", "label": "Fällig", "locked": false, "defaultWidth": null },
    { "key": "status", "label": "Status", "locked": false, "defaultWidth": null }
    @if (Model.PickerAssignmentEnabled) { <text>,{ "key": "picker", "label": "Kommissionierer", "locked": false, "defaultWidth": null }</text> }
]
</script>

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('.clickable-row').forEach(function (row) {
            row.addEventListener('click', function (e) {
                if (e.target.closest('a')) return;
                window.location.href = this.getAttribute('data-href');
            });
        });
    </script>
}
