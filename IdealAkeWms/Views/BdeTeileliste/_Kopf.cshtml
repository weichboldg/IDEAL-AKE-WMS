@model IdealAkeWms.Models.ViewModels.BdeTeilelisteViewModel
@* v1.99.32 BDE-Teileliste: Kopf (Werkbank, Werker), Sicht-Reiter, Filterkarte, Hinweise. Gemeinsam fuer Einzeln, Summiert und (v1.99.76) FA. *@
@{
    var sicht = Model.Sicht;
    // v1.99.73 (E1-4 F2): Kurzfassung der Filter fuer den Aufklapp-Knopf unter 992 px.
    static string Kw(string? v) => v is { Length: 8 } && v[4] == '-' ? $"KW {v[6..]}/{v[..4]}" : v ?? "";
    var wochen = string.IsNullOrEmpty(Model.KwVon) && string.IsNullOrEmpty(Model.KwBis) ? "alle Wochen"
        : $"{(string.IsNullOrEmpty(Model.KwVon) ? "…" : Kw(Model.KwVon))} bis {(string.IsNullOrEmpty(Model.KwBis) ? "…" : Kw(Model.KwBis))}";
    var spaltenfilter = IdealAkeWms.Services.ColumnFilterHelper.ReadFromQuery(Context.Request).Count;
    var kurz = Model.IstFa ? (spaltenfilter > 0 ? $"{spaltenfilter} Spaltenfilter" : "keine Spaltenfilter")
        : wochen + ", gemeldete " + (Model.GemeldeteZeigen ? "sichtbar" : "ausgeblendet") + (spaltenfilter > 0 ? $", {spaltenfilter} Spaltenfilter" : "");
    // v1.99.76 (E4-7, AK 30): Teile-Reiter nur bei Master an; ohne Teile-Sicht deaktiviert mit Hinweis.
    var teileReiter = new[] { ("einzeln", "Teile Einzeln"), ("summiert", "Teile Summiert") };
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
    <h2 class="mb-0">
        @(Model.IstFa ? "BDE – Arbeitsgänge" : "BDE-Teileliste")
        @if (Model.Kuerzel != null)
        {
            <span class="badge bg-secondary align-middle">Kürzel @Model.Kuerzel</span>
        }
    </h2>
    <div class="d-flex align-items-center gap-2">
        <label for="teilelisteWerkbank" class="form-label mb-0">Werkbank</label>
        <select id="teilelisteWerkbank" class="form-select bde-touch w-auto" data-ziel="@Url.Action("Index", "BdeTeileliste")">
            @foreach (var wp in Model.Werkbaenke)
            {
                <option value="@wp.Id" selected="@(wp.Id == Model.Werkbank.Id)">@wp.Name</option>
            }
        </select>
    </div>
</div>

<div class="bde-operator-badge mb-2">
    <span class="fw-bold">@Model.Werker!.DisplayName</span>
    <span class="ms-2 small">Personalnr. @Model.Werker.PersonnelNumber</span>
    <a class="btn btn-outline-secondary ms-auto bde-touch" asp-action="Index" asp-route-workplaceId="@Model.Werkbank.Id">Werker wechseln</a>
</div>

<ul class="nav nav-pills mb-1" aria-label="Ansicht">
    @if (Model.Hierarchisch)
    {
        foreach (var (wert, text) in teileReiter)
        {
            <li class="nav-item">
                @if (Model.TeileSicht)
                {
                    <a class="nav-link bde-touch @(sicht == wert ? "active" : "")" aria-current="@(sicht == wert ? "page" : null)" asp-action="Index"
                       asp-route-workplaceId="@Model.Werkbank.Id" asp-route-operatorId="@Model.Werker.Id" asp-route-sicht="@wert"
                       asp-route-kwVon="@Model.KwVon" asp-route-kwBis="@Model.KwBis" asp-route-gemeldete="@Model.GemeldeteZeigen">@text</a>
                }
                else
                {
                    <span class="nav-link bde-touch disabled" aria-disabled="true" aria-describedby="teileReiterHinweis">@text</span>
                }
            </li>
        }
    }
    <li class="nav-item">
        <a class="nav-link bde-touch @(Model.IstFa ? "active" : "")" aria-current="@(Model.IstFa ? "page" : null)" asp-action="Index"
           asp-route-workplaceId="@Model.Werkbank.Id" asp-route-operatorId="@Model.Werker.Id" asp-route-sicht="fa">FA</a>
    </li>
</ul>
@if (Model.Hierarchisch && !Model.TeileSicht)
{
    <p id="teileReiterHinweis" class="small mb-2">Teile-Reiter nur an Werkbänken mit „BDE-Teileliste (vereinfacht)“ und Kürzel – diese Werkbank zeigt die FA-Sicht.</p>
}
else
{
    <div class="mb-1"></div>
}

<button type="button" class="btn btn-outline-secondary bde-touch w-100 d-lg-none text-start mb-2 bde-tl-filter-knopf" data-bs-toggle="collapse"
        data-bs-target="#tlFilter" aria-expanded="false" aria-controls="tlFilter">
    <span class="fw-semibold">Filter</span>&nbsp;<span class="small">(@kurz)</span><span class="bde-tl-teile-zeichen" aria-hidden="true"></span>
</button>
<div class="card filter-card mb-2 collapse d-lg-block" id="tlFilter">
    <div class="card-body py-2">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="workplaceId" value="@Model.Werkbank.Id" />
            <input type="hidden" name="operatorId" value="@Model.Werker.Id" />
            <input type="hidden" name="sicht" value="@sicht" />
            @if (!Model.IstFa)
            {
            <div class="col-sm-4 col-md-3">
                <label for="kwVon" class="form-label mb-0">Kalenderwoche von</label>
                <input type="week" id="kwVon" name="kwVon" value="@Model.KwVon" class="form-control bde-touch" />
            </div>
            <div class="col-sm-4 col-md-3">
                <label for="kwBis" class="form-label mb-0">Kalenderwoche bis</label>
                <input type="week" id="kwBis" name="kwBis" value="@Model.KwBis" class="form-control bde-touch" />
            </div>
            <div class="col-auto">
                <div class="form-check form-switch bde-touch d-flex align-items-center gap-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="gemeldete" name="gemeldete" value="true" checked="@Model.GemeldeteZeigen" />
                    <label class="form-check-label" for="gemeldete">gemeldete zeigen</label>
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary bde-touch">Filtern</button>
            </div>
            }
            <div class="col-auto">
                <button type="submit" form="filterReset" class="btn btn-outline-secondary bde-touch">Filter zurücksetzen</button>
            </div>
        </form>
        <form id="filterReset" method="post" asp-action="FilterZuruecksetzen" class="d-none">
            <input type="hidden" name="workplaceId" value="@Model.Werkbank.Id" />
            <input type="hidden" name="operatorId" value="@Model.Werker.Id" />
        </form>
        <details class="mt-2 small text-muted bde-tl-hinweise">
            <summary class="bde-touch">Hinweise zur Liste</summary>
            @if (Model.IstFa)
            {
                <text>Zeilen = offene Arbeitsgänge dieser Werkbank@(Model.Kuerzel != null ? " und der Werkbänke mit gleichem Kürzel" : ""), Reihenfolge wie bisher am
                Terminal (Prio, Fertigungstermin). „läuft“ = ein anderer Werker bucht darauf; Anstempeln ist trotzdem möglich, der Server prüft dabei.
                „läuft bei Ihnen“ = Sie buchen schon darauf. Fertig gemeldete Arbeitsgänge sind ausgeblendet. AG-Status zeigt alle Arbeitsgänge des
                Auftrags, der Arbeitsgang der Zeile ist umrahmt. Filter werden je Werker und Werkbank gespeichert.</text>
            }
            else
            {
            <text>Zeilen = Teile und Baugruppen der FA-Struktur, deren Arbeitsschritte <strong>@Model.Kuerzel</strong> enthalten. Die Kalenderwoche filtert auf
            den Fertigstellungstermin (FE-Termin) des Hauptauftrags. Erledigte oder stornierte Aufträge sind ausgeblendet.
            Filter werden je Werker und Werkbank gespeichert; die Spaltenauswahl (Zahnrad) gilt für den Terminal-Benutzer.
            Baugruppen: „Teile (n)“ neben dem Matchcode klappt die Teile als eigene Zeilen auf (nur Anzeige); trifft ein Spaltenfilter nur ein Teil,
            ist die Baugruppe aufgeklappt und das Teil mit „Treffer“ markiert. Schmaler als 992 px (Handy) erscheint die Liste als Karten; die
            Spaltenfilter sind dort nicht bedienbar – „Filter zurücksetzen“ hebt sie auf.</text>
            }
        </details>
    </div>
</div>

@if (Model.Waisen > 0)
{
    <div class="alert alert-warning" role="alert">
        <strong>Hinweis:</strong> @Model.Waisen Meldung(en) ohne passende Strukturzeile – Sage hat Position oder Artikel geändert.
        Prüfung durch den BDE-Admin unter <a asp-controller="BdeBookings" asp-action="Teilmeldungen" class="alert-link">BDE-Buchungen › Teilmeldungen</a>.
    </div>
}
