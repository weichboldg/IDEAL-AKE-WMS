@model IdealAkeWms.Models.ViewModels.BdeTeilelisteViewModel
@using IdealAkeWms.Models
@using IdealAkeWms.Services
@* v1.99.77 (Spec 2026-11-25-bde-masken-vereinheitlichung E4-4/E4-6, AK 25): laufende und pausierte Buchungen des Werkers im Kopf der
   FA-Sicht, serverseitig aus BdeKopfBuchungen (dieselbe Abfrage wie das Terminal). Knoepfe rufen ueber bde-fa-sicht.js die bestehenden
   JSON-Aktionen von BdeTerminal, danach Neuladen. Zustand = Text + Balkenform (durchgezogen/gestrichelt), nie Farbe allein.
   Schalter „Zeiten und Details“ nur Anzeige, je Werker im localStorage.
   v1.99.79 F-26: Laufzeit zaehlt in bde-fa-sicht.js live weiter (data-sekunden = Stand Seitenaufbau, Serveruhr; Terminal-Uhr egal). *@
@{
    var jetzt = DateTime.Now;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Was(BdeKopfBuchung b) => b.Typ == BdeBookingType.Activity ? (b.ActivityName == "" ? "Tätigkeit" : b.ActivityName)
        : b.OrderNumber + (string.IsNullOrEmpty(b.SubOrderNumber) || b.SubOrderNumber == b.OrderNumber ? "" : $" · Sub-FA {b.SubOrderNumber}") // v1.99.79 F-35
          + $" / {b.OperationNumber.Trim()}" + (b.OperationName == "" ? "" : $" {b.OperationName}");
    string Art(BdeKopfBuchung b) => b.Typ switch { BdeBookingType.Setup => "Rüsten", BdeBookingType.Production => "Produktion", _ => "Tätigkeit" };
    var leer = Model.KopfLaufend.Count == 0 && Model.KopfPausiert.Count == 0;
}
<section class="bde-kopf mb-2" aria-labelledby="bdeKopfTitel">
    <div id="faMeldung" aria-live="polite"></div>
    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
        <h3 id="bdeKopfTitel" class="h5 mb-0">Meine Buchungen</h3>
        <div class="form-check form-switch mb-0 ms-auto bde-touch">
            <input class="form-check-input" type="checkbox" role="switch" id="bdeKopfDetails" />
            <label class="form-check-label" for="bdeKopfDetails">Zeiten und Details</label>
        </div>
        <button type="button" class="btn btn-outline-primary bde-touch" id="btnTaetigkeit">Tätigkeit starten</button>
    </div>
    @if (leer)
    {
        <p class="mb-0 bde-kopf-leer">Keine laufende oder pausierte Buchung. Arbeitsgang in der Liste anstempeln oder FA scannen.</p>
    }
    else
    {
        <ul class="list-unstyled mb-0">
            @foreach (var b in Model.KopfLaufend)
            {
                var was = Was(b);
                <li class="bde-kopf-zeile bde-kopf-laeuft" data-booking-id="@b.BookingId" data-wo-id="@b.WorkOperationId"
                    data-soll="@b.TargetQuantity?.ToString(inv)" data-bez="@was">
                    <span class="bde-kopf-art">@Art(b) läuft</span>
                    <span class="bde-kopf-was">@was</span>
                    <span class="bde-kopf-detail">Start @b.StartedAt.ToString("HH:mm"), Laufzeit <span class="bde-laufzeit" data-sekunden="@((long)Math.Max(0, (jetzt - b.StartedAt).TotalSeconds))">@BdeKopfBuchungen.Laufzeit(b.StartedAt, jetzt)</span>,
                        @b.WorkplaceName, Terminal @(b.TerminalName == "" ? "–" : b.TerminalName), Personalnr. @Model.Werker!.PersonnelNumber</span>
                    <span class="bde-kopf-knoepfe">
                        @switch (b.Typ)
                        {
                            case BdeBookingType.Setup:
                                <button type="button" class="btn btn-outline-secondary bde-touch" data-kopf-aktion="pause" aria-label="Pause @was">Pause</button>
                                <button type="button" class="btn btn-outline-primary bde-touch" data-kopf-aktion="ruesten-fertig" aria-label="Rüsten fertig @was">Rüsten fertig</button>
                                <button type="button" class="btn btn-primary bde-touch" data-kopf-aktion="produktion" aria-label="Produktion starten @was">Produktion</button>
                                break;
                            case BdeBookingType.Production:
                                <button type="button" class="btn btn-outline-secondary bde-touch" data-kopf-aktion="pause" aria-label="Pause @was">Pause</button>
                                <button type="button" class="btn btn-outline-primary bde-touch" data-kopf-aktion="teilfertig" aria-label="Teilfertig @was">Teilfertig</button>
                                <button type="button" class="btn btn-success bde-touch" data-kopf-aktion="fertig" aria-label="Fertig @was">Fertig</button>
                                break;
                            default:
                                <button type="button" class="btn btn-primary bde-touch" data-kopf-aktion="beenden" aria-label="Beenden @was">Beenden</button>
                                break;
                        }
                    </span>
                </li>
            }
            @foreach (var b in Model.KopfPausiert)
            {
                var was = Was(b);
                <li class="bde-kopf-zeile bde-kopf-pausiert" data-booking-id="@b.BookingId">
                    <span class="bde-kopf-art">@Art(b) pausiert@(b.Status == BdeBookingStatus.AutoPaused ? " (automatisch)" : "")</span>
                    <span class="bde-kopf-was">@was</span>
                    <span class="bde-kopf-detail">Pause seit @(b.PausedAt?.ToString("HH:mm") ?? "–"), Start @b.StartedAt.ToString("HH:mm"),
                        @b.WorkplaceName, Terminal @(b.TerminalName == "" ? "–" : b.TerminalName), Personalnr. @Model.Werker!.PersonnelNumber</span>
                    <span class="bde-kopf-knoepfe">
                        <button type="button" class="btn btn-primary bde-touch" data-kopf-aktion="fortsetzen" aria-label="Fortsetzen @was">Fortsetzen</button>
                    </span>
                </li>
            }
        </ul>
    }
</section>
