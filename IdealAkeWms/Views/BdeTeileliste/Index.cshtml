@model IdealAkeWms.Models.ViewModels.BdeTeilelisteViewModel
@using IdealAkeWms.Services
@{
    ViewData["Title"] = "BDE-Teileliste";
    ViewData["FraesenPfadTouch"] = true; // v1.99.72: Knopf „Pfad kopieren“ ≥ 44 px am Terminal
    var colCount = 22 + (Model.FraesenPfadAktiv ? 1 : 0);
}
<link rel="stylesheet" href="~/css/bde.css" asp-append-version="true" />

<div class="container-fluid bde-terminal bde-tl-seite">
    <partial name="_Kopf" model="Model" />

    <form id="blockForm" method="post" asp-action="Melden" class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <input type="hidden" name="workplaceId" value="@Model.Werkbank.Id" />
        <input type="hidden" name="operatorId" value="@Model.Werker!.Id" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div class="form-check bde-touch d-flex align-items-center gap-2 mb-0">
            <input class="form-check-input" type="checkbox" id="alleAuswaehlen" />
            <label class="form-check-label" for="alleAuswaehlen">alle auf dieser Seite</label>
        </div>
        <button type="submit" class="btn btn-primary btn-lg" id="blockMelden" disabled>Auswahl fertigmelden</button>
        <span class="small text-muted d-none d-lg-inline">Restmenge je Zeile, Ausschuss 0 – schließt die Zeilen ab</span>
    </form>

    <div class="d-flex justify-content-end mb-1" data-table-toolbar></div>
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle mb-0 filterable-table bde-teileliste" data-view-key="BdeTeileliste" data-server-column-filter="true">
            <thead>
                <tr>
                    <th data-col-key="auswahl"><span class="visually-hidden">Auswahl</span></th>
                    <th data-filterable data-col-key="matchcode">Matchcode</th>
                    <th class="text-end" data-filterable data-filter-type="number" data-col-key="sollmenge">Menge</th>
                    <th data-filterable data-col-key="hauptfa">Hauptauftrag</th>
                    <th data-filterable data-col-key="montage-abteilung">Abteilung</th>
                    <th class="text-nowrap" data-filterable data-col-key="fe-termin" data-date-filter>FE-Termin</th>
                    <th data-filterable data-col-key="ag-status" title="Arbeitsgang-Status je Arbeitsschritt (Zeichen + Kürzel; filterbar nach Kürzel oder Status, z. B. erledigt)">AG-Status</th>
                    <th data-filterable data-col-key="material">Material</th>
                    <th class="text-end" data-filterable data-filter-type="number" data-col-key="blechdicke">Blechdicke</th>
                    @if (Model.FraesenPfadAktiv)
                    {
                        <th data-filterable data-col-key="fraesen-pfad">Fräsen-Pfad</th>
                    }
                    <th data-filterable data-col-key="beschichtet" title="Kennzeichen Beschichtet der Position aus der FA-Struktur (– = Quelle kennt kein Positions-Kennzeichen)">Beschichtet</th>
                    <th data-filterable data-col-key="artnr">Artikelnummer</th>
                    <th data-filterable data-col-key="subfa">Sub-FA</th>
                    <th data-filterable data-col-key="vaterfa">Vater-Sub-FA</th>
                    <th data-filterable data-col-key="position">Position</th>
                    <th data-filterable data-col-key="arbeitsschritte">Arbeitsschritte</th>
                    <th data-filterable data-col-key="arbeitsbereich">Arbeitsbereich</th>
                    <th data-filterable data-col-key="kunde">Kunde</th>
                    <th data-filterable data-col-key="bemerkungpn">Bemerkung PN</th>
                    <th data-filterable data-col-key="fertigungsinfopn">Fertigungsinfo PN</th>
                    <th data-filterable data-col-key="bezeichnung">Bezeichnung</th>
                    <th data-col-key="status">Status</th>
                    <th data-col-key="aktion"><span class="visually-hidden">Aktion</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Zeilen.Any())
                {
                    <tr><td colspan="@colCount" class="text-center text-muted py-4">Keine offenen Teile mit Kürzel @Model.Kuerzel im gewählten Zeitraum.</td></tr>
                }
                @for (var i = 0; i < Model.Zeilen.Count; i++)
                {
                    var z = Model.Zeilen[i];
                    <tr data-tl-eltern-id="@i">
                        @{ await Zellen(z, i); }
                    </tr>
                    @for (var j = 0; j < z.Kinder.Count; j++)
                    {
                        var k = z.Kinder[j];
                        @* E1-2/E1-3: Kinderzeile im selben <tbody> (eine filterbare Tabelle), nur Anzeige; Kind-Treffer = Rahmen + Zeichen + Text *@
                        <tr class="bde-tl-kind collapse @(z.Aufgeklappt ? "show" : null) @(k.Treffer ? "bde-tl-treffer" : null)" id="kind-@i-@j" data-eltern="@i">
                            @{ await Zellen(k, null); }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="Model.Pagination" />
</div>

@{
    // v1.99.73 (E1-2): EIN Zellensatz fuer Eltern- (i gesetzt) und Kinderzeilen (i null) – gleiche Spalten, gleiche Getter = Filter;
    // data-col-key fuer das Zahnrad, data-label fuer die Kartenansicht unter 992 px (Scope .bde-tl-seite in bde.css).
    async Task Zellen(TeilelisteZeile z, int? i)
    {
        var n = z.Node;
        var kind = i == null;
        <td data-col-key="auswahl" data-label="Auswahl" class="tl-zelle-auswahl">
            @if (!kind && z.Meldbar)
            {
                <label class="tl-check">
                    <input class="form-check-input tl-auswahl" type="checkbox" form="blockForm" name="schluessel" value="@z.FormSchluessel"
                           data-soll="@z.Rest.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="@n.Matchcode auswählen" />
                </label>
            }
        </td>
        <td data-col-key="matchcode" data-label="Matchcode" data-csv-value="@n.Matchcode">
            @if (kind)
            {
                <span class="bde-tl-kind-pfeil" aria-hidden="true">&#8627;</span><span class="visually-hidden">Teil der Baugruppe: </span>
            }
            @n.Matchcode
            @if (z.Treffer)
            {
                <span class="badge bde-tl-treffer-badge ms-1"><span aria-hidden="true">&#9670;</span> Treffer</span>
            }
            @if (z.IstBaugruppe)
            {
                <span class="badge text-bg-dark ms-1">Baugruppe</span>
                if (!kind && z.Kinder.Count > 0)
                {
                    <button type="button" class="btn btn-outline-secondary bde-touch ms-1 bde-tl-teile" data-bs-toggle="collapse" data-bs-target="[data-eltern='@i']"
                            aria-expanded="@(z.Aufgeklappt ? "true" : "false")" aria-controls="@string.Join(" ", z.Kinder.Select((_, j) => $"kind-{i}-{j}"))">Teile (@(z.KinderGesamt > z.Kinder.Count ? $"{z.Kinder.Count} von {z.KinderGesamt}" : z.Kinder.Count.ToString()))<span class="bde-tl-teile-zeichen" aria-hidden="true"></span></button>
                }
                else if (!kind && z.KinderGesamt > 0)
                {
                    @* v1.99.81 (Task 4b): Filter blendet alle Teile aus – sagen statt still weglassen *@
                    <span class="small text-body-secondary ms-1">Teile: 0 von @z.KinderGesamt passen zum Filter</span>
                }
                else if (!kind)
                {
                    <span class="small text-muted ms-1">keine Teile in der Struktur</span>
                }
            }
        </td>
        <td class="text-end" data-col-key="sollmenge" data-label="Menge">@VormontageService.FormatMenge(n.Sollmenge)</td>
        <td data-col-key="hauptfa" data-label="Hauptauftrag">@Model.Spalten["hauptfa"](z)</td>
        <td data-col-key="montage-abteilung" data-label="Abteilung">@Model.Spalten["montage-abteilung"](z)</td>
        <td data-col-key="fe-termin" data-label="FE-Termin">@Model.Spalten["fe-termin"](z)</td>
        <td data-col-key="ag-status" data-label="AG-Status"><partial name="_FaAgSymbole" model="z.Arbeitsgaenge" /></td>
        <td data-col-key="material" data-label="Material">@n.Material</td>
        <td class="text-end" data-col-key="blechdicke" data-label="Blechdicke">@(Model.Spalten["blechdicke"](z) ?? "–")</td>
        @if (Model.FraesenPfadAktiv)
        {
            var pfad = Model.Spalten["fraesen-pfad"](z);
            <td data-col-key="fraesen-pfad" data-label="Fräsen-Pfad"><partial name="_FraesenPfad" model="pfad" /></td>
        }
        <td data-col-key="beschichtet" data-label="Beschichtet">@(z.Lager != null ? "–" : Model.Beschichtet?.Invoke(n) ?? "–")</td>
        <td data-col-key="artnr" data-label="Artikelnummer">@n.Artnr</td>
        <td data-col-key="subfa" data-label="Sub-FA">@(n.SubFA == 0 ? null : n.SubFA)</td>
        <td data-col-key="vaterfa" data-label="Vater-Sub-FA">@n.VaterFA</td>
        <td data-col-key="position" data-label="Position">@n.Position</td>
        <td data-col-key="arbeitsschritte" data-label="Arbeitsschritte">@n.Arbeitsschritte</td>
        <td data-col-key="arbeitsbereich" data-label="Arbeitsbereich">@n.Arbeitsbereich</td>
        <td data-col-key="kunde" data-label="Kunde">@Model.Spalten["kunde"](z)</td>
        <td data-col-key="bemerkungpn" data-label="Bemerkung PN">@n.BemerkungPN</td>
        <td data-col-key="fertigungsinfopn" data-label="Fertigungsinfo PN">@n.FertigungsInfoPN</td>
        <td data-col-key="bezeichnung" data-label="Bezeichnung">@n.Bezeichnung1</td>
        <td data-col-key="status" data-label="Status">
            @if (kind)
            {
                <span class="small text-muted">nur Anzeige</span>
            }
            else
            {
                <partial name="_TeilStatus" model="(z, Model)" />
            }
        </td>
        <td class="text-nowrap tl-zelle-aktion" data-col-key="aktion" data-label="Aktion">
            @if (!kind && z.Meldbar)
            {
                <button type="button" class="btn btn-success bde-touch" data-bs-toggle="modal" data-bs-target="#meldenModal"
                        data-schluessel="@z.FormSchluessel" data-matchcode="@n.Matchcode"
                        data-soll="@n.Sollmenge.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-rest="@z.Rest.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)"
                        data-gemeldet="@z.Gemeldet.ToString(System.Globalization.CultureInfo.InvariantCulture)">Melden</button>
            }
        </td>
    }
}

<div class="modal fade bde-terminal" id="meldenModal" tabindex="-1" aria-labelledby="meldenModalTitel" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" method="post" asp-action="Melden">
            <div class="modal-header">
                <h5 class="modal-title" id="meldenModalTitel">Melden: <span data-feld="matchcode"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body bde-terminal">
                <input type="hidden" name="workplaceId" value="@Model.Werkbank.Id" />
                <input type="hidden" name="operatorId" value="@Model.Werker!.Id" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" name="schluessel" data-feld="schluessel" />
                <div class="mb-3">
                    <label for="meldenGut" class="form-label">Gut</label>
                    <input type="number" id="meldenGut" name="gut" class="form-control form-control-lg" min="0" step="any" inputmode="decimal" required />
                    <div class="form-text">Soll <span data-feld="soll"></span>, bereits gemeldet <span data-feld="gemeldet"></span> –
                        vorbelegt mit der Restmenge <span data-feld="rest"></span></div>
                </div>
                <div class="mb-1">
                    <label for="meldenAusschuss" class="form-label">Ausschuss</label>
                    <input type="number" id="meldenAusschuss" name="ausschuss" class="form-control form-control-lg" min="0" step="any" inputmode="decimal" />
                </div>
                @* v1.99.75 (E3-1, ADR 0037): Teilfertig laesst die Zeile offen, Fertig schliesst sie ab – die Art traegt der Knopftext, nicht die Farbe *@
                <p class="small mb-0 mt-2">„Teilfertig melden“: Zeile bleibt offen. „Fertig melden“: Zeile ist danach abgeschlossen.</p>
            </div>
            <div class="modal-footer flex-wrap">
                <button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">Abbrechen</button>
                <button type="submit" name="art" value="teil" class="btn btn-outline-success btn-lg">Teilfertig melden</button>
                <button type="submit" name="art" value="fertig" class="btn btn-success btn-lg">Fertig melden</button>
            </div>
        </form>
    </div>
</div>

<script type="application/json" id="view-config">
{ "viewKey": "BdeTeileliste", "supportsReorder": true, "supportsSortDefault": false }
</script>
<script type="application/json" id="column-config">
[
    { "key": "auswahl", "label": "Auswahl", "locked": true, "defaultWidth": null },
    { "key": "matchcode", "label": "Matchcode", "locked": true, "defaultWidth": null },
    { "key": "sollmenge", "label": "Menge", "locked": false, "defaultWidth": null },
    { "key": "hauptfa", "label": "Hauptauftrag", "locked": false, "defaultWidth": null },
    { "key": "montage-abteilung", "label": "Abteilung", "locked": false, "defaultWidth": null },
    { "key": "fe-termin", "label": "FE-Termin", "locked": false, "defaultWidth": null },
    { "key": "ag-status", "label": "AG-Status", "locked": false, "defaultWidth": null },
    { "key": "material", "label": "Material", "locked": false, "defaultWidth": null },
    { "key": "blechdicke", "label": "Blechdicke", "locked": false, "defaultWidth": null },
    @if (Model.FraesenPfadAktiv)
    {
        @:{ "key": "fraesen-pfad", "label": "Fräsen-Pfad", "locked": false, "defaultWidth": null, "defaultHidden": true },
    }
    { "key": "beschichtet", "label": "Beschichtet", "locked": false, "defaultWidth": null },
    { "key": "artnr", "label": "Artikelnummer", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "subfa", "label": "Sub-FA", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "vaterfa", "label": "Vater-Sub-FA", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "position", "label": "Position", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "arbeitsschritte", "label": "Arbeitsschritte", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "arbeitsbereich", "label": "Arbeitsbereich", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "kunde", "label": "Kunde", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "bemerkungpn", "label": "Bemerkung PN", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "fertigungsinfopn", "label": "Fertigungsinfo PN", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "bezeichnung", "label": "Bezeichnung", "locked": false, "defaultWidth": null, "defaultHidden": true },
    { "key": "status", "label": "Status", "locked": true, "defaultWidth": null },
    { "key": "aktion", "label": "Aktion", "locked": true, "defaultWidth": null }
]
</script>

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
    <script src="~/js/bde-teileliste.js" asp-append-version="true"></script>
}
