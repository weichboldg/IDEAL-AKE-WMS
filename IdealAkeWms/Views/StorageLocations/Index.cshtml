@model List<StorageLocation>
@inject IdealAkeWms.Services.ICurrentUserService _user
@{
    ViewData["Title"] = "Lagerplätze";
    var showInactive = (bool?)ViewBag.ShowInactive == true;
    var onlyBookable = (bool?)ViewBag.OnlyBookable == true;
    var hasInactive = (bool?)ViewBag.HasInactive == true;
    var hasNonBookable = (bool?)ViewBag.HasNonBookable == true;
    var canEdit = await _user.HasMasterDataAccessAsync();
    // Spalten: code, description, zone, storage-area, sage-locked, capacity, type, source, bookable, sage-buchung, [is-active], created-at, actions
    var colCount = showInactive ? 13 : 12;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="page-header mb-0">Lagerplätze</h2>
    <div class="d-flex gap-2">
        <a asp-action="PrintLabels" class="btn btn-secondary">Alle Etiketten drucken</a>
        @if (canEdit)
        {
            <a asp-action="Create" class="btn btn-primary">Neuen Lagerplatz anlegen</a>
        }
    </div>
</div>

@if (!canEdit)
{
    <div class="alert alert-info small">Sie haben Nur-Lesen-Zugriff. Aenderungen sind nicht moeglich.</div>
}

@if (hasInactive || hasNonBookable)
{
    <form method="get" class="d-flex gap-3 mb-3 flex-wrap">
        @if (hasInactive)
        {
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="showInactiveToggle" name="showInactive" value="true"
                       @(showInactive ? "checked" : "")
                       onchange="this.form.submit()" />
                <label class="form-check-label" for="showInactiveToggle">Auch inaktive Lagerpl&auml;tze zeigen</label>
            </div>
        }
        @if (hasNonBookable)
        {
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="onlyBookableToggle" name="onlyBookable" value="true"
                       @(onlyBookable ? "checked" : "")
                       onchange="this.form.submit()" />
                <label class="form-check-label" for="onlyBookableToggle">Nur buchbare Pl&auml;tze zeigen</label>
            </div>
        }
        @if (!hasInactive && showInactive)
        {
            <input type="hidden" name="showInactive" value="true" />
        }
        @if (!hasNonBookable && onlyBookable)
        {
            <input type="hidden" name="onlyBookable" value="true" />
        }
    </form>
}

@* Toolbar-Host (data-table-toolbar, site.js tableToolbarHost): Zahnrad fuer die Spaltenauswahl (v1.73.0). *@
<div class="d-flex justify-content-end mb-1" data-table-toolbar></div>
<div class="table-responsive">
    <table class="table table-striped mb-0 filterable-table" data-server-column-filter="true" data-view-key="StorageLocations">
        <thead>
            <tr>
                <th data-filterable data-col-key="code">Code</th>
                <th data-filterable data-col-key="description">Bezeichnung</th>
                <th data-filterable data-col-key="zone">Bereich/Zone</th>
                <th data-filterable data-col-key="storage-area" title="Lagerort aus Sage (nur bei Abgleich über SData befüllt)">Lagerort</th>
                <th data-filterable data-col-key="sage-locked" title="Sperre aus Sage (nur bei Abgleich über SData befüllt)">Sperre (Sage)</th>
                <th data-filterable data-filter-type="number" data-col-key="capacity">Kapazität</th>
                <th data-filterable data-col-key="type">Typ</th>
                <th data-filterable data-col-key="source">Quelle</th>
                <th data-filterable data-col-key="bookable">Buchbar</th>
                <th data-filterable data-col-key="sage-buchung">Sage-Buchung</th>
                @if (showInactive)
                {
                    <th data-filterable data-col-key="is-active">Aktiv</th>
                }
                <th data-filterable data-date-filter data-col-key="created-at">Erstellt am</th>
                <th data-col-key="actions" style="width: 100px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var location in Model)
            {
                <tr class="@(location.IsActive ? "" : "text-muted text-decoration-line-through")">
                    <td><strong>@location.Code</strong></td>
                    <td>@location.Description</td>
                    <td>@location.Zone</td>
                    <td data-col-key="storage-area">@IdealAkeWms.Controllers.StorageLocationsController.StorageAreaText(location)</td>
                    <td data-col-key="sage-locked">
                        @if (location.SageIstGesperrt == true)
                        {
                            <span class="badge bg-warning text-dark">Gesperrt</span>
                        }
                        @if (location.SageIstGesperrtInventur == true)
                        {
                            <span class="badge bg-secondary">Inventur</span>
                        }
                    </td>
                    <td>@location.Capacity?.ToString("N2")</td>
                    <td>@if (location.IsPickingTransport) { <span class="badge bg-info">Wagen</span> }</td>
                    <td data-col-key="source">
                        @if (location.Source == IdealAkeWms.Models.StorageLocationSource.Sage)
                        {
                            <span class="badge bg-info">Sage</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Manuell</span>
                        }
                    </td>
                    <td data-col-key="bookable">
                        @if (location.IstBuchbar)
                        {
                            <span class="badge bg-success">Ja</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nein</span>
                        }
                    </td>
                    <td data-col-key="sage-buchung">
                        @if (location.SageBuchungErlaubt)
                        {
                            <span class="badge bg-success">Ja</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nein</span>
                        }
                    </td>
                    @if (showInactive)
                    {
                        <td data-col-key="is-active">@(location.IsActive ? "Ja" : "Nein")</td>
                    }
                    <td>@location.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-nowrap">
                        <a asp-action="PrintLabel" asp-route-id="@location.Id" class="btn btn-sm btn-outline-secondary" title="Etikett drucken">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1"/>
                                <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4zm1 10a1 1 0 0 1-1-1v-2h8v2a1 1 0 0 1-1 1z"/>
                            </svg>
                        </a>
                        @if (canEdit)
                        {
                            <a asp-action="Edit" asp-route-id="@location.Id" class="btn btn-sm btn-secondary">Bearbeiten</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="@colCount" class="text-center text-muted py-4">Keine Lagerplätze vorhanden.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.Pagination is IdealAkeWms.Models.ViewModels.PaginationState paginationState)
{
    <partial name="_Pagination" model="paginationState" />
}

<script type="application/json" id="view-config">
{ "viewKey": "StorageLocations", "supportsReorder": false, "supportsSortDefault": false }
</script>
<script type="application/json" id="column-config">
[
    { "key": "code", "label": "Code", "locked": true, "defaultWidth": null },
    { "key": "description", "label": "Bezeichnung", "locked": false, "defaultWidth": null },
    { "key": "zone", "label": "Bereich/Zone", "locked": false, "defaultWidth": null },
    { "key": "storage-area", "label": "Lagerort", "locked": false, "defaultWidth": null },
    { "key": "sage-locked", "label": "Sperre (Sage)", "locked": false, "defaultWidth": null },
    { "key": "capacity", "label": "Kapazität", "locked": false, "defaultWidth": null },
    { "key": "type", "label": "Typ", "locked": false, "defaultWidth": null },
    { "key": "source", "label": "Quelle", "locked": false, "defaultWidth": null },
    { "key": "bookable", "label": "Buchbar", "locked": false, "defaultWidth": null },
    { "key": "sage-buchung", "label": "Sage-Buchung", "locked": false, "defaultWidth": null },
    { "key": "is-active", "label": "Aktiv", "locked": false, "defaultWidth": null },
    { "key": "created-at", "label": "Erstellt am", "locked": false, "defaultWidth": null },
    { "key": "actions", "label": "", "locked": true, "defaultWidth": 100 }
]
</script>

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
}
