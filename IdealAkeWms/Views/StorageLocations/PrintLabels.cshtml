@model List<StorageLocation>
@inject IdealAkeWms.Data.Repositories.IAppSettingRepository AppSettings
@{
    ViewData["Title"] = "Lagerplatz-Etiketten";
    Layout = null;
    var labelsData = ViewBag.LabelsData as List<(StorageLocation Location, string BarcodeBase64)>;
    // v1.72.0: Standort-Schalter Rollenformat 93 x 55 mm (Default aus = A4 wie bisher). Hier gelesen, damit Sammel- und Einzeldruck
    // (beide rendern diese View) ohne Controller-Aenderung abgedeckt sind.
    var rolle = string.Equals(await AppSettings.GetValueAsync(AppSettingKeys.LagerplatzEtikettRolle93x55), "true", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <title>Lagerplatz-Etiketten</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #000;
            background: #fff;
        }

        .screen-controls {
            padding: 20px;
            text-align: center;
            background: #053153;
            color: #fff;
        }

        .screen-controls h2 {
            margin-bottom: 10px;
        }

        .screen-controls .btn {
            display: inline-block;
            padding: 10px 24px;
            margin: 5px;
            border: none;
            border-radius: 4px;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
            color: #fff;
        }

        .btn-print {
            background-color: #82BF6E;
        }

        .btn-back {
            background-color: #43A6E2;
        }

        .labels-container {
            padding: 10mm;
        }

        .label {
            width: 100%;
            height: 85mm;
            border: 2px solid #000;
            padding: 5mm;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            page-break-inside: avoid;
            overflow: hidden;
            margin-bottom: 5mm;
        }

        .page-break-after {
            page-break-after: always;
        }

        .label-code {
            font-size: 24pt;
            font-weight: 700;
            text-align: center;
            line-height: 1.2;
        }

        .label-description {
            font-size: 14pt;
            text-align: center;
            color: #333;
            line-height: 1.2;
            max-height: 12mm;
            overflow: hidden;
        }

        .label-barcode img {
            max-width: 100%;
            height: 25mm;
        }

        .label-zone {
            font-size: 12pt;
            text-align: center;
            color: #666;
        }

        @@media print {
            .screen-controls {
                display: none !important;
            }

            body {
                background: #fff;
            }

            .labels-container {
                padding: 0;
            }

            .label {
                margin-bottom: 3mm;
            }

            @@page {
                size: A4 portrait;
                margin: 10mm;
            }
        }
    </style>
    @if (rolle)
    {
        @* Rollenformat: steht NACH dem A4-Block und ist spezifischer (body.labels-rolle), der A4-Block bleibt unveraendert.
           Ein Etikett je Seite ueber break-before ab dem zweiten Etikett => keine leere Schlussseite (kein Letztes-Kind-Selektor, fallstricke §27). *@
        <style>
            body.labels-rolle .label {
                width: 93mm;
                height: 55mm;
                border: none;
                padding: 3mm;
                margin: 0 auto 5mm;
            }

            body.labels-rolle .label + .label {
                break-before: page;
                page-break-before: always;
            }

            body.labels-rolle .label-code {
                font-size: 18pt;
            }

            body.labels-rolle .label-description {
                font-size: 10pt;
                color: #000;
                max-height: 8.5mm;
            }

            /* Seitenverhaeltnis halten: height auto + max-height statt fester Hoehe (sonst verzerrt der Barcode auf 87 mm Breite). */
            body.labels-rolle .label-barcode img {
                height: auto;
                max-height: 20mm;
            }

            body.labels-rolle .label-zone {
                font-size: 9pt;
                color: #000;
            }

            body.labels-rolle .screen-hint {
                margin-top: 8px;
                font-size: 14px;
            }

            @@media print {
                body.labels-rolle .label {
                    margin: 0;
                }

                @@page {
                    size: 93mm 55mm;
                    margin: 0;
                }
            }
        </style>
    }
</head>
<body class="@(rolle ? "labels-rolle" : null)">
    <div class="screen-controls">
        <h2>Lagerplatz-Etiketten (@Model.Count Stück)</h2>
        <button class="btn btn-print" onclick="window.print()">Drucken</button>
        <a class="btn btn-back" href="/StorageLocations">Zurück</a>
        @if (rolle)
        {
            <p class="screen-hint">Rollenformat 93 × 55 mm: im Druckdialog den Rollendrucker wählen, Papierformat 93 × 55 mm, Ränder „Keine“.</p>
        }
    </div>

    <div class="labels-container">
        @if (labelsData != null)
        {
            int labelIndex = 0;
            @foreach (var (location, barcodeBase64) in labelsData)
            {
                labelIndex++;
                var isPageBreak = !rolle && labelIndex % 3 == 0 && labelIndex < labelsData.Count;
                <div class="label @(isPageBreak ? "page-break-after" : "")">
                    <div class="label-code">@location.Code</div>
                    @if (!string.IsNullOrEmpty(location.Description))
                    {
                        <div class="label-description">@location.Description</div>
                    }
                    <div class="label-barcode">
                        <img src="data:image/png;base64,@barcodeBase64" alt="@location.Code" />
                    </div>
                    @if (!string.IsNullOrEmpty(location.Zone))
                    {
                        <div class="label-zone">@location.Zone</div>
                    }
                </div>
            }
        }
    </div>
</body>
</html>
