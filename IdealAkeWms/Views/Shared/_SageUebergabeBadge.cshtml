@model IdealAkeWms.Models.SageUebergabeStatus
@* E9/F11: Zelle „Übergabe an Sage“. Text traegt die Bedeutung (Farbe nie allein). v1.79.0 F6: NichtNoetig (Bestand) als gedämpfter Text
   „nicht nötig“ statt leer (kein farbiges Badge, text-body-secondary erfüllt 4,5:1). Der Text muss SageUebergabeStatusText.Text entsprechen
   (Server-Spaltenfilter). *@
@{
    var text = IdealAkeWms.Models.SageUebergabeStatusText.Text(Model);
    var css = Model switch
    {
        IdealAkeWms.Models.SageUebergabeStatus.Offen => "bg-warning text-dark",
        IdealAkeWms.Models.SageUebergabeStatus.Fehler => "bg-danger",
        _ => "bg-success"
    };
}
@if (Model == IdealAkeWms.Models.SageUebergabeStatus.NichtNoetig)
{
    <span class="text-body-secondary">@text</span>
}
else
{
    <span class="badge @css">@text</span>
}
