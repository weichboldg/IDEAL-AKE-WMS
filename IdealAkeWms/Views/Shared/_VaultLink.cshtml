@model IdealAkeWms.Models.ViewModels.VaultLinkViewModel
@inject IdealAkeWms.Data.Repositories.IAppSettingRepository AppSettings
@*
    Vault-Zeichnungslink an einer Artikelnummer (v1.67.0). Schalter aus, Vorlage leer oder Nummer leer: KEINE Ausgabe —
    abgeschaltet wird nur hier serverseitig, nie ueber die Klasse vault-link (die traegt auch der Stuecklisten-Knopf in _FaDocumentLinks).
*@
@{
    var url = IdealAkeWms.Helpers.LinkVorlage.Build(
        await AppSettings.GetValueAsync(IdealAkeWms.Models.AppSettingKeys.VaultLinksAktiv),
        await AppSettings.GetValueAsync(IdealAkeWms.Models.AppSettingKeys.VaultLinkVorlage),
        IdealAkeWms.Helpers.LinkVorlage.PlatzhalterArtikelnummer, Model.ArticleNumber);
}
@if (url != null && Model.ShowLabel)
{
    <a href="@url" target="_blank" rel="noopener" class="vault-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
            <path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1 1 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4 4 0 0 1-.128-1.287z"/>
            <path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243z"/>
        </svg>
        Im VAULT öffnen
    </a>
}
else if (url != null)
{
    <a href="@url" target="_blank" rel="noopener" title="Zeichnung in Vault öffnen" class="vault-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
            <path d="M4.5 12.5A.5.5 0 0 1 5 12h3a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0-2A.5.5 0 0 1 5 10h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m1.639-3.708 1.33.886 1.854-1.855a.25.25 0 0 1 .289-.047l1.888.974V7.5a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5V7s1.54-1.274 1.639-1.208M6.25 6a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5"/>
        </svg>
    </a>
}
