@model IdealAkeWms.Models.ViewModels.ArtikelSageKartenViewModel
@*
    v1.85.0 (Spec 2026-11-08-artikeldetails-lieferanten-anzeigen, Nachbesserung 1/4/5): EIN Partial fuer Artikelinfo und „Artikel bearbeiten“ –
    Karte „Sage-Zusatzfelder“ (inkl. Mengeneinheiten) und Karte „Lieferanten“, nur lesend. Vorher (v1.80.0) Markup direkt in Articles/Info.cshtml.
*@
@if (Model.SageDetail is { } sd)
{
    // v1.73.0 E3a: nur lesend; erscheint erst, wenn der Artikel-Abgleich den Artikel ueber SData gelesen hat.
    string T(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
    string Z(decimal? v) => v?.ToString("0.###") ?? "—";
    string J(bool? v) => v is null ? "—" : v.Value ? "Ja" : "Nein";
    // v1.85.0 Nachbesserung 5: „1 <Einheit> = <Faktor> <Basiseinheit>“ – Umrechnung zur Basiseinheit, ohne Faktor nur die Einheit.
    string E(string? einheit, decimal? faktor, int? dezimal) => string.IsNullOrWhiteSpace(einheit) ? "—"
        : (faktor is { } f && sd.Basismengeneinheit is { } b && !string.Equals(einheit, b, StringComparison.OrdinalIgnoreCase)
            ? $"{einheit} (1 {einheit} = {f.ToString("0.######")} {b})" : einheit)
          + (dezimal is { } d ? $", {d} {(d == 1 ? "Nachkommastelle" : "Nachkommastellen")}" : "");
    // v1.85.0 Nachbesserung 4: ModifiedAt wechselt nur, wenn sich ein Wert aendert – kein „gelesen am“ (UTC gespeichert, lokal angezeigt).
    var geaendert = (sd.ModifiedAt ?? sd.CreatedAt).ToLocalTime();
    var gruppen = new (string Titel, (string Name, string Wert)[] Felder)[]
    {
        ("Stamm", new[] { ("Bezeichnung 2", T(sd.Bezeichnung2)), ("Hauptartikelgruppe", T(sd.Hauptartikelgruppe)),
            ("Vaterartikelgruppe", T(sd.Vaterartikelgruppe)), ("Hersteller", T(sd.Hersteller)),
            ("Hersteller-Artikelnr.", T(sd.HArtikelnummer)), ("Zeichnungsnummer", T(sd.Zeichnungsnummer)),
            ("Ersatzartikel", T(sd.Ersatzartikelnummer)), ("EAN", T(sd.EANNummer)) }),
        ("Mengeneinheiten", new[] { ("Basiseinheit", E(sd.Basismengeneinheit, null, sd.DezimalstellenBasis)),
            ("Lagereinheit", E(sd.Lagermengeneinheit, sd.UmrechnungsFaktorLME, sd.DezimalstellenLager)),
            ("Verkaufseinheit", E(sd.Verkaufsmengeneinheit, sd.UmrechnungsfaktorVK, sd.DezimalstellenVK)),
            ("Verpackungseinheit VK", E(sd.VerpackungseinheitVK, sd.UmrechnungsfaktorVPVK, null)) }),
        ("Lager", new[] { ("Lagerführung", J(sd.Lagerfuehrung)), ("Hauptlagerplatz (Sage-ID)", sd.SagePlatzId?.ToString() ?? "—"),
            ("Lagerplatz-ID (Benutzerfeld)", sd.UserLagerplatzId?.ToString() ?? "—"), ("Entnahmeverfahren", T(sd.Entnahmeverfahren)),
            ("Inventurmethode", sd.Inventurmethode?.ToString() ?? "—"),
            ("Chargenpflicht", sd.Chargenpflicht?.ToString() ?? "—"), ("Nachweispflicht", sd.Nachweispflicht?.ToString() ?? "—") }),
        ("Bestand und Dispo (Sage)", new[] { ("Lagerbestand", Z(sd.Lagerbestand)), ("Verfügbar", Z(sd.LagerbestandVerfuegbar)),
            ("Bestand ohne Dispo", Z(sd.LagerbestandOhneDispo)), ("Mindestbestand", Z(sd.UserMindestbestand)),
            ("Bestellmenge", Z(sd.Bestellmenge)), ("Bestellzeitpunkt", sd.Bestellzeitpunkt?.ToString() ?? "—"),
            ("Wiederbeschaffungszeit", sd.Wiederbeschaffungszeit?.ToString() ?? "—"), ("ABC-Klasse", T(sd.ABCKlasse)),
            ("Mittlerer EK", sd.MittlererEK?.ToString("0.####") ?? "—") }),
        ("Fertigung", new[] { ("Fertigungsartikel", J(sd.IstFertigungsartikel)), ("Unterbaugruppe", J(sd.IstUnterbaugruppe)),
            ("Stücklistentyp", sd.Stuecklistentyp?.ToString() ?? "—"), ("Schwundart", T(sd.Schwundart)), ("Schwund", Z(sd.Schwund)),
            ("Minimale Losgröße", Z(sd.MinimaleLosgroesse)), ("Maximale Losgröße", Z(sd.MaximaleLosgroesse)) }),
        ("Kennzeichen", new[] { ("Bestellartikel", J(sd.IstBestellartikel)), ("Ersatzteil", J(sd.IstErsatzteil)),
            ("Verschleißteil", J(sd.IstVerschleissteil)), ("Aktiv in Sage", J(sd.Aktiv)) }),
        ("Maße und Gewicht", new[] { ("Länge", Z(sd.Laenge)), ("Breite", Z(sd.Breite)), ("Höhe", Z(sd.Hoehe)),
            ("Gewicht", sd.Gewicht is null ? "—" : $"{Z(sd.Gewicht)} {sd.Gewichtseinheit}".Trim()) }),
    };
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong>Sage-Zusatzfelder</strong>
            <small class="opacity-75" title="Zeitpunkt, an dem der Artikel-Abgleich zuletzt einen Wert geändert hat (unveränderte Läufe ändern ihn nicht)">nur lesend · letzte Änderung durch den Artikel-Abgleich: @geaendert.ToString("dd.MM.yyyy HH:mm")</small>
        </div>
        <div class="card-body pt-1">
            @foreach (var g in gruppen)
            {
                <h3 class="h6 fw-semibold border-bottom pb-1 mt-3 mb-2">@g.Titel</h3>
                <dl class="row mb-0">
                    @foreach (var f in g.Felder)
                    {
                        <dt class="col-sm-5 fw-normal text-muted">@f.Name</dt>
                        <dd class="col-sm-7">@f.Wert</dd>
                    }
                </dl>
            }
            @if (!string.IsNullOrWhiteSpace(sd.Langtext))
            {
                <h3 class="h6 fw-semibold border-bottom pb-1 mt-3 mb-2">Langtext</h3>
                <p class="mb-0" style="white-space: pre-line">@sd.Langtext</p>
            }
        </div>
    </div>
}
else
{
    @* v1.80.0 (F3): Hinweis statt still ausgeblendeter Karte (ersetzt TS-106.3.d). *@
    <div class="card mb-3">
        <div class="card-header"><strong>Sage-Zusatzfelder</strong></div>
        <div class="card-body">
            <p class="mb-0 text-body-secondary">Für diesen Artikel liegen noch keine Sage-Zusatzfelder vor. Sie werden nur vom
                Artikel-Abgleich mit Quelle SData gefüllt (Service-Einstellung <code>Sync:Quelle:Artikel</code> = <code>SData</code>).</p>
        </div>
    </div>
}

@{
    // v1.80.0 F1/F2: Lieferant als „Name (Konto)“ mit Link auf die Kreditor-Details; ohne Kreditor nur das Konto; „– inaktiv“ als Text.
    void Lieferant(int? id, string? name, string? konto, bool aktiv)
    {
        if (id == null)
        {
            <text>@(string.IsNullOrWhiteSpace(konto) ? "—" : konto.Trim())</text>
            return;
        }
        <a href="@Url.Action("Details", "Creditors", new { id })">@name (@konto?.Trim())</a>
        if (!aktiv)
        {
            <span class="text-body-secondary">– inaktiv</span>
        }
    }
    var sdl = Model.SageDetail;
    var hk = Model.HauptlieferantKreditor;
    var lk = Model.LetzterLieferantKreditor;
    var basis = sdl?.Basismengeneinheit;
}
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <strong>Lieferanten</strong>
        <small class="opacity-75">nur lesend · aus Sage</small>
    </div>
    <div class="card-body">
        <dl class="row mb-2">
            <dt class="col-sm-5 fw-normal text-muted">Hauptlieferant</dt>
            <dd class="col-sm-7">@{ Lieferant(hk?.Id, hk?.Name, sdl?.Hauptlieferant, hk?.IsActive ?? true); }</dd>
            <dt class="col-sm-5 fw-normal text-muted">Letzter Lieferant</dt>
            <dd class="col-sm-7">@{ Lieferant(lk?.Id, lk?.Name, sdl?.LetzterLieferant, lk?.IsActive ?? true); }</dd>
        </dl>
        @if (Model.Lieferanten.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Lieferant</th>
                            <th>Bestellnummer</th>
                            <th class="text-end">Mindestbestellmenge</th>
                            <th>Bestelleinheit</th>
                            <th class="text-end">Wiederbeschaffungszeit (Tage)</th>
                            <th>Hauptlieferant</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Lieferanten)
                        {
                            <tr>
                                <td>@{ Lieferant(l.CreditorId, l.Name, l.SageKto, l.IsActive); }</td>
                                <td>@(l.SageBestellnummer ?? "—")</td>
                                <td class="text-end">@(l.Mindestbestellmenge?.ToString("0.###") ?? "—")</td>
                                <td>
                                    @(l.Einkaufsmengeneinheit ?? "—")
                                    @if (l.UmrechnungsfaktorEK is { } f && basis != null && l.Einkaufsmengeneinheit != null
                                         && !string.Equals(l.Einkaufsmengeneinheit, basis, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="small text-body-secondary">(1 @l.Einkaufsmengeneinheit = @f.ToString("0.######") @basis)</span>
                                    }
                                </td>
                                <td class="text-end">@(l.Wiederbeschaffungszeit?.ToString() ?? "—")</td>
                                <td>@(l.IstHauptlieferant ? "Ja" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="mb-0 text-body-secondary">Keine Artikel-Lieferanten aus Sage gelesen. Sie werden vom Lauf &bdquo;Artikel-Lieferanten&ldquo;
                gefüllt (Service-Einstellung <code>Sync:ArtikelLieferantEnabled</code>; braucht die Kreditoren aus Sage,
                <code>Sync:KreditorenEnabled</code>).</p>
        }
    </div>
</div>
