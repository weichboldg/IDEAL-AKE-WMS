@inject IdealAkeWms.Data.Repositories.IAppSettingRepository AppSettings
@inject IdealAkeWms.Services.Navigation.NavigationSicht Navigation
@using IdealAkeWms.Services.Navigation
@inject IdealAkeWms.Data.Repositories.IProductionOrderPickingStatusRepository PickingStatusRepository
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - IDEAL-AKE WMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/images/ideal-ake-logo.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
</head>
@{
    // Hardware-Barcodescanner (v1.66.0): nur bei exakt "true" Skript + Konfiguration ausliefern (Default aus, ADR 0011).
    var hwScanAktiv = string.Equals(await AppSettings.GetValueAsync(IdealAkeWms.Models.AppSettingKeys.HardwareScannerAktiv), "true", StringComparison.OrdinalIgnoreCase);
    // null-Attribute laesst Razor weg: bei Schalter aus traegt <body> keine data-hw-scan-*-Attribute (Mein Profil liest das).
    string? hwScanPraefix = null, hwScanAbstand = null;
    if (hwScanAktiv)
    {
        var hwP = await AppSettings.GetValueAsync(IdealAkeWms.Models.AppSettingKeys.HardwareScannerPraefix);
        var hwA = await AppSettings.GetValueAsync(IdealAkeWms.Models.AppSettingKeys.HardwareScannerMaxZeichenabstandMs);
        hwScanPraefix = string.IsNullOrEmpty(hwP) ? "~09" : hwP;
        hwScanAbstand = string.IsNullOrWhiteSpace(hwA) ? "50" : hwA.Trim();
    }
    // v1.68.0 QR erstes Feld: nur bei exakt "Matchcode" das Attribut (barcode-scanner.js), sonst weggelassen = Artikelnummer.
    var qrErstesFeld = string.Equals((await AppSettings.GetValueAsync(IdealAkeWms.Models.AppSettingKeys.QrErstesFeld))?.Trim(), "Matchcode",
        StringComparison.OrdinalIgnoreCase) ? "Matchcode" : null;
    // v1.69.0 QR-Trennzeichen: nur bei "," das Attribut (barcode-scanner.js, hardware-scanner.js), sonst weggelassen = ";".
    var qrTrennzeichen = (await AppSettings.GetValueAsync(IdealAkeWms.Models.AppSettingKeys.QrTrennzeichen))?.Trim() == "," ? "," : null;
}
<body data-hw-scan-praefix="@hwScanPraefix" data-hw-scan-abstand="@hwScanAbstand" data-qr-erstes-feld="@qrErstesFeld" data-qr-trennzeichen="@qrTrennzeichen">
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="navbar-logo-wrapper">
                        <img src="~/images/ideal-ake-logo.svg" alt="IDEAL-AKE WMS" height="28" />
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Navigation umschalten">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto flex-wrap">@* v1.94.0: Menuepunkte brechen um statt die Seite quer scrollen zu lassen *@
                        @{
                            // v1.99.45 (ADR 0034): Sichtbarkeit jedes Menuepunkts kommt aus EINER Quelle (NavigationSicht), dieselbe wie die Startseite.
                            var nav = await Navigation.GetAsync();
                            var releasedPickingCount = nav.LeitstandAktiv && nav.Zeigt(NavZiele.Kommissionierung) ? await PickingStatusRepository.GetReleasedForPickingCountAsync() : 0;
                            var divider = "border-color: rgba(255,255,255,0.2);";
                        }
                        @if (nav.ZeigtEines(NavZiele.Einbuchung, NavZiele.Bestaende, NavZiele.LagerplatzAusbuchen))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Lager
                                </a>
                                <ul class="dropdown-menu">
                                    @if (nav.Zeigt(NavZiele.Einbuchung))
                                    {
                                        <li><a class="dropdown-item" asp-controller="StockMovements" asp-action="Inbound">Einbuchung</a></li>
                                        @if (nav.Zeigt(NavZiele.MehrfachEinbuchung))
                                        {
                                            <li><a class="dropdown-item" asp-controller="StockMovements" asp-action="InboundBulk">Mehrfach-Einbuchung</a></li>
                                        }
                                        @if (nav.Zeigt(NavZiele.Ausbuchung))
                                        {
                                            <li><a class="dropdown-item" asp-controller="StockMovements" asp-action="Outbound">Ausbuchung</a></li>
                                        }
                                        @if (nav.Zeigt(NavZiele.Umbuchung))
                                        {
                                            <li><a class="dropdown-item" asp-controller="StockMovements" asp-action="Transfer">Umbuchung</a></li>
                                        }
                                        <li><hr class="dropdown-divider" style="@divider" /></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Bestaende))
                                    {
                                        <li><a class="dropdown-item" asp-controller="StockOverview" asp-action="Index">Bestände</a></li>
                                        @if (nav.Zeigt(NavZiele.Bewegungshistorie))
                                        {
                                            <li><a class="dropdown-item" asp-controller="StockMovements" asp-action="Index">Bewegungshistorie</a></li>
                                        }
                                    }
                                    @if (nav.Zeigt(NavZiele.OffeneBestellungenLager))
                                    {
                                        @* v1.84.0: Wareneingang aus Sage-Bestellungen (Feature-Gate WareneingangBestellungAktiv, Lesen stock_read). *@
                                        <li><hr class="dropdown-divider" style="@divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="PurchaseOrders" asp-action="Index">Offene Bestellungen</a></li>
                                        @if (nav.Zeigt(NavZiele.WareneingangZuBestellung))
                                        {
                                            <li><a class="dropdown-item" asp-controller="PurchaseOrders" asp-action="Receive">Wareneingang zu Bestellung</a></li>
                                        }
                                    }
                                    @* v1.99.66: eine Seite „Sage-Buchungen“ (Lagerbuchungen + Sage-Wareneingänge), Menüpunkt „Sage-Wareneingänge“ entfallen *@
                                    @if (nav.Zeigt(NavZiele.SageLagerbuchungen))
                                    {
                                        <li><hr class="dropdown-divider" style="@divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="SageBookingQueue" asp-action="Index">Sage-Buchungen</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.LagerplatzAusbuchen))
                                    {
                                        <li><hr class="dropdown-divider" style="@divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="StockMovements" asp-action="OutboundAll">Lagerplatz ausbuchen</a></li>
                                        @if (nav.Zeigt(NavZiele.LagerplatzUmbuchen))
                                        {
                                            <li><a class="dropdown-item" asp-controller="StockMovements" asp-action="LocationTransfer">Lagerplatz umbuchen</a></li>
                                        }
                                    }
                                </ul>
                            </li>
                        }
                        @* IDEAL Teil 4 + Ausbau Teil 4: Beschichtung — EIN Dropdown, beide Eintraege mit derselben Regel (v1.56.0). *@
                        @if (nav.ZeigtEines(NavZiele.BeschichtungVorschlagsliste, NavZiele.Beschichtungsauftraege))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @((ViewContext.RouteData.Values["controller"]?.ToString() is "FaHierarchyBeschichtung" or "Beschichtungsauftraege") ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Beschichtung
                                </a>
                                <ul class="dropdown-menu">
                                    @if (nav.Zeigt(NavZiele.BeschichtungVorschlagsliste))
                                    {
                                        <li><a class="dropdown-item" asp-controller="FaHierarchyBeschichtung" asp-action="Summiert">Vorschlagsliste</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Beschichtungsauftraege))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Beschichtungsauftraege" asp-action="Index">Aufträge</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @* IDEAL Teil 5: Vormontage-Listen *@
                        @if (nav.Zeigt(NavZiele.Vormontage))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FaHierarchyVormontage" ? "active" : "")"
                                   asp-controller="FaHierarchyVormontage" asp-action="Index">Vormontage</a>
                            </li>
                        }
                        @* Fertigungsauftraege — Dropdown (v1.22.0) *@
                        @if (nav.ZeigtEines(NavZiele.FaListe, NavZiele.FaStruktur, NavZiele.FaVervollstaendigen, NavZiele.FaAbarbeitungsliste))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @((ViewContext.RouteData.Values["controller"]?.ToString() is "ProductionOrders" or "FaHierarchy" or "FaCompletion" or "FaWorklist") ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Fertigungsaufträge
                                </a>
                                <ul class="dropdown-menu">
                                    @if (nav.Zeigt(NavZiele.FaListe))
                                    {
                                        <li><a class="dropdown-item" asp-controller="ProductionOrders" asp-action="Index">FA-Liste</a></li>
                                    }
                                    @* v1.99.60: FA-Struktur aus dem Hauptmenue hierher verschoben (Gerald 2026-11-23), Regel wie FA-Liste. *@
                                    @if (nav.Zeigt(NavZiele.FaStruktur))
                                    {
                                        <li><a class="dropdown-item" asp-controller="FaHierarchy" asp-action="Index">FA-Struktur</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.FaVervollstaendigen))
                                    {
                                        <li><a class="dropdown-item" asp-controller="FaCompletion" asp-action="Index">FA-Vervollständigen</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.FaAbarbeitungsliste))
                                    {
                                        <li><a class="dropdown-item" asp-controller="FaWorklist" asp-action="Index">FA-Abarbeitungsliste</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @* Leitstand — eigenes Hauptmenu (Freigabe + Priorisierung) *@
                        @if (nav.Zeigt(NavZiele.LeitstandKommissionierung))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "PickingLeitstand" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Leitstand
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="PickingLeitstand" asp-action="Index">Kommissionierung</a></li>
                                </ul>
                            </li>
                        }
                        @* Kommissionierung — Dropdown NUR wenn beide Eintraege verfuegbar sind
                           (Picking-Workflow + IDEAL-Kommissionierlisten, Teil 3). Steht nur einer
                           zur Verfuegung, bleibt es der bisherige einfache Nav-Link: ein
                           Ein-Eintrag-Dropdown waere fuer AKE ein zusaetzlicher Klick. *@
                        @if (nav.Zeigt(NavZiele.Kommissionierung) && nav.Zeigt(NavZiele.Kommissionierlisten))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @((ViewContext.RouteData.Values["controller"]?.ToString() is "Picking" or "FaHierarchyKommissionierListen") ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Kommissionierung
                                    @if (releasedPickingCount > 0)
                                    {
                                        <span class="badge rounded-pill" style="background-color: var(--ake-orange); font-size: 0.7em;">@releasedPickingCount</span>
                                    }
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Picking" asp-action="Index">Kommissionierung</a></li>
                                    <li><a class="dropdown-item" asp-controller="FaHierarchyKommissionierListen" asp-action="Summiert">Kommissionierlisten</a></li>
                                </ul>
                            </li>
                        }
                        else if (nav.Zeigt(NavZiele.Kommissionierung))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Picking" asp-action="Index">
                                    Kommissionierung
                                    @if (releasedPickingCount > 0)
                                    {
                                        <span class="badge rounded-pill" style="background-color: var(--ake-orange); font-size: 0.7em;">@releasedPickingCount</span>
                                    }
                                </a>
                            </li>
                        }
                        else if (nav.Zeigt(NavZiele.Kommissionierlisten))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FaHierarchyKommissionierListen" ? "active" : "")"
                                   asp-controller="FaHierarchyKommissionierListen" asp-action="Summiert">Kommissionierlisten</a>
                            </li>
                        }
                        @* v1.99.45: Dropdown nur, wenn mindestens ein Eintrag sichtbar ist (vorher leer moeglich) *@
                        @if (nav.ZeigtEines(NavZiele.Bedarfsmeldungen, NavZiele.Lagerbestellungen, NavZiele.LagerEingehendeListen))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @((ViewContext.RouteData.Values["controller"]?.ToString() is "PartRequisitions" or "WarehouseRequisitions" or "WarehousePicking" or "MissingParts" or "MissingPartsLager") ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Bestellungen
                                </a>
                                <ul class="dropdown-menu">
                                    @if (nav.Zeigt(NavZiele.Bedarfsmeldungen))
                                    {
                                        <li><a class="dropdown-item" asp-controller="PartRequisitions" asp-action="Index">Bedarfsmeldungen</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Lagerbestellungen))
                                    {
                                        <li><a class="dropdown-item" asp-controller="WarehouseRequisitions" asp-action="Index">Lagerbestellungen</a></li>
                                        @if (nav.Zeigt(NavZiele.MeineFehlteile))
                                        {
                                            <li><a class="dropdown-item" asp-controller="MissingParts" asp-action="Index">Meine Fehlteile</a></li>
                                        }
                                    }
                                    @if (nav.Zeigt(NavZiele.LagerEingehendeListen))
                                    {
                                        <li><hr class="dropdown-divider" style="@divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="WarehousePicking" asp-action="Index">Lager: Eingehende Listen</a></li>
                                        @if (nav.Zeigt(NavZiele.LagerFehlteile))
                                        {
                                            <li><a class="dropdown-item" asp-controller="MissingPartsLager" asp-action="Index">Lager: Fehlteile</a></li>
                                        }
                                    }
                                </ul>
                            </li>
                        }
                        @if (nav.Zeigt(NavZiele.Bestellvorschlaege))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() is "PurchaseProposals" or "EinkaufPurchaseOrders" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Einkauf
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="PurchaseProposals" asp-action="Index">Bestellvorschläge</a></li>
                                    @* v1.99.31: nur lesend, Gate nur EinkaufAktiv (wie das Dropdown) *@
                                    @if (nav.Zeigt(NavZiele.OffeneBestellungenEinkauf))
                                    {
                                        <li><a class="dropdown-item" asp-controller="EinkaufPurchaseOrders" asp-action="Index">Offene Bestellungen</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.SageWareneingaengeEinkauf))
                                    {
                                        <li><a class="dropdown-item" asp-controller="EinkaufPurchaseOrders" asp-action="SageWareneingaenge">Sage-Wareneingänge (offen)</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (nav.Zeigt(NavZiele.BfWarenkorb))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() is "BfAuftraege" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Blechfertigung
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="BfAuftraege" asp-action="Warenkorb">BF-Warenkorb</a></li>
                                    @if (nav.Zeigt(NavZiele.BfAuftraege))
                                    {
                                        <li><a class="dropdown-item" asp-controller="BfAuftraege" asp-action="Index">BF-Aufträge</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (nav.Zeigt(NavZiele.TeileverfolgungOseon))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Teileverfolgung
                                </a>
                                <ul class="dropdown-menu">
                                    @if (nav.Zeigt(NavZiele.TeileverfolgungRueckmeldungen))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Tracking" asp-action="Index">Rückmeldungen</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Tracking" asp-action="OseonIndex">OSEON Aufträge</a></li>
                                </ul>
                            </li>
                        }
                        @if (nav.Zeigt(NavZiele.BdeTerminal))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    BDE
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="BdeTerminal" asp-action="Index">Terminal</a></li>
                                    @if (nav.Zeigt(NavZiele.BdeCockpit))
                                    {
                                        <li><hr class="dropdown-divider" style="@divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="BdeCockpit" asp-action="Index">Cockpit</a></li>
                                        @if (nav.Zeigt(NavZiele.BdeBuchungen))
                                        {
                                            <li><a class="dropdown-item" asp-controller="BdeBookings" asp-action="Index">Buchungen</a></li>
                                        }
                                        @if (nav.Zeigt(NavZiele.BdeStammdaten))
                                        {
                                            <li><a class="dropdown-item" asp-controller="BdeMasterData" asp-action="Index">Stammdaten</a></li>
                                        }
                                    }
                                    @if (nav.Zeigt(NavZiele.BdeSchichtkalender))
                                    {
                                        <li><hr class="dropdown-divider" style="@divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="BdeShiftCalendar" asp-action="Index">Schichtkalender</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @* v1.99.45 Freigabe-Antwort 5: nur bei aktivem OSEON-Modul (TeileverfolgungAktiv) *@
                        @if (nav.Zeigt(NavZiele.OseonAgUebersicht))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Reporting
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="OseonReporting" asp-action="OperationsOverview">OSEON AG-Übersicht</a></li>
                                </ul>
                            </li>
                        }
                        @if (nav.Zeigt(NavZiele.Artikel))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Stammdaten
                                </a>
                                <ul class="dropdown-menu">
                                    @* masterdata_read + masterdata sichtbar *@
                                    <li><a class="dropdown-item" asp-controller="Articles" asp-action="Index">Artikel</a></li>
                                    @* v1.99.45: Artikelinfo auch im Menue (Freigabe-Antwort 3) *@
                                    @if (nav.Zeigt(NavZiele.Artikelinfo))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Articles" asp-action="Info">Artikelinfo</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Lagerplaetze))
                                    {
                                        <li><a class="dropdown-item" asp-controller="StorageLocations" asp-action="Index">Lagerplätze</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Werkbaenke))
                                    {
                                        <li><a class="dropdown-item" asp-controller="ProductionWorkplaces" asp-action="Index">Werkbänke</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Artikelkategorien))
                                    {
                                        <li><a class="dropdown-item" asp-controller="ArticleCategories" asp-action="Index">Artikelkategorien</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Artikelmerkmale))
                                    {
                                        <li><a class="dropdown-item" asp-controller="ArticleAttributes" asp-action="Index">Artikelmerkmale</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.FaVorbauAg))
                                    {
                                        <li><a class="dropdown-item" asp-controller="WorkSteps" asp-action="Index">FA-Vorbau-AG</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Kommissionierbereiche))
                                    {
                                        <li><a class="dropdown-item" asp-controller="PickingAreas" asp-action="Index">Kommissionierbereiche</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.FaMerkmale))
                                    {
                                        <li><a class="dropdown-item" asp-controller="FaAttributes" asp-action="Index">FA-Merkmale</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Kreditoren))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Creditors" asp-action="Index">Kreditoren</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.Debitoren))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Debitors" asp-action="Index">Debitoren</a></li>
                                    }
                                    @* v1.99.44: Empfaengergruppen nutzen Bedarfsmeldungen, Lager-/Glasbestellung und BF-Auftraege;
                                       die Artikelgruppen-Zuordnung nur die Bedarfsmeldungen (Regel in NavigationSicht). *@
                                    @if (nav.Zeigt(NavZiele.Empfaenger))
                                    {
                                        <li><a class="dropdown-item" asp-controller="OrderRecipients" asp-action="Index">Empfänger</a></li>
                                    }
                                    @if (nav.Zeigt(NavZiele.ArtikelgruppenZuordnung))
                                    {
                                        <li><a class="dropdown-item" asp-controller="OrderRecipients" asp-action="ArticleGroupMappings">Artikelgruppen-Zuordnung</a></li>
                                    }
                                    @* Admin-only Sub-Bloecke *@
                                    @if (nav.Zeigt(NavZiele.Benutzer))
                                    {
                                        <li><hr class="dropdown-divider" style="@divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Benutzer</a></li>
                                        @if (nav.Zeigt(NavZiele.Arbeitsplaetze))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Workstations" asp-action="Index">Arbeitsplätze</a></li>
                                        }
                                        @if (nav.Zeigt(NavZiele.Rollen))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">Rollen</a></li>
                                        }
                                        @* Arbeitsgang-Stammdaten (v1.54.0): Admin, unabhaengig von BdeAktiv — das BDE-Menue fehlt bei BDE aus. *@
                                        @if (nav.Zeigt(NavZiele.Arbeitsgaenge))
                                        {
                                            <li><a class="dropdown-item" asp-controller="OperationConfigs" asp-action="Index">Arbeitsgänge</a></li>
                                        }
                                        @* v1.99.38: Arbeitsgaenge in Sage-FAs anlegen - nur mit hierarchischen Produktionsauftraegen (IDEAL) *@
                                        @if (nav.Zeigt(NavZiele.ArbeitsgaengeSage))
                                        {
                                            <li><a class="dropdown-item" asp-controller="SageFaArbeitsgaenge" asp-action="Index">Arbeitsgänge → Sage</a></li>
                                        }
                                        <li><hr class="dropdown-divider" style="@divider" /></li>
                                        @if (nav.Zeigt(NavZiele.Einstellungen))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index">Einstellungen</a></li>
                                        }
                                        @if (nav.Zeigt(NavZiele.ServiceEinstellungen))
                                        {
                                            <li><a class="dropdown-item" asp-controller="ServiceSettings" asp-action="Index">Service-Einstellungen</a></li>
                                        }
                                        @if (nav.Zeigt(NavZiele.Standorteinstellungen))
                                        {
                                            <li><a class="dropdown-item" asp-controller="StandortEinstellungen" asp-action="Index">Standorteinstellungen</a></li>
                                        }
                                        @if (nav.Zeigt(NavZiele.AktivitaetsProtokoll))
                                        {
                                            <li><a class="dropdown-item" asp-controller="SyncLog" asp-action="Index">Aktivitaets-Protokoll</a></li>
                                        }
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    @* Desktop: user dropdown in navbar *@
                    <span class="user-info d-none d-lg-inline flex-shrink-0 text-nowrap">
                        @if (Context.Session.GetInt32("AppUserId").HasValue)
                        {
                            <div class="dropdown d-inline">
                                <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    @Context.Session.GetString("AppUserName")
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            Mein Profil
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">Abmelden</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <span>@User.Identity.Name</span>
                        }
                    </span>
                    @* Mobile: user info inside collapsed menu *@
                    <div class="navbar-user-mobile d-lg-none">
                        @if (Context.Session.GetInt32("AppUserId").HasValue)
                        {
                            <span class="text-white-50 small d-block mb-2">
                                Angemeldet als <strong class="text-white">@Context.Session.GetString("AppUserName")</strong>
                            </span>
                            <div class="d-flex gap-2">
                                <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-outline-light flex-fill">Mein Profil</a>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Abmelden</button>
                                </form>
                            </div>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-white-50 small">@User.Identity.Name</span>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-3 px-md-4 mt-3">
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container-fluid px-3 px-md-4 d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; @DateTime.Now.Year IDEAL-AKE WMS v@(IdealAkeWms.AppVersion.Version)</span>
            <div class="d-flex gap-3">
                <a asp-controller="Help" asp-action="Changelog" class="text-white-50">Aenderungen</a>
                <a asp-controller="Help" asp-action="Index" class="text-white-50">Hilfe</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* CSV-Export je table.filterable-table (v1.53.0, Opt-out data-csv-export="false") — vor den Seiten-Skripten, damit
       der Knopf vor dem Zahnrad im Toolbar-Host steht; die Sortierung liest window.tableFilterCompareValues erst beim Klick. *@
    <script src="~/js/csv-export.js" asp-append-version="true"></script>
    @* Spaltenfilter-Suchsyntax (v1.58.0): reiner Kern, VOR den Seiten-Skripten (table-filter.js u. a. nutzen ihn). *@
    <script src="~/js/column-filter-syntax.js" asp-append-version="true"></script>
    @if (hwScanAktiv)
    {
        @* Hardware-Scanner (v1.66.0): vor den Seiten-Skripten, damit das Ereignis 'wms:hardware-scan' steht, bevor barcode-scanner.js lauscht. *@
        <script src="~/js/hardware-scanner.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
