@model LoginViewModel
@{
    ViewData["Title"] = "Anmeldung";
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IDEAL-AKE WMS - Anmeldung</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, var(--ake-primary) 0%, #0a4a7a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .login-card {
            max-width: 420px;
            width: 100%;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        .login-header {
            background-color: var(--ake-primary);
            color: white;
            text-align: center;
            padding: 0.75rem 1.5rem;
            border-radius: 12px 12px 0 0;
        }
        .login-header small {
            opacity: 0.7;
        }
        .login-body {
            padding: 2rem 1.5rem;
            background: white;
            border-radius: 0 0 12px 12px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <small>Lagerverwaltung</small>
        </div>
        <div class="login-body">
            <div class="text-center mb-4">
                <img src="~/images/ideal-ake-logo.svg" alt="IDEAL-AKE WMS" style="max-width: 240px; width: 100%;" />
            </div>
            @{
                bool windowsAuthAktiv = ViewBag.WindowsAuthAktiv == true;
                bool entwicklungsmodus = ViewBag.Entwicklungsmodus == true;
            }
            @if (entwicklungsmodus)
            {
                <div class="alert alert-warning small" role="note">
                    <strong>Entwicklungsmodus:</strong> Anmeldung ohne Kennwort erlaubt (nur <code>dotnet run</code>, nie unter IIS).
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            @if (Model.KennwortFestlegen)
            {
                <h1 class="h5 mb-2">Neues Kennwort festlegen</h1>
                <div class="alert alert-info small" role="status">
                    Ihr Kennwort wurde vom Administrator vergeben. Bitte jetzt ein eigenes Kennwort festlegen.
                </div>
                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <input type="hidden" name="KennwortFestlegen" value="true" />

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Benutzer</label>
                        <input asp-for="UserName" class="form-control form-control-lg" readonly />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Bisheriges Kennwort</label>
                        <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" required autofocus />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Neues Kennwort</label>
                        <input asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" required />
                    </div>
                    <div class="mb-4">
                        <label asp-for="NewPasswordRepeat" class="form-label">Neues Kennwort wiederholen</label>
                        <input asp-for="NewPasswordRepeat" class="form-control form-control-lg" autocomplete="new-password" required />
                        <small class="form-text text-muted">Das neue Kennwort muss sich vom bisherigen unterscheiden.</small>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Kennwort ändern und anmelden</button>
                </form>
                <div class="text-center mt-3">
                    <a asp-action="Login" class="btn btn-link">Abbrechen</a>
                </div>
            }
            else
            {
                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Benutzer</label>
                        <input asp-for="UserName" class="form-control form-control-lg"
                               placeholder="Benutzername eingeben"
                               autocomplete="username" autocapitalize="off" autocorrect="off"
                               spellcheck="false" autofocus />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Passwort</label>
                        <input asp-for="Password" class="form-control form-control-lg" placeholder="Passwort eingeben" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <small class="form-text text-muted">@(windowsAuthAktiv ? "Kein Kennwort? Mit Windows anmelden oder beim Administrator melden." : "Kein Kennwort? Beim Administrator melden.")</small>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Anmelden</button>
                </form>
                @if (windowsAuthAktiv)
                {
                    <div class="text-center mt-3">
                        <div class="text-muted small mb-2">oder</div>
                        <a asp-controller="Account" asp-action="WindowsLogin"
                           class="btn btn-outline-primary btn-lg w-100">Mit Windows anmelden</a>
                    </div>
                }
            }
            <div class="text-center text-muted small mt-4">IDEAL-AKE WMS v@(IdealAkeWms.AppVersion.Version)</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
