@model IdealAkeWms.Models.ViewModels.FaHierarchyBeschichtungSummiertViewModel
@using IdealAkeWms.Models
@using IdealAkeWms.Services
@{
    ViewData["Title"] = "Vorschlagsliste Beschichtung (IDEAL)";
    const int colCount = 9; // HauptFA, Haupt-Artnr., Artnr., Matchcode, Breite, Höhe, Tiefe, Positionen, Summe Sollmenge
    // Print-URL: exakt dieselben Query-Parameter (colf_*) wie die Bildschirmansicht.
    var printUrl = Url.Action("PrintSummiert") + Context.Request.QueryString.ToString();
    // PDF je Gruppe: dieselben Query-Parameter wie der Bildschirmdruck; hauptFa ist Routen-Segment.
    var pdfQuery = Context.Request.QueryString.ToString();
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <h2 class="page-header">Vorschlagsliste Beschichtung (IDEAL)</h2>
    <div class="d-flex gap-2 mt-1">
        <a href="@printUrl" target="_blank" class="btn btn-sm btn-outline-secondary" data-print-link="FaHierarchyBeschichtungSummiert" title="Aktuell gefilterte Summe drucken (ein Ausdruck je HauptFA)">
            Drucken
        </a>
    </div>
</div>

@* Ansicht-Umschaltung (Liste = Einzelpositionen / Summiert = Standard). Der Umschalter nimmt die gemeinsamen
   Spaltenfilter mit (BuildToggleQuery), bewusst nicht colf_sollmenge (Einzel- vs. Summenwert). *@
<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link" href="@(Url.Action("Index") + BeschichtungsauftragService.BuildToggleQuery(Context.Request))">Liste</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" href="@(Url.Action("Summiert") + BeschichtungsauftragService.BuildToggleQuery(Context.Request))">Summiert</a>
    </li>
</ul>

@* Filterkarte (ADR 0005): fest Beschichtet == true; Verfeinerung ueber die Server-Spaltenfilter je <th>. *@
<div class="card filter-card mb-3">
    <div class="card-body py-2">
        <p class="mb-0 small text-muted">
            Je <strong>HauptFA</strong> nach <strong>Artikelnummer</strong> summierte <em>Sollmenge</em> aller
            beschichteten Positionen (<code>Beschichtet == true</code>, alle Struktur-Ebenen). Maße stammen aus
            der ersten Position; weichen sie innerhalb einer Zeile ab, steht dort „Maße uneinheitlich".
            Verfeinerung über die Spaltenfilter je Spalte.
        </p>
    </div>
</div>

@* Toolbar-Host fuer den column-preferences-Zahnrad-Button: MUSS ein immer sichtbares, leeres Element direkt vor
   .table-responsive sein. Zwischen Host und .table-responsive NICHTS einfuegen — Hinweise gehoeren DARUEBER
   (fallstricke §19; Waechter FaHierarchyBeschichtungSummiertZahnradHostTests). *@
<div class="d-flex justify-content-end mb-1"></div>
<div class="table-responsive">
    <table class="table table-sm table-striped mb-0 filterable-table" data-view-key="FaHierarchyBeschichtungSummiert" data-server-column-filter="true">
        <thead>
            <tr>
                <th data-filterable data-col-key="hauptfa">HauptFA</th>
                <th data-filterable data-col-key="hauptartnr">Haupt-Artnr.</th>
                <th data-filterable data-col-key="artnr">Artnr.</th>
                <th data-filterable data-col-key="matchcode">Matchcode</th>
                <th class="text-end" data-filterable data-filter-type="number" data-col-key="breite">Breite</th>
                <th class="text-end" data-filterable data-filter-type="number" data-col-key="hoehe">Höhe</th>
                <th class="text-end" data-filterable data-filter-type="number" data-col-key="tiefe">Tiefe</th>
                <th class="text-end" data-filterable data-filter-type="number" data-col-key="positionen">Positionen</th>
                <th class="text-end" data-filterable data-filter-type="number" data-col-key="sollmenge">Summe Sollmenge</th>
            </tr>
        </thead>
        @if (!Model.Rows.Any())
        {
            <tbody>
                <tr>
                    <td colspan="@colCount" class="text-center text-muted py-4">Keine beschichteten Positionen für die aktuelle Filterung gefunden.</td>
                </tr>
            </tbody>
        }
        else
        {
            @* Je HauptFA-Gruppe ein eigenes <tbody>: Gruppen bleiben visuell zusammen, analog Index.cshtml. *@
            @foreach (var group in Model.Rows.GroupBy(r => r.HauptFA))
            {
                <tbody class="fa-besch-group">
                    <tr class="table-active">
                        <td colspan="@colCount">
                            <strong>HauptFA @group.Key</strong>
                            @if (Model.PdfVerfuegbar)
                            {
                                <a href="@(Url.Action("PdfSummiert", new { hauptFa = group.Key }) + pdfQuery)"
                                   class="btn btn-sm btn-outline-secondary ms-2 py-0"
                                   data-print-link="FaHierarchyBeschichtungSummiert"
                                   title="PDF dieser HauptFA-Gruppe herunterladen">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" class="me-1" style="vertical-align: -2px;"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/><path d="M4.603 12.087a.8.8 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.7 7.7 0 0 1 1.482-.645 20 20 0 0 0 1.062-2.227 7.3 7.3 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.187-.012.395-.047.614-.084.51-.27 1.134-.52 1.794a11 11 0 0 0 .98 1.686 5.8 5.8 0 0 1 1.334.05c.364.065.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.86.86 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.7 5.7 0 0 1-.911-.95 11.6 11.6 0 0 0-1.997.406 11.3 11.3 0 0 1-1.021 1.51c-.29.35-.608.655-.926.787a.8.8 0 0 1-.58.029"/></svg>PDF
                                </a>
                            }
                            <partial name="_BeschichtungKopf" model="Model.OrderInfos.GetValueOrDefault(group.Key) ?? new List<FaHierarchyOrderInfo>()" />
                            <partial name="_VorschlagAuftraege" model='(group.Key, Model.Vergaben.GetValueOrDefault(group.Key) ?? BeschichtungsauftragVergabeInfo.Leer, Model.DarfSchreiben, "Summiert")' />
                        </td>
                    </tr>
                    @foreach (var row in group)
                    {
                        <tr>
                            <td>@row.HauptFA</td>
                            <td>@row.HauptArtnr</td>
                            <td>@row.Artnr</td>
                            <td>
                                @row.Matchcode
                                @if (row.MasseUneinheitlich)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="Die Maße der @row.PositionCount Positionen dieser Zeile sind nicht gleich — angezeigt werden die der ersten Position. Strukturdaten prüfen.">Maße uneinheitlich</span>
                                }
                            </td>
                            <td class="text-end">@BeschichtungsauftragService.FormatMass(row.Breite)</td>
                            <td class="text-end">@BeschichtungsauftragService.FormatMass(row.Hoehe)</td>
                            <td class="text-end">@BeschichtungsauftragService.FormatMass(row.Tiefe)</td>
                            <td class="text-end">@row.PositionCount</td>
                            <td class="text-end">@BeschichtungsauftragService.FormatMenge(row.SummeSollmenge)</td>
                        </tr>
                    }
                </tbody>
            }
        }
    </table>
</div>

<partial name="_Pagination" model="Model.Pagination" />

<script type="application/json" id="view-config">
{ "viewKey": "FaHierarchyBeschichtungSummiert", "supportsReorder": true, "supportsSortDefault": false }
</script>
<script type="application/json" id="column-config">
[
    { "key": "hauptfa", "label": "HauptFA", "locked": true, "defaultWidth": null },
    { "key": "hauptartnr", "label": "Haupt-Artnr.", "locked": false, "defaultWidth": null },
    { "key": "artnr", "label": "Artnr.", "locked": false, "defaultWidth": null },
    { "key": "matchcode", "label": "Matchcode", "locked": true, "defaultWidth": null },
    { "key": "breite", "label": "Breite", "locked": false, "defaultWidth": 55 },
    { "key": "hoehe", "label": "Höhe", "locked": false, "defaultWidth": 55 },
    { "key": "tiefe", "label": "Tiefe", "locked": false, "defaultWidth": 55 },
    { "key": "positionen", "label": "Positionen", "locked": false, "defaultWidth": 55 },
    { "key": "sollmenge", "label": "Summe Sollmenge", "locked": false, "defaultWidth": 55 }
]
</script>

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
    <script src="~/js/print-visible-columns.js" asp-append-version="true"></script>
}
