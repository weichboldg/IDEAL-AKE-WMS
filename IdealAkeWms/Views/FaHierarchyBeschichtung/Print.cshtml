@model IdealAkeWms.Models.ViewModels.FaHierarchyBeschichtungPrintViewModel
@using System.Globalization
@using IdealAkeWms.Services
@{
    Layout = null;
    var deCulture = CultureInfo.GetCultureInfo("de-DE");
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <title>Beschichtungsauftrag (IDEAL)</title>
    @* CSS bewusst eingebettet (kein externer Verweis), damit dieses Markup spaeter unveraendert von
       der separaten PDF-Erzeugungs-Spec wiederverwendet werden kann. *@
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; color: #000; background: #fff; padding: 20px; font-size: 11px; }
        .screen-controls { padding: 15px; text-align: center; background: #053153; color: #fff; margin: -20px -20px 20px -20px; }
        .screen-controls button { background: #fff; color: #053153; border: none; padding: 8px 24px; font-size: 16px; cursor: pointer; border-radius: 4px; margin: 0 5px; }
        .ambiguous-banner { border: 1px solid #b8860b; background: #fff8e1; color: #7a5900; padding: 8px 10px; margin-top: 6px; font-size: 10px; }
        .fa-group { page-break-after: always; }
        .fa-group:last-child { page-break-after: auto; }
        .group-head { border-bottom: 2px solid #053153; padding-bottom: 8px; margin-bottom: 10px; }
        .group-head h1 { font-size: 18px; color: #053153; }
        .barcode img { height: 22mm; max-width: 100%; }
        .head-table { width: 100%; border-collapse: collapse; margin-top: 6px; }
        .head-table th, .head-table td { border: 1px solid #aaa; padding: 3px 5px; text-align: left; font-size: 10px; }
        .head-table th { background: #eef2f6; }
        table.positions { width: 100%; border-collapse: collapse; margin-top: 10px; }
        table.positions th, table.positions td { border: 1px solid #888; padding: 4px 6px; text-align: left; }
        table.positions th { background: #f0f0f0; }
        .text-end { text-align: right; }
        .note { color: #555; font-size: 10px; margin-top: 4px; }
        @@media print { .screen-controls { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    <div class="screen-controls">
        <button onclick="window.print()">Drucken</button>
        <button onclick="window.close()">Schliessen</button>
    </div>

    @if (!Model.Groups.Any())
    {
        <p style="padding: 20px; text-align: center; color: #555;">
            Keine beschichteten Positionen für die aktuelle Filterung — nichts zu drucken.
        </p>
    }
    else
    {
        @foreach (var group in Model.Groups)
        {
            <div class="fa-group">
                <div class="group-head">
                    <h1>Beschichtungsauftrag — HauptFA @group.HauptFA</h1>
                    <div class="barcode">
                        @if (Model.Barcodes.TryGetValue(group.HauptFA, out var bc))
                        {
                            <img src="data:image/png;base64,@bc" alt="@group.HauptFA" />
                        }
                    </div>
                    @if (group.IsAmbiguous)
                    {
                        <div class="ambiguous-banner">
                            <strong>Achtung — mehrdeutig:</strong> Zu diesem HauptFA existieren
                            @group.OrderInfos.Count Kopfzeilen (Kombinationsgerät). Dienstleister, RAL
                            und Termine sind nicht eindeutig — alle Varianten sind unten aufgeführt.
                            Vor dem Transport von Hand prüfen, welcher Dienstleister/RAL gilt.
                        </div>
                    }
                    @if (group.OrderInfos.Any())
                    {
                        <table class="head-table">
                            <thead>
                                <tr>
                                    <th>Dienstleister</th>
                                    <th>RAL</th>
                                    <th>Start Beschichtung</th>
                                    <th>Retour</th>
                                    <th>AB-Nr.</th>
                                    <th>Pos</th>
                                    <th>Montage-Abt.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var info in group.OrderInfos)
                                {
                                    <tr>
                                        <td>@info.Dienstleister</td>
                                        <td>@info.RAL</td>
                                        <td>@(info.Start_Beschichtung?.ToString("dd.MM.yyyy") ?? "—")</td>
                                        <td>@(info.Beschichten_Retour?.ToString("dd.MM.yyyy") ?? "—")</td>
                                        <td>@info.ABNr</td>
                                        <td>@info.Pos</td>
                                        <td>@info.MontageAbteilung</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="note">Keine Auftrags-Kopfdaten (Dienstleister/RAL/Termine) zu diesem HauptFA.</div>
                    }
                </div>

                <table class="positions">
                    <thead>
                        <tr>
                            <th>Haupt-Artnr.</th>
                            <th>Artnr.</th>
                            <th>Matchcode</th>
                            <th class="text-end">Sollmenge</th>
                            <th>Beschichtet</th>
                            <th class="text-end">Breite</th>
                            <th class="text-end">Höhe</th>
                            <th class="text-end">Tiefe</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pos in group.Positions)
                        {
                            <tr>
                                <td>@pos.HauptArtnr</td>
                                <td>@pos.Artnr</td>
                                <td>@pos.Matchcode</td>
                                <td class="text-end">@BeschichtungsauftragService.FormatMenge(pos.Sollmenge)</td>
                                <td>@(pos.Beschichtet ? "Ja" : "Nein")</td>
                                <td class="text-end">@BeschichtungsauftragService.FormatMass(pos.Breite)</td>
                                <td class="text-end">@BeschichtungsauftragService.FormatMass(pos.Hoehe)</td>
                                <td class="text-end">@BeschichtungsauftragService.FormatMass(pos.Tiefe)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</body>
</html>
