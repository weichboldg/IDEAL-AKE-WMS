@model IdealAkeWms.Models.ViewModels.FaHierarchyBeschichtungListViewModel
@using System.Globalization
@using IdealAkeWms.Services
@{
    ViewData["Title"] = "Beschichtungsauftrag (IDEAL)";
    var deCulture = CultureInfo.GetCultureInfo("de-DE");
    // Print-URL: exakt dieselben Query-Parameter (colf_*) wie die Bildschirmliste.
    var printUrl = Url.Action("Print") + Context.Request.QueryString.ToString();
    // PDF je Gruppe: dieselben Query-Parameter wie der Bildschirmdruck (colf_*); hauptFa ist Routen-Segment.
    var pdfQuery = Context.Request.QueryString.ToString();
    const int colCount = 9; // Anzahl der Positionsspalten (colspan der Gruppen-Kopfzeile)
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <h2 class="page-header">Beschichtungsauftrag (IDEAL)</h2>
    <div class="d-flex gap-2 mt-1">
        <a href="@printUrl" target="_blank" class="btn btn-sm btn-outline-secondary" title="Aktuell gefilterte Liste drucken (ein Ausdruck je HauptFA)">
            Drucken
        </a>
    </div>
</div>

@* Filterkarte (ADR 0005): Teil 4 filtert fest auf Beschichtet == true; kein Ziel-Dropdown.
   Die eigentliche Verfeinerung erfolgt ueber die Server-Spaltenfilter je <th>. *@
<div class="card filter-card mb-3">
    <div class="card-body py-2">
        <p class="mb-0 small text-muted">
            Zeigt alle beschichteten Positionen (<code>Beschichtet == true</code>) über alle
            Struktur-Ebenen, gruppiert nach HauptFA. Verfeinerung über die Spaltenfilter je Spalte.
        </p>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped mb-0 filterable-table" data-view-key="FaHierarchyBeschichtung" data-server-column-filter="true">
        <thead>
            <tr>
                <th data-filterable data-col-key="hauptfa">HauptFA</th>
                <th data-filterable data-col-key="hauptartnr">Haupt-Artnr.</th>
                <th data-filterable data-col-key="artnr">Artnr.</th>
                <th data-filterable data-col-key="matchcode">Matchcode</th>
                <th class="text-end" data-filterable data-col-key="sollmenge">Sollmenge</th>
                <th data-filterable data-col-key="beschichtet">Beschichtet</th>
                <th class="text-end" data-filterable data-col-key="breite">Breite</th>
                <th class="text-end" data-filterable data-col-key="hoehe">Höhe</th>
                <th class="text-end" data-filterable data-col-key="tiefe">Tiefe</th>
            </tr>
        </thead>
        @if (!Model.Groups.Any())
        {
            <tbody>
                <tr>
                    <td colspan="@colCount" class="text-center text-muted py-4">Keine beschichteten Positionen gefunden.</td>
                </tr>
            </tbody>
        }
        else
        {
            @* Je HauptFA-Gruppe ein eigenes <tbody>: Gruppen bleiben visuell zusammen, und der
               client-seitige Sort aus table-filter.js kann Zeilen nie ueber Gruppengrenzen mischen. *@
            @foreach (var group in Model.Groups)
            {
                <tbody class="fa-besch-group">
                    <tr class="table-active">
                        <td colspan="@colCount">
                            <strong>HauptFA @group.HauptFA</strong>
                            @if (Model.PdfVerfuegbar)
                            {
                                <a href="@(Url.Action("Pdf", new { hauptFa = group.HauptFA }) + pdfQuery)"
                                   class="btn btn-sm btn-outline-secondary ms-2 py-0"
                                   title="PDF dieser HauptFA-Gruppe herunterladen">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" class="me-1" style="vertical-align: -2px;"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/><path d="M4.603 12.087a.8.8 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.7 7.7 0 0 1 1.482-.645 20 20 0 0 0 1.062-2.227 7.3 7.3 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.187-.012.395-.047.614-.084.51-.27 1.134-.52 1.794a11 11 0 0 0 .98 1.686 5.8 5.8 0 0 1 1.334.05c.364.065.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.86.86 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.7 5.7 0 0 1-.911-.95 11.6 11.6 0 0 0-1.997.406 11.3 11.3 0 0 1-1.021 1.51c-.29.35-.608.655-.926.787a.8.8 0 0 1-.58.029"/></svg>PDF
                                </a>
                            }
                            @if (group.IsAmbiguous)
                            {
                                <span class="badge bg-warning text-dark ms-2" title="Mehrere Kopfzeilen (Kombigerät) — Dienstleister/RAL/Termine mehrdeutig, von Hand prüfen">
                                    mehrdeutig (mehrere Kopfzeilen)
                                </span>
                            }
                            @if (group.OrderInfos.Any())
                            {
                                <span class="text-muted small ms-2">
                                    @foreach (var info in group.OrderInfos)
                                    {
                                        <span class="me-3">
                                            @(!string.IsNullOrWhiteSpace(info.Dienstleister) ? info.Dienstleister : "— Dienstleister?")
                                            @if (!string.IsNullOrWhiteSpace(info.RAL)) { <text> · RAL @info.RAL</text> }
                                            @if (info.Start_Beschichtung.HasValue) { <text> · Start @info.Start_Beschichtung.Value.ToString("dd.MM.yyyy")</text> }
                                            @if (info.Beschichten_Retour.HasValue) { <text> · Retour @info.Beschichten_Retour.Value.ToString("dd.MM.yyyy")</text> }
                                            @if (!string.IsNullOrWhiteSpace(info.ABNr)) { <text> · AB @info.ABNr</text> }
                                            @if (!string.IsNullOrWhiteSpace(info.Pos)) { <text> / @info.Pos</text> }
                                            @if (!string.IsNullOrWhiteSpace(info.MontageAbteilung)) { <text> · @info.MontageAbteilung</text> }
                                        </span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small ms-2">Keine Auftrags-Kopfdaten zu diesem HauptFA.</span>
                            }
                        </td>
                    </tr>
                    @foreach (var pos in group.Positions)
                    {
                        <tr>
                            <td>@pos.HauptFA</td>
                            <td>@pos.HauptArtnr</td>
                            <td>@pos.Artnr</td>
                            <td>@pos.Matchcode</td>
                            <td class="text-end">@BeschichtungsauftragService.FormatMenge(pos.Sollmenge)</td>
                            <td>@(pos.Beschichtet ? "Ja" : "Nein")</td>
                            <td class="text-end">@BeschichtungsauftragService.FormatMass(pos.Breite)</td>
                            <td class="text-end">@BeschichtungsauftragService.FormatMass(pos.Hoehe)</td>
                            <td class="text-end">@BeschichtungsauftragService.FormatMass(pos.Tiefe)</td>
                        </tr>
                    }
                </tbody>
            }
        }
    </table>
</div>

<partial name="_Pagination" model="Model.Pagination" />

<script type="application/json" id="view-config">
{ "viewKey": "FaHierarchyBeschichtung", "supportsReorder": true, "supportsSortDefault": true }
</script>
<script type="application/json" id="column-config">
[
    { "key": "hauptfa", "label": "HauptFA", "locked": true, "defaultWidth": null },
    { "key": "hauptartnr", "label": "Haupt-Artnr.", "locked": false, "defaultWidth": null },
    { "key": "artnr", "label": "Artnr.", "locked": false, "defaultWidth": null },
    { "key": "matchcode", "label": "Matchcode", "locked": true, "defaultWidth": null },
    { "key": "sollmenge", "label": "Sollmenge", "locked": false, "defaultWidth": 55 },
    { "key": "beschichtet", "label": "Beschichtet", "locked": false, "defaultWidth": null },
    { "key": "breite", "label": "Breite", "locked": false, "defaultWidth": 55 },
    { "key": "hoehe", "label": "Höhe", "locked": false, "defaultWidth": 55 },
    { "key": "tiefe", "label": "Tiefe", "locked": false, "defaultWidth": 55 }
]
</script>

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
}
