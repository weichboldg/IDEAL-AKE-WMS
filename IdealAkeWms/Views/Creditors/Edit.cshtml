@model Creditor
@{
    ViewData["Title"] = "Kreditor bearbeiten";
}

<h2 class="page-header">Kreditor bearbeiten</h2>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <partial name="_Form" model="Model" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Speichern</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Abbrechen</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
