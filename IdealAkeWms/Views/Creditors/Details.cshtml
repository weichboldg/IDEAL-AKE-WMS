@model Creditor
@using IdealAkeWms.Controllers
@inject IdealAkeWms.Services.ICurrentUserService _user
@inject IdealAkeWms.Data.Repositories.ISyncLogRepository _syncLogs
@{
    ViewData["Title"] = "Kreditor " + (Model.ShortName ?? Model.Name);
    var canEdit = await _user.HasMasterDataAccessAsync();
    string Text(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
    // Stand des Lese-Abgleichs Kontokorrent (E8c): letzter Protokolleintrag des Laufs, unabhaengig vom Datensatz.
    var letzterLauf = (await _syncLogs.GetRecentAsync(IdealAkeWms.Services.SyncLogger.SyncLogServices.Kreditoren, null, 1)).FirstOrDefault();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="page-header mb-0">
        @(Model.ShortName ?? Model.Name)
        @if (!Model.IsActive)
        {
            <span class="badge bg-secondary align-middle fs-6">Inaktiv</span>
        }
    </h2>
    <div class="d-flex flex-wrap gap-2">
        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Bearbeiten</a>
            @if (Model.Source != StorageLocationSource.Sage) @* G6: bei Herkunft Sage kommt aktiv/inaktiv aus Sage *@
            {
            <form asp-action="SetActive" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="active" value="@(Model.IsActive ? "false" : "true")" />
                @if (Model.IsActive)
                {
                    <button type="submit" class="btn btn-outline-danger">Deaktivieren</button>
                }
                else
                {
                    <button type="submit" class="btn btn-outline-success">Reaktivieren</button>
                }
            </form>
            }
        }
        <a asp-action="Index" class="btn btn-secondary">Zur Liste</a>
    </div>
</div>

@if (!canEdit)
{
    <div class="alert alert-info small">Sie haben Nur-Lesen-Zugriff. Aenderungen sind nicht moeglich.</div>
}

@if (Model.SageMissingSince.HasValue)
{
    <div class="alert alert-warning small" role="alert">
        <span class="badge bg-warning text-dark border border-dark me-1">Nicht in Sage</span>
        Das Sage-Konto fehlt seit <strong>@Model.SageMissingSince.Value.ToString("dd.MM.yyyy")</strong> in Sage.
    </div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Stammdaten</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Kurzname</dt><dd class="col-sm-8">@Text(Model.ShortName)</dd>
                    <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Text(Model.Name)</dd>
                    <dt class="col-sm-4">Matchcode</dt><dd class="col-sm-8">@Text(Model.Matchcode)</dd>
                    <dt class="col-sm-4">Adresse</dt>
                    <dd class="col-sm-8">
                        @Text(Model.Street)<br />
                        @Text(CreditorsController.ColumnMap["city"](Model))<br />
                        @Text(Model.Country)
                    </dd>
                    <dt class="col-sm-4">Ansprechpartner</dt><dd class="col-sm-8">@Text(Model.ContactPerson)</dd>
                    <dt class="col-sm-4">Telefon</dt><dd class="col-sm-8">@Text(Model.Phone)</dd>
                    <dt class="col-sm-4">E-Mail</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrWhiteSpace(Model.Email)) { <text>—</text> } else { <a href="mailto:@Model.Email">@Model.Email</a> }
                    </dd>
                    <dt class="col-sm-4">Erinnerungen bei Lieferverzug</dt>
                    <dd class="col-sm-8">
                        @if (Model.ReminderDisabled) { <text>abgeschaltet (keine Erinnerungsmails)</text> }
                        else if (!string.IsNullOrWhiteSpace(Model.ReminderEmail)) { <text>an </text><a href="mailto:@Model.ReminderEmail">@Model.ReminderEmail</a> }
                        else { <text>an die E-Mail aus den Stammdaten</text> }
                    </dd>
                    <dt class="col-sm-4">Beschichter</dt><dd class="col-sm-8">@(Model.IsCoater ? "Ja" : "Nein")</dd>
                    <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.IsActive ? "Aktiv" : "Inaktiv")</dd>
                    <dt class="col-sm-4">Bemerkung</dt><dd class="col-sm-8" style="white-space: pre-line;">@Text(Model.Remark)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Sage</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Herkunft</dt><dd class="col-sm-7">@CreditorsController.SourceText(Model.Source)</dd>
                    <dt class="col-sm-5">Sage-Konto</dt><dd class="col-sm-7">@Text(Model.SageKto)</dd>
                    <dt class="col-sm-5">Sage-Matchcode</dt><dd class="col-sm-7">@Text(Model.SageMatchcode)</dd>
                    <dt class="col-sm-5">Sage-Gruppe</dt><dd class="col-sm-7">@Text(Model.SageGruppe)</dd>
                    <dt class="col-sm-5">UID-Nummer</dt><dd class="col-sm-7">@Text(Model.SageEUUStID)</dd>
                    <dt class="col-sm-5">Zahlungskondition</dt><dd class="col-sm-7">@Text(Model.SageZahlungskondition)</dd>
                    <dt class="col-sm-5">EK-Mindestbestellwert</dt><dd class="col-sm-7">@(Model.SageEKMindestbestellwert?.ToString("N2") ?? "—")</dd>
                </dl>
                <p class="small text-muted mt-2 mb-0">
                    @if (Model.Source == StorageLocationSource.Sage)
                    {
                        <text>Name, Adresse, Kontakt und Sage-Felder füllt der Kreditoren-Abgleich aus Sage.</text>
                        @if (Model.ModifiedBy == "KontokorrentSync" && Model.ModifiedAt.HasValue)
                        {
                            <text>Zuletzt vom Abgleich geändert: @Model.ModifiedAt.Value.ToString("dd.MM.yyyy HH:mm").</text>
                        }
                    }
                    else
                    {
                        <text>Herkunft WMS: Die Sage-Felder bleiben leer, bis der Abgleich ein Sage-Konto mit derselben Kontonummer findet.</text>
                    }
                    <br />
                    @if (letzterLauf != null)
                    {
                        <text>Letzter Kreditoren-Abgleich: @letzterLauf.Timestamp.ToString("dd.MM.yyyy HH:mm")</text>
                        @if (letzterLauf.Level == SyncLogLevel.Error)
                        {
                            <span class="badge bg-danger ms-1">fehlgeschlagen</span>
                        }
                        else if (letzterLauf.Level == SyncLogLevel.Warning)
                        {
                            <span class="badge bg-warning text-dark border border-dark ms-1">mit Warnung</span>
                        }
                    }
                    else
                    {
                        <text>Der Kreditoren-Abgleich ist noch nicht gelaufen (Schalter <code>Sync:KreditorenEnabled</code> unter Service-Einstellungen).</text>
                    }
                </p>
            </div>
        </div>
    </div>
</div>

@{
    var lieferantArtikel = ViewBag.LieferantArtikel as List<IdealAkeWms.Models.LieferantArtikelRow> ?? new();
    var lieferantArtikelGesamt = ViewBag.LieferantArtikelGesamt as int? ?? 0;
    var lieferantArtikelPagination = ViewBag.LieferantArtikelPagination as IdealAkeWms.Models.ViewModels.PaginationState;
}
@* v1.85.0 (Spec 2026-11-08-artikeldetails-lieferanten-anzeigen, Nachbesserung 2): Artikel dieses Lieferanten aus Sage (nur lesend).
   QA Q-1: Server-Spaltenfilter + Pagination (bis ~9.000 Artikel je Lieferant), CSV ueber csv-export.js (Server-Mode, einzige filterbare
   Tabelle der Seite). *@
<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <strong>Artikel dieses Lieferanten</strong>
        <small class="opacity-75">nur lesend · aus Sage (@lieferantArtikelGesamt)</small>
    </div>
    <div class="card-body">
        @if (lieferantArtikelGesamt == 0)
        {
            <p class="mb-0 text-body-secondary">Keine Artikel-Lieferanten aus Sage für diesen Kreditor. Sie werden vom Lauf &bdquo;Artikel-Lieferanten&ldquo;
                gefüllt (Service-Einstellung <code>Sync:ArtikelLieferantEnabled</code>).</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped filterable-table mb-0" data-server-column-filter="true" data-view-key="CreditorArtikel">
                    <thead>
                        <tr>
                            <th data-filterable data-col-key="artikel">Artikel</th>
                            <th data-filterable data-col-key="bezeichnung">Bezeichnung</th>
                            <th data-filterable data-col-key="bestellnummer">Bestellnummer</th>
                            <th data-filterable data-filter-type="number" data-col-key="mindestmenge" class="text-end">Mindestbestellmenge</th>
                            <th data-filterable data-col-key="einheit">Bestelleinheit</th>
                            <th data-filterable data-col-key="haupt">Hauptlieferant</th>
                            <th data-filterable data-col-key="letzter">Letzter Lieferant</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in lieferantArtikel)
                        {
                            <tr>
                                <td><a asp-controller="Articles" asp-action="Info" asp-route-articleNumber="@a.ArticleNumber">@a.ArticleNumber</a></td>
                                <td>@a.Description</td>
                                <td>@(a.SageBestellnummer ?? "—")</td>
                                <td class="text-end">@(a.Mindestbestellmenge?.ToString("0.###") ?? "—")</td>
                                <td>@(a.Einkaufsmengeneinheit ?? "—")</td>
                                <td>@(a.IstHauptlieferant ? "Ja" : "")</td>
                                <td>@(a.IstLetzterLieferant ? "Ja" : "")</td>
                            </tr>
                        }
                        @if (lieferantArtikel.Count == 0)
                        {
                            <tr><td colspan="7" class="text-body-secondary">Keine Treffer für den Spaltenfilter.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (lieferantArtikelPagination != null)
            {
                <partial name="_Pagination" model="lieferantArtikelPagination" />
            }
        }
    </div>
</div>

<p class="small text-muted mt-3">
    Angelegt @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm") von @Model.CreatedBy
    @if (Model.ModifiedAt.HasValue)
    {
        <text>· zuletzt geändert @Model.ModifiedAt.Value.ToString("dd.MM.yyyy HH:mm") von @Model.ModifiedBy</text>
    }
</p>

@section Scripts {
    <script src="~/js/column-preferences.js" asp-append-version="true"></script>
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
}
