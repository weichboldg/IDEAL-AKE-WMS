@{
    ViewData["Title"] = "BDE-Terminal";
}

<link rel="stylesheet" href="~/css/bde.css" asp-append-version="true" />

<div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

<div class="container-fluid bde-terminal">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2>
            BDE-Terminal
            <small class="text-muted">Werkbank:
                <select id="workplaceSwitch" class="form-select form-select-sm d-inline-block w-auto">
                    @foreach (var wp in (IEnumerable<dynamic>)ViewBag.AllWorkplaces)
                    {
                        @if (wp.Id == (int)ViewBag.WorkplaceId)
                        {
                            <option value="@wp.Id" selected>@wp.Name</option>
                        }
                        else
                        {
                            <option value="@wp.Id">@wp.Name</option>
                        }
                    }
                </select>
            </small>
        </h2>
        <div class="text-muted small">
            Angemeldet: @Context.Session.GetString(IdealAkeWms.Services.CurrentUserService.SessionKeyUserName) | Session läuft bis: <span id="sessionExpiry">—</span>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">1. Operator</div>
                <div class="card-body">
                    <div id="operatorInfo" class="d-none mb-3">
                        <div class="bde-operator-badge">
                            <span id="operatorName" class="fw-bold fs-4"></span>
                            <button id="btnChangeOperator" class="btn btn-sm btn-outline-secondary ms-2">Wechseln</button>
                        </div>
                    </div>
                    <div id="operatorScan">
                        <div class="input-group">
                            <input type="text" id="scanOperator" class="form-control form-control-lg" placeholder="Personalnummer scannen…" autofocus data-hw-scan-ziel />
                            <button id="btnScanOperator" class="btn btn-primary btn-lg">Scannen</button>
                        </div>
                        <div id="operatorFeedback" class="small text-danger mt-1"></div>
                    </div>
                </div>
            </div>

            <div id="paused-bookings-hint" class="alert alert-warning mb-3 d-none" role="alert">
                <strong>Hinweis: Sie haben pausierte Auftraege</strong>
                <ul id="paused-bookings-list" class="list-unstyled mt-2 mb-0"></ul>
            </div>

            <div class="card mt-3" id="operationsCard" style="display:none">
                <div class="card-header">2. Arbeitsgang wählen</div>
                <div class="card-body">
                    <div id="operationButtons"></div>
                    @* Statuszeichen der Arbeitsgang-Knoepfe (FA-Struktur Teil 3, v1.57.0): dieselbe Quelle wie im FA-Baum, das JS klont
                       sie je Knopf per data-status = CSS-Klasse aus der API. *@
                    <div id="bdeAgZeichen" hidden>
                        @foreach (var s in new[] { IdealAkeWms.Models.ViewModels.FaAgStatus.Offen, IdealAkeWms.Models.ViewModels.FaAgStatus.Laeuft,
                                     IdealAkeWms.Models.ViewModels.FaAgStatus.LaeuftUeberfaellig, IdealAkeWms.Models.ViewModels.FaAgStatus.Ueberfaellig })
                        {
                            var d = IdealAkeWms.Models.ViewModels.FaAgStatusDarstellung.Fuer(s);
                            <template data-status="@d.Css">@Html.Raw(d.Svg)</template>
                        }
                    </div>
                    <hr />
                    @* data-hw-scan-ziel (v1.66.0): ohne Fokus landet ein Hardware-Scan im einzigen SICHTBAREN Feld — vor der Anmeldung
                       scanOperator, danach scanFaAg; Enter loest die bestehende Auswertung aus (bde-terminal.js unveraendert). *@
                    <div class="input-group mt-2">
                        <input type="text" id="scanFaAg" class="form-control" placeholder="Oder FA-Nr scannen (optional ,AG-Nr)…" data-hw-scan-ziel />
                        <button id="btnScanFaAg" class="btn btn-outline-primary">Scannen</button>
                    </div>
                    <div id="faAgFeedback" class="small text-danger mt-1"></div>
                    @* Disambiguierung nach dem Scan (IDEAL Teil 8): mehrere Sub-FAs derselben FA an
                       dieser Werkbank -> Auswahl; oder eigene Meldung, wenn der Auftrag hier keinen
                       offenen Arbeitsgang hat. Wird per JS aus /api/bde/resolve-scan gefuellt. *@
                    <div id="scanSelection" class="bde-scan-selection"></div>
                </div>
            </div>

            @* v1.64.0 (FA-3.3): Aktions-Knoepfe direkt unter „2. Arbeitsgang wählen“ statt unter beiden Spalten — bei langer
               Liste sonst ausserhalb des Sichtbereichs. Gefuellt per JS (renderState). *@
            <div id="actionPanel" class="mt-3"></div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Aktuelle Buchungen</div>
                <div id="active-bookings-container" class="card-body p-0">
                    <div id="active-bookings-empty" class="p-3 text-muted">
                        <em>Keine aktive Buchung</em>
                    </div>
                    <div id="active-bookings-list"></div>
                </div>
            </div>

            <div class="card mt-3" id="historyCard" style="display:none">
                <div class="card-header">Tageshistorie</div>
                <div class="card-body p-2" id="todayHistory">
                    <em class="text-muted">Noch keine Buchungen heute.</em>
                </div>
            </div>
        </div>
    </div>

    <!-- Aktivitäts-Modal -->
    <div class="modal fade" id="activityModal" tabindex="-1">
      <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Ungeplante Tätigkeit</h5></div>
        <div class="modal-body">
            <label>Kategorie</label>
            <select id="activitySelect" class="form-select form-select-lg"></select>
        </div>
        <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button><button id="btnActivityOk" class="btn btn-primary">Starten</button></div>
      </div></div>
    </div>
</div>

@* v1.99.77 (E4-6): Mengen-, Kollisions-, Gruppen- und Close-Others-Dialog gemeinsam mit der FA-Sicht. *@
<partial name="_BdeDialoge" />

@section Scripts {
    <input type="hidden" id="terminalId" value="@ViewBag.TerminalId" />
    <input type="hidden" id="workplaceId" value="@ViewBag.WorkplaceId" />
    <input type="hidden" id="nurFaMode" value="@(ViewBag.NurFaMode != null && (bool)ViewBag.NurFaMode ? "true" : "false")" />
    <input type="hidden" id="nurAgFertigmeldung" value="@(ViewBag.NurAgFertigmeldung is true ? "true" : "false")" />
    <input type="hidden" id="hierarchisch" value="@(ViewBag.Hierarchisch is true ? "true" : "false")" />
    <input type="hidden" id="maxHauptFa" value="@ViewBag.MaxHauptFa" />
    @Html.AntiForgeryToken()
    <script src="~/js/bde-terminal.js" asp-append-version="true"></script>
}
