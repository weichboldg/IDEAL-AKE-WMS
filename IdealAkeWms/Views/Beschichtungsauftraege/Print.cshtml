@model IdealAkeWms.Models.ViewModels.BeschichtungsauftragPrintViewModel
@using IdealAkeWms.Models.ViewModels
@using IdealAkeWms.Services
@{
    Layout = null;
    var a = Model.Auftrag;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <title>Beschichtungsauftrag @a.Nummer</title>
    @* Aussendokument des gespeicherten Auftrags (Spec 2026-10-06-beschichtungsauftrag-ausbau-teil-4, Anforderung 7):
       dieselbe View fuer Bildschirmdruck und PDF (Headless Edge), daher CSS eingebettet und Barcode als Data-URI.
       Aufbau wie FaHierarchyBeschichtung/PrintSummiert.cshtml. *@
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; color: #000; background: #fff; padding: 20px; font-size: 11px; }
        .screen-controls { padding: 15px; text-align: center; background: #053153; color: #fff; margin: -20px -20px 20px -20px; }
        .screen-controls button { background: #fff; color: #053153; border: none; padding: 8px 24px; font-size: 16px; cursor: pointer; border-radius: 4px; margin: 0 5px; }
        /* v1.99.42 (Befund 15:05 c): Barcode klein rechts oben neben dem Titel, Linien nur horizontal - ruhigeres Druckbild */
        .group-head { border-bottom: 1px solid #053153; padding-bottom: 6px; margin-bottom: 10px; }
        .titelzeile { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
        .titelzeile h1 { font-size: 16px; color: #053153; }
        .barcode img { height: 10mm; display: block; }
        .head-table { border-collapse: collapse; margin-top: 6px; }
        .head-table th, .head-table td { padding: 2px 12px 2px 0; text-align: left; font-size: 10px; vertical-align: top; }
        .head-table th { font-weight: normal; color: #4a494a; }
        table.positions { width: 100%; border-collapse: collapse; margin-top: 10px; }
        table.positions th, table.positions td { border-bottom: 1px solid #ccc; padding: 4px 6px; text-align: left; }
        table.positions thead th { border-bottom: 1px solid #053153; font-weight: 600; }
        table.positions thead { display: table-header-group; }
        .text-end { text-align: right; }
        .ohne-fa { display: inline-block; margin-left: 4px; padding: 0 4px; border: 1px solid #555; font-size: 9px; }
        .haken { white-space: nowrap; }
        .hinweis { display: inline-block; margin-top: 2px; padding: 0 4px; border: 1px solid #555; font-size: 9px; }
        /* v1.99.87 S5/S6: Summenzeile fett mit Linie wie thead, nur einmal am Tabellenende (nicht je Druckseite) */
        table.positions tfoot { display: table-row-group; }
        table.positions tfoot td { border-top: 1px solid #053153; border-bottom: none; font-weight: 600; }
        .summe-wert { white-space: nowrap; }
        .bemerkung { margin-top: 8px; white-space: pre-line; }
        @@media print { .screen-controls { display: none; } body { padding: 0; } }
    </style>
    <partial name="_PrintBriefkopfStyles" />
</head>
<body>
    <div class="screen-controls">
        <button onclick="window.print()">Drucken</button>
        <button onclick="window.close()">Schliessen</button>
    </div>

    <div class="fa-group">
        <partial name="_PrintBriefkopf" model="PrintBriefkopfModel.FuerAuftrag(a.Nummer, a.HauptFA, a.Dienstleister, a.Creditor)" />
        <div class="group-head">
            <div class="titelzeile">
                <h1>Beschichtungsauftrag @a.Nummer</h1>
                <div class="barcode"><img src="data:image/png;base64,@Model.Barcode" alt="@a.Nummer" /></div>
            </div>
            <table class="head-table">
                <tr><th>HauptFA</th><td>@a.HauptFA</td></tr>
                <tr><th>RAL</th><td>@a.Ral</td></tr>
                <tr><th>Start Beschichtung</th><td>@a.StartBeschichtung?.ToString("dd.MM.yyyy")</td></tr>
                <tr><th>Retour</th><td>@a.BeschichtenRetour?.ToString("dd.MM.yyyy")</td></tr>
                @if (a.Ursprungsauftrag != null)
                {
                    <tr><th>Reklamation zu</th><td>@a.Ursprungsauftrag.Nummer</td></tr>
                }
            </table>
            @if (!string.IsNullOrWhiteSpace(a.Bemerkung))
            {
                <div class="bemerkung"><strong>Bemerkung:</strong> @a.Bemerkung</div>
            }
        </div>

        @* v1.99.87 (Spec 2026-11-26-beschichtung-summe-…-teil-1): immer summiert je Artnr (hebt v1.99.41 A11 „je Position“
           fuer Druck/PDF auf), Pos. laufend je Zeile, Menge 0.###, Haken-Spalte zuletzt, Summenzeile im tfoot.
           „Maße uneinheitlich“ steht in der immer sichtbaren Verpackt-Spalte, damit es nicht mit Spalten verschwindet. *@
        @{
            // colspan der Summen-Beschriftung: Pos. + sichtbare Spalten vor Menge
            var vorMenge = 1 + new[] { "hauptartnr", "artnr", "matchcode", "breite", "hoehe", "tiefe" }.Count(Model.ShowCol);
            var mitMenge = Model.ShowCol("menge");
            var summeText = $"{BeschichtungsauftragService.FormatMass(Model.Summe)} ({Model.PositionenGesamt} {(Model.PositionenGesamt == 1 ? "Position" : "Positionen")})";
        }
        <table class="positions">
            <thead>
                <tr>
                    <th class="text-end">Pos.</th>
                    @if (Model.ShowCol("hauptartnr")) { <th>Haupt-Artnr.</th> }
                    @if (Model.ShowCol("artnr")) { <th>Artnr.</th> }
                    @if (Model.ShowCol("matchcode")) { <th>Matchcode</th> }
                    @if (Model.ShowCol("breite")) { <th class="text-end">Breite</th> }
                    @if (Model.ShowCol("hoehe")) { <th class="text-end">Höhe</th> }
                    @if (Model.ShowCol("tiefe")) { <th class="text-end">Tiefe</th> }
                    @if (Model.ShowCol("menge")) { <th class="text-end">Menge</th> }
                    <th>Verpackt</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Zeilen.Count; i++)
                {
                    var z = Model.Zeilen[i];
                    <tr>
                        <td class="text-end">@(i + 1)</td>
                        @if (Model.ShowCol("hauptartnr")) { <td>@z.HauptArtnr</td> }
                        @if (Model.ShowCol("artnr"))
                        {
                            <td>
                                @z.Artnr
                                @if (z.OhneFa) { <span class="ohne-fa">ohne FA</span> }
                            </td>
                        }
                        @if (Model.ShowCol("matchcode")) { <td>@z.Matchcode</td> }
                        @if (Model.ShowCol("breite")) { <td class="text-end">@BeschichtungsauftragService.FormatMass(z.Breite)</td> }
                        @if (Model.ShowCol("hoehe")) { <td class="text-end">@BeschichtungsauftragService.FormatMass(z.Hoehe)</td> }
                        @if (Model.ShowCol("tiefe")) { <td class="text-end">@BeschichtungsauftragService.FormatMass(z.Tiefe)</td> }
                        @if (Model.ShowCol("menge")) { <td class="text-end">@BeschichtungsauftragService.FormatMass(z.Menge)</td> }
                        <td class="haken">
                            @(z.Verpackt == z.Positionen ? "☑ verpackt" : z.Verpackt == 0 ? "☐ offen" : $"◩ {z.Verpackt} von {z.Positionen} verpackt")
                            @if (z.MasseUneinheitlich) { <br /><span class="hinweis">Maße uneinheitlich</span> }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    @if (mitMenge)
                    {
                        <td colspan="@vorMenge">Summe Teile im Auftrag</td>
                        <td class="text-end summe-wert">@summeText</td>
                    }
                    else
                    {
                        <td colspan="@vorMenge">Summe Teile im Auftrag <span class="summe-wert">@summeText</span></td>
                    }
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <partial name="_PrintBriefkopfFuss" model="true" />
</body>
</html>
