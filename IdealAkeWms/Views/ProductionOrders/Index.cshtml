@model ProductionOrderListViewModel
@using System.Globalization
@{
    var pageTitle = "Fertigungsaufträge";
    ViewData["Title"] = pageTitle;
    var today = DateTime.Today;
    // ISO 8601 Kalenderwoche berechnen
    string FormatDateWithKw(DateTime? date)
    {
        if (!date.HasValue) return "";
        var d = date.Value;
        var kw = ISOWeek.GetWeekOfYear(d);
        return $"{d:dd.MM.yyyy} KW{kw}";
    }
}

<h2 class="page-header">@pageTitle</h2>

<div class="card filter-card mb-4">
    <div class="card-header">Filter</div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">FA Nummer</label>
                    <div class="input-group">
                        <input type="text" id="filterOrderNumber" name="filterOrderNumber" value="@Model.FilterOrderNumber" class="form-control" placeholder="FA Nummer" />
                        <button type="button" id="btnScanOrderNumber" data-hw-scan-kamera-ziel class="btn btn-outline-secondary" title="QR-Code scannen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M1.5 1a.5.5 0 0 0-.5.5v3a.5.5 0 0 1-1 0v-3A1.5 1.5 0 0 1 1.5 0h3a.5.5 0 0 1 0 1zM11 .5a.5.5 0 0 1 .5-.5h3A1.5 1.5 0 0 1 16 1.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 1-.5-.5M.5 11a.5.5 0 0 1 .5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 1 0 1h-3A1.5 1.5 0 0 1 0 14.5v-3a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v3a1.5 1.5 0 0 1-1.5 1.5h-3a.5.5 0 0 1 0-1h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 1 .5-.5M3 4.5a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0z"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Artikelnummer</label>
                    <div class="input-group">
                        <input type="text" id="filterArticleNumber" name="filterArticleNumber" value="@Model.FilterArticleNumber" class="form-control" placeholder="Artikelnummer" />
                        <button type="button" id="btnScanArticleNumber" data-hw-scan-kamera-ziel class="btn btn-outline-secondary" title="QR-Code scannen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M1.5 1a.5.5 0 0 0-.5.5v3a.5.5 0 0 1-1 0v-3A1.5 1.5 0 0 1 1.5 0h3a.5.5 0 0 1 0 1zM11 .5a.5.5 0 0 1 .5-.5h3A1.5 1.5 0 0 1 16 1.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 1-.5-.5M.5 11a.5.5 0 0 1 .5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 1 0 1h-3A1.5 1.5 0 0 1 0 14.5v-3a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v3a1.5 1.5 0 0 1-1.5 1.5h-3a.5.5 0 0 1 0-1h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 1 .5-.5M3 4.5a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0zm2 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 1 0v7a.5.5 0 0 1-1 0z"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Kunde</label>
                    <input type="text" name="filterCustomer" value="@Model.FilterCustomer" class="form-control" placeholder="Kunde" />
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <div class="form-check mb-2">
                        <input type="checkbox" name="showDone" value="true" class="form-check-input" id="showDone"
                               @(Model.ShowDone ? "checked" : "") />
                        <label class="form-check-label" for="showDone">Erledigte anzeigen</label>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-secondary">Filtern</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" data-clear-table-filters="ProductionOrders">Zurücksetzen</a>
                </div>
            </div>
        </form>
    </div>
</div>

@* Toolbar-Host (data-table-toolbar, site.js tableToolbarHost): Zahnrad und CSV, ueber der Zaehlzeile (v1.65.0). *@
<div class="d-flex justify-content-end mb-1" data-table-toolbar></div>
@if (Model.Hierarchical)
{
    @* v1.99.82 (Spec 2026-11-26 FA-Liste nur HauptFA, F1/F6): eine Zeile je Auftrag; Sub-FAs zeigt die FA-Struktur. *@
    @if (Model.OhneHauptFaZeile > 0)
    {
        <div class="alert alert-warning py-2 mb-2" role="status">
            <strong>@Model.OhneHauptFaZeile @(Model.OhneHauptFaZeile == 1 ? "Auftrag" : "Aufträge") ohne HauptFA-Zeile</strong>
            @(Model.OhneHauptFaZeile == 1 ? "wird" : "werden") in der FA-Liste nicht angezeigt – Struktur unter
            <a asp-controller="FaHierarchy" asp-action="Index" class="alert-link">FA-Struktur</a>.
        </div>
    }
    <div class="small text-muted mb-1">
        <strong>@Model.Pagination.TotalCount</strong> Aufträge
        <span class="ms-2">(eine Zeile je HauptFA; Sub-FAs über den Knopf „FA-Struktur“)</span>
    </div>
}
<div class="table-responsive">
    <table class="table table-striped mb-0 filterable-table" data-view-key="ProductionOrders" data-fallback-sort-column="picking-date" data-fallback-sort-direction="asc" data-server-column-filter="true">
        <thead>
            <tr>
                @if (Model.CanPick || Model.HasVorbauAccess)
                {
                    <th style="width: 40px;" data-col-key="actions"></th>
                }
                <th style="width: 90px;" data-filterable data-col-key="order-number">FA Nr.</th>
                <th class="text-end" style="width: 55px;" data-col-key="quantity">Stk.</th>
                <th data-filterable data-col-key="customer">Kunde</th>
                @* IDEAL K1: Kopfdaten der Gruppe. NUR hierarchisch — bei AKE waeren sie dauerhaft
                   leer (AK 20: FA-Liste dort bit-identisch). colCount unten zaehlt sie mit. *@
                @if (Model.Hierarchical)
                {
                    <th style="width: 55px;" data-filterable data-col-key="prio" data-filter-type="number">Prio</th>
                    <th style="width: 80px;" data-filterable data-col-key="ab-nummer">AB-Nr.</th>
                    <th data-filterable data-col-key="montage-abteilung">Montage-Abt.</th>
                    <th class="text-nowrap" data-filterable data-col-key="konstruktions-termin" data-date-filter>KO-Termin</th>
                }
                <th data-filterable data-col-key="article-number">Artikelnummer</th>
                <th data-filterable data-col-key="matchcode">Matchcode</th>
                <th data-filterable data-col-key="description1">Bezeichnung 1</th>
                <th data-filterable data-col-key="description2">Bezeichnung 2</th>
                <th data-filterable data-col-key="workbench">Werkbank</th>
                <th data-filterable data-col-key="kaeltemittel">Kältemittel</th>
                <th data-filterable data-col-key="ventil">Ventil</th>
                <th data-filterable data-col-key="ausfuehrung">Ausführung E/Z</th>
                <th data-filterable data-col-key="maschine">Maschine</th>
                <th data-filterable data-col-key="sage-status">Sage-Status</th>
                <th class="text-nowrap" data-filterable data-col-key="coating-date" data-date-filter title="@Model.BeschichtungTerminTitel">Beschicht.</th>
                <th class="text-nowrap" data-filterable data-col-key="bg-date" data-date-filter title="Kommissioniertermin - Vorkommissioniertage (Standard @Model.VorkommissionierTage Arbeitstag(e), je Werkbank abweichend)">BG-Termin</th>
                <th class="text-nowrap" data-filterable data-col-key="picking-date" data-date-filter title="Fertigungstermin - @Model.KommissionierTage Arbeitstage">Komm.</th>
                <th class="text-nowrap" data-filterable data-col-key="production-date" data-date-filter>Fert.-Termin</th>
                <th class="text-nowrap" data-filterable data-col-key="delivery-date" data-date-filter>Liefertermin</th>
                <th class="text-nowrap text-center" style="width: 55px;" data-col-key="coating-part">Lack-T</th>
                @* F7: an der HauptFA-Zeile immer leer, deshalb nur im Flachmodus. *@
                @if (!Model.Hierarchical)
                {
                    <th data-filterable data-col-key="parent-sub-order-number">Übergeordnete Sub-FA</th>
                }
                @* v1.99.82 (F3): Kopf- und Strukturwurzel-Felder, nur hierarchisch, per Default ausgeblendet (Zahnrad). *@
                @if (Model.Hierarchical)
                {
                    <th data-filterable data-col-key="pps-status">PPS-Status</th>
                    <th data-filterable data-col-key="ab-position">AB-Pos.</th>
                    <th data-filterable data-col-key="dienstleister">Beschichter</th>
                    <th data-filterable data-col-key="ral">RAL</th>
                    <th class="text-nowrap" data-filterable data-col-key="beschichtung-retour" data-date-filter>Beschicht. retour</th>
                    <th class="text-nowrap" data-filterable data-col-key="neuer-pt-pps" data-date-filter>Neuer PT (PPS)</th>
                    <th class="text-end" data-filterable data-col-key="montagestunden" data-filter-type="number">Montage-Std.</th>
                    <th data-filterable data-col-key="bemerkung-uhrzeit">Bemerkung/Uhrzeit</th>
                    <th class="text-end" data-filterable data-col-key="fertigungsmenge" data-filter-type="number">Fert.-Menge</th>
                    <th data-filterable data-col-key="artikelgruppe">Artikelgruppe</th>
                    <th data-filterable data-col-key="arbeitsbereich">Arbeitsbereich</th>
                    <th data-filterable data-col-key="komm-ziel">Komm.-Ziel</th>
                    <th data-filterable data-col-key="hauptlagerplatz">Hauptlagerplatz</th>
                    <th data-filterable data-col-key="bemerkung">Bemerkung</th>
                    <th data-filterable data-col-key="fertigungsinfo">Fertigungsinfo</th>
                    <th data-filterable data-col-key="arbeitsschritte">Arbeitsschritte</th>
                    <th data-filterable data-col-key="material">Material</th>
                }
                <th style="width: 80px;" data-col-key="row-actions"></th>
            </tr>
        </thead>
        @{
            var colCount = 21;
            if (Model.CanPick || Model.HasVorbauAccess) colCount = 22;
            // Die vier Kopfdaten-Spalten (Prio/AB-Nr./Montage-Abt./KO-Termin) stehen nur im
            // hierarchischen Modus im <thead>. Das colspan darf deshalb auch nur dort wachsen —
            // im Flachzweig wuerde die Leerzustands-Zelle sonst vier Spalten zu breit.
            if (Model.Hierarchical) colCount += 4;
            // v1.99.82: hierarchisch ohne parent-sub-order-number (F7), dafuer die 17 Strukturfelder (F3).
            if (Model.Hierarchical) colCount += 17 - 1;
            Func<ProductionOrderListItem, ProductionOrderRowContext> Ctx = it => new ProductionOrderRowContext
            {
                Item = it,
                CanPick = Model.CanPick,
                HasVorbauAccess = Model.HasVorbauAccess,
                VorkommissionierTage = Model.VorkommissionierTage,
                EnaioDmsLinks = Model.EnaioDmsLinks,
                BeschichtungAktiv = Model.BeschichtungAktiv,
                Hierarchical = Model.Hierarchical
            };
        }
        <tbody>
            @foreach (var item in Model.Items)
            {
                <partial name="_ProductionOrderRow" model="Ctx(item)" />
            }
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="@colCount" class="text-center text-muted py-4">Keine @pageTitle gefunden.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Pagination" />

<script type="application/json" id="view-config">
{ "viewKey": "ProductionOrders", "supportsReorder": true, "supportsSortDefault": true }
</script>
