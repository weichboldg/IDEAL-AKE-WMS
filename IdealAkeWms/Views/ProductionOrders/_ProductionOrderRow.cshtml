@model ProductionOrderRowContext
@using System.Globalization
@{
    var item = Model.Item;
    var today = DateTime.Today;
    string FormatDateWithKw(DateTime? date)
    {
        if (!date.HasValue) return "";
        var d = date.Value;
        return $"{d:dd.MM.yyyy} KW{ISOWeek.GetWeekOfYear(d)}";
    }
    // FA-Nummer-Zelle: im hierarchischen Modus die Sub-FA-Nummer (SubOrderNumber), sonst OrderNumber.
    var faCellNumber = Model.Hierarchical ? (item.SubOrderNumber ?? item.OrderNumber) : item.OrderNumber;
    var lackName = Model.LackierteilKategorieName;
    var featureInactive = string.IsNullOrWhiteSpace(lackName);
    var showBeschicht = featureInactive || item.HasCoatingParts;
    var beschichtRed = showBeschicht && !item.IsDone && !item.IsCoatingDone
                       && item.BeschichtungTermin.HasValue && item.BeschichtungTermin.Value < today;
    var rowClass = (item.IsCancelled ? "table-danger" : item.IsDone ? "table-secondary" : "");
    if (Model.Hierarchical) rowClass = ("fa-liste-node-row " + rowClass).Trim();
}
<tr class="@rowClass" data-group="@item.OrderNumber">
    @if (Model.CanPick || Model.HasVorbauAccess)
    {
        <td class="text-nowrap">
            @if (!string.IsNullOrEmpty(item.ArticleNumber))
            {
                @if (Model.CanPick)
                {
                    <a asp-controller="Picking" asp-action="Bom" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Stückliste">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M2.5 3.5a.5.5 0 0 1 0-1h11a.5.5 0 0 1 0 1zm2-2a.5.5 0 0 1 0-1h7a.5.5 0 0 1 0 1zM0 13a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 16 13V6a1.5 1.5 0 0 0-1.5-1.5h-13A1.5 1.5 0 0 0 0 6zm1.5.5A.5.5 0 0 1 1 13V6a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5z"/></svg>
                    </a>
                }
                else
                {
                    <a asp-controller="FaWorklist" asp-action="Bom" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Stückliste">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M2.5 3.5a.5.5 0 0 1 0-1h11a.5.5 0 0 1 0 1zm2-2a.5.5 0 0 1 0-1h7a.5.5 0 0 1 0 1zM0 13a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 16 13V6a1.5 1.5 0 0 0-1.5-1.5h-13A1.5 1.5 0 0 0 0 6zm1.5.5A.5.5 0 0 1 1 13V6a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5z"/></svg>
                    </a>
                }
            }
        </td>
    }
    <td>
        <strong>@faCellNumber</strong>
        @if (item.IsCancelled)
        {
            <span class="badge bg-danger ms-1" title="Dieser Fertigungsauftrag existiert nicht mehr in Sage und wurde automatisch storniert.">In Sage gelöscht</span>
        }
        @if (Model.Hierarchical && item.SageMissingSince.HasValue)
        {
            <span class="badge bg-warning text-dark ms-1" title="Seit @item.SageMissingSince.Value.ToString("dd.MM.yyyy") nicht mehr in der Struktur gemeldet — Rückmeldung weiterhin möglich">vermisst seit @item.SageMissingSince.Value.ToString("dd.MM.yyyy")</span>
        }
        @if (Model.EnaioDmsLinks.TryGetValue(item.OrderNumber, out var dmsLinks))
        {
            @await Html.PartialAsync("_EnaioDmsBadges", new IdealAkeWms.Models.ViewModels.EnaioDmsBadgesViewModel(dmsLinks))
        }
    </td>
    <td class="text-end">@item.Quantity.ToString("N3")</td>
    <td>@item.Customer</td>
    <td>
        @if (!string.IsNullOrEmpty(item.ArticleNumber))
        {
            <strong>@item.ArticleNumber</strong>
            <a href="http://akevault24.ake.at/AutodeskTC/AKE-VAULT01/explore?search=@item.ArticleNumber&searchContext=0" target="_blank" title="Zeichnung in Vault öffnen" class="vault-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/><path d="M4.5 12.5A.5.5 0 0 1 5 12h3a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0-2A.5.5 0 0 1 5 10h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m1.639-3.708 1.33.886 1.854-1.855a.25.25 0 0 1 .289-.047l1.888.974V7.5a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5V7s1.54-1.274 1.639-1.208M6.25 6a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5"/></svg>
            </a>
        }
    </td>
    <td>@item.Description1</td>
    <td>@item.Description2</td>
    <td>
        @item.WorkplaceName
        @if (item.PrePickingDaysOverride.HasValue)
        {
            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1"
                  title="Abweichende Vorkommissioniertage dieser Werkbank: @item.PrePickingDaysOverride Arbeitstag(e) statt Standard @Model.VorkommissionierTage">BG @item.PrePickingDaysOverride</span>
        }
    </td>
    <td>@item.Kaeltemittel</td>
    <td>@item.Ventil</td>
    <td>@item.AusfuehrungEZ</td>
    <td>@item.Maschine</td>
    <td>@item.SageStatus</td>
    <td class="@(beschichtRed ? "text-danger fw-bold" : "")">
        @(showBeschicht ? FormatDateWithKw(item.BeschichtungTermin) : "")
    </td>
    <td class="@(!item.IsDone && item.VorkommissionierTermin.HasValue && item.VorkommissionierTermin.Value < today ? "text-danger fw-bold" : "")">
        @FormatDateWithKw(item.VorkommissionierTermin)
    </td>
    <td class="@(!item.IsDone && item.KommissionierTermin.HasValue && item.KommissionierTermin.Value < today ? "text-danger fw-bold" : "kommissionier-date")">
        @FormatDateWithKw(item.KommissionierTermin)
    </td>
    <td>@FormatDateWithKw(item.ProductionDate)</td>
    <td>@FormatDateWithKw(item.DeliveryDate)</td>
    <td class="text-center">
        @if (item.HasCoatingParts && item.IsCoatingDone)
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="text-success" viewBox="0 0 16 16" title="Lackierteile erledigt"><path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/></svg>
        }
        else if (item.HasCoatingParts)
        {
            <span class="text-muted" title="Lackierteile offen">–</span>
        }
    </td>
    @* IDEAL Hierarchie: Elternzeiger-Spalte (defaultHidden, im Flachmodus leer). *@
    <td>@item.ParentSubOrderNumber</td>
    <td class="text-nowrap">
        <a asp-controller="Tracking" asp-action="OseonIndex" asp-route-filterCustomerOrder="@item.OrderNumber" asp-route-showFinished="true"
           class="btn btn-sm btn-outline-info me-1" title="OSEON Teileverfolgung">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.399l-.451.004.09-.41h2.281z"/><path d="M8 5.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/></svg>
        </a>
        @if (Model.CanPick)
        {
            <form asp-controller="Picking" asp-action="ToggleDone" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-sm @(item.IsDone ? "btn-outline-success" : "btn-outline-secondary")"
                        title="@(item.IsDone ? "Als offen markieren" : "Als erledigt markieren")">
                    @if (item.IsDone)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/></svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/><path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/></svg>
                    }
                </button>
            </form>
        }
    </td>
</tr>
